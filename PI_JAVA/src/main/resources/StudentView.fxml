<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.StudentController"
            style="-fx-background-color: #f8f9fa;">

    <!-- ═══════════════════════════════════════════════════════════
         MAIN SCROLL AREA
    ═══════════════════════════════════════════════════════════ -->
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                    style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
            <VBox spacing="0">

                <!-- ── HERO BANNER ── -->
                <VBox fx:id="heroBanner" minHeight="160" prefHeight="160"
                      alignment="CENTER_LEFT"
                      style="-fx-background-color: #1a2035; -fx-padding: 0 60 0 60;">
                    <VBox spacing="6">
                        <Label fx:id="heroNameLabel"
                               text="Aouadi Yassine"
                               style="-fx-font-family: 'Georgia'; -fx-font-size: 32px; -fx-font-weight: bold;
                                      -fx-text-fill: #f5a623;"/>
                        <Label text="Bienvenue ! Suivez votre progression et continuez votre parcours d'apprentissage"
                               style="-fx-font-size: 14px; -fx-text-fill: rgba(255,255,255,0.75);"/>
                    </VBox>
                </VBox>

                <!-- ── PAGE BODY ── -->
                <HBox spacing="30" style="-fx-padding: 40 60 40 60; -fx-background-color: #f8f9fa;"
                      alignment="TOP_LEFT">

                    <!-- ════════════════════════════════════
                         LEFT COLUMN  (main content)
                    ════════════════════════════════════ -->
                    <VBox spacing="30" HBox.hgrow="ALWAYS">

                        <!-- ── SECTION: Informations Personnelles ── -->
                        <VBox spacing="14">
                            <Label text="Informations Personnelles"
                                   style="-fx-font-family: 'Georgia'; -fx-font-size: 22px;
                                          -fx-font-weight: bold; -fx-text-fill: #1a2035;
                                          -fx-border-color: transparent transparent #f5a623 transparent;
                                          -fx-border-width: 0 0 3 0; -fx-padding: 0 0 8 0;"/>

                            <VBox style="-fx-background-color: white;
                                         -fx-border-color: #dee8ff;
                                         -fx-border-width: 0 0 0 4;
                                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 20, 0, 0, 4);">
                                <VBox style="-fx-padding: 28;">
                                    <GridPane hgap="20" vgap="0">
                                        <columnConstraints>
                                            <ColumnConstraints percentWidth="50"/>
                                            <ColumnConstraints percentWidth="50"/>
                                        </columnConstraints>

                                        <!-- Row 0: Nom Complet -->
                                        <VBox spacing="4" style="-fx-padding: 0 0 18 0;" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                            <Label text="Nom Complet"
                                                   style="-fx-font-size: 11px; -fx-text-fill: #8a9bb5;
                                                          -fx-font-weight: bold; -fx-padding: 0 0 2 0;"/>
                                            <HBox style="-fx-border-color: #eef0f5; -fx-border-width: 0 0 1 0; -fx-padding: 0 0 8 0;">
                                                <Label fx:id="fullNameLabel" text="—"
                                                       style="-fx-font-size: 15px; -fx-text-fill: #1a2035; -fx-font-weight: bold;"/>
                                            </HBox>
                                        </VBox>

                                        <!-- Row 0: Email -->
                                        <VBox spacing="4" style="-fx-padding: 0 0 18 0;" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                            <Label text="Adresse Email"
                                                   style="-fx-font-size: 11px; -fx-text-fill: #8a9bb5;
                                                          -fx-font-weight: bold; -fx-padding: 0 0 2 0;"/>
                                            <HBox style="-fx-border-color: #eef0f5; -fx-border-width: 0 0 1 0; -fx-padding: 0 0 8 0;">
                                                <Label fx:id="emailLabel" text="—"
                                                       style="-fx-font-size: 15px; -fx-text-fill: #1a2035; -fx-font-weight: bold;"/>
                                            </HBox>
                                        </VBox>

                                        <!-- Row 1: Username -->
                                        <VBox spacing="4" style="-fx-padding: 0 0 18 0;" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                            <Label text="Nom d'utilisateur"
                                                   style="-fx-font-size: 11px; -fx-text-fill: #8a9bb5;
                                                          -fx-font-weight: bold; -fx-padding: 0 0 2 0;"/>
                                            <HBox style="-fx-border-color: #eef0f5; -fx-border-width: 0 0 1 0; -fx-padding: 0 0 8 0;">
                                                <Label fx:id="usernameLabel" text="—"
                                                       style="-fx-font-size: 15px; -fx-text-fill: #1a2035; -fx-font-weight: bold;"/>
                                            </HBox>
                                        </VBox>

                                        <!-- Row 1: Password -->
                                        <VBox spacing="4" style="-fx-padding: 0 0 18 0;" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                            <Label text="Mot de passe"
                                                   style="-fx-font-size: 11px; -fx-text-fill: #8a9bb5;
                                                          -fx-font-weight: bold; -fx-padding: 0 0 2 0;"/>
                                            <HBox style="-fx-border-color: #eef0f5; -fx-border-width: 0 0 1 0; -fx-padding: 0 0 8 0;">
                                                <Label text="••••••••"
                                                       style="-fx-font-size: 15px; -fx-text-fill: #1a2035; -fx-font-weight: bold;"/>
                                            </HBox>
                                        </VBox>

                                        <!-- Row 2: Membre depuis -->
                                        <VBox spacing="4" style="-fx-padding: 0 0 6 0;" GridPane.columnIndex="0" GridPane.rowIndex="2">
                                            <Label text="Membre depuis"
                                                   style="-fx-font-size: 11px; -fx-text-fill: #8a9bb5;
                                                          -fx-font-weight: bold; -fx-padding: 0 0 2 0;"/>
                                            <Label fx:id="inscriptionLabel" text="—"
                                                   style="-fx-font-size: 15px; -fx-text-fill: #1a2035; -fx-font-weight: bold;"/>
                                        </VBox>

                                        <!-- Row 2: Dernière connexion -->
                                        <VBox spacing="4" style="-fx-padding: 0 0 6 0;" GridPane.columnIndex="1" GridPane.rowIndex="2">
                                            <Label text="Dernière connexion"
                                                   style="-fx-font-size: 11px; -fx-text-fill: #8a9bb5;
                                                          -fx-font-weight: bold; -fx-padding: 0 0 2 0;"/>
                                            <Label fx:id="lastLoginLabel" text="—"
                                                   style="-fx-font-size: 15px; -fx-text-fill: #1a2035; -fx-font-weight: bold;"/>
                                        </VBox>
                                    </GridPane>

                                    <!-- Déconnexion -->
                                    <Button fx:id="logoutBtn"
                                            text="⏻  Déconnexion"
                                            onAction="#logout"
                                            prefHeight="42"
                                            maxWidth="Infinity"
                                            style="-fx-background-color: transparent;
                                                   -fx-border-color: #dc3545;
                                                   -fx-border-width: 1.5;
                                                   -fx-text-fill: #dc3545;
                                                   -fx-font-weight: bold;
                                                   -fx-font-size: 13px;
                                                   -fx-background-radius: 0;
                                                   -fx-border-radius: 0;
                                                   -fx-cursor: hand;"/>
                                </VBox>
                            </VBox>
                        </VBox>

                        <!-- ── SECTION: Mes Cours ── -->
                        <VBox spacing="14">
                            <Label text="Mes Cours"
                                   style="-fx-font-family: 'Georgia'; -fx-font-size: 22px;
                                          -fx-font-weight: bold; -fx-text-fill: #1a2035;
                                          -fx-border-color: transparent transparent #f5a623 transparent;
                                          -fx-border-width: 0 0 3 0; -fx-padding: 0 0 8 0;"/>
                            <VBox alignment="CENTER" minHeight="130"
                                  style="-fx-background-color: white;
                                         -fx-border-color: #dee8ff;
                                         -fx-border-width: 0 0 0 4;
                                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 20, 0, 0, 4);
                                         -fx-padding: 40;">
                                <Label text="📚"
                                       style="-fx-font-size: 36px;"/>
                                <Label text="Vous n'êtes inscrit à aucun cours pour le moment."
                                       style="-fx-font-size: 14px; -fx-text-fill: #8a9bb5; -fx-padding: 12 0 0 0;"/>
                            </VBox>
                            <HBox alignment="CENTER_LEFT">
                                <Button text="Parcourir tous les cours"
                                        style="-fx-background-color: transparent;
                                               -fx-border-color: #1a2035;
                                               -fx-border-width: 1.5;
                                               -fx-text-fill: #1a2035;
                                               -fx-font-size: 13px;
                                               -fx-background-radius: 0;
                                               -fx-border-radius: 0;
                                               -fx-cursor: hand;
                                               -fx-padding: 8 20 8 20;"/>
                            </HBox>
                        </VBox>

                        <!-- ── SECTION: Performance aux Quiz ── -->
                        <VBox spacing="14">
                            <Label text="Performance aux Quiz"
                                   style="-fx-font-family: 'Georgia'; -fx-font-size: 22px;
                                          -fx-font-weight: bold; -fx-text-fill: #1a2035;
                                          -fx-border-color: transparent transparent #f5a623 transparent;
                                          -fx-border-width: 0 0 3 0; -fx-padding: 0 0 8 0;"/>
                            <VBox style="-fx-background-color: white;
                                         -fx-border-color: #dee8ff;
                                         -fx-border-width: 0 0 0 4;
                                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 20, 0, 0, 4);
                                         -fx-padding: 24;">
                                <HBox spacing="0">
                                    <VBox HBox.hgrow="ALWAYS" alignment="CENTER"
                                          style="-fx-background-color: #f7f9ff;
                                                 -fx-padding: 20; -fx-margin: 0 1 0 0;
                                                 -fx-border-color: #dee8ff; -fx-border-width: 0 1 0 0;">
                                        <Label text="0"
                                               style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #1a2035;"/>
                                        <Label text="Quiz Complétés"
                                               style="-fx-font-size: 12px; -fx-text-fill: #8a9bb5; -fx-padding: 4 0 0 0;"/>
                                    </VBox>
                                    <VBox HBox.hgrow="ALWAYS" alignment="CENTER"
                                          style="-fx-background-color: #f7f9ff;
                                                 -fx-padding: 20;
                                                 -fx-border-color: #dee8ff; -fx-border-width: 0 1 0 0;">
                                        <Label text="0%"
                                               style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #1a2035;"/>
                                        <Label text="Score Moyen"
                                               style="-fx-font-size: 12px; -fx-text-fill: #8a9bb5; -fx-padding: 4 0 0 0;"/>
                                    </VBox>
                                    <VBox HBox.hgrow="ALWAYS" alignment="CENTER"
                                          style="-fx-background-color: #f7f9ff; -fx-padding: 20;">
                                        <Label text="0"
                                               style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #1a2035;"/>
                                        <Label text="Badges Gagnés"
                                               style="-fx-font-size: 12px; -fx-text-fill: #8a9bb5; -fx-padding: 4 0 0 0;"/>
                                    </VBox>
                                </HBox>
                                <Label text="Aucun quiz complété pour le moment."
                                       alignment="CENTER" maxWidth="Infinity"
                                       style="-fx-font-size: 13px; -fx-text-fill: #8a9bb5; -fx-padding: 18 0 0 0;"/>
                            </VBox>
                        </VBox>

                        <!-- ── SECTION: Badges & Réalisations ── -->
                        <VBox spacing="14">
                            <Label text="Badges &amp; Réalisations"
                                   style="-fx-font-family: 'Georgia'; -fx-font-size: 22px;
                                          -fx-font-weight: bold; -fx-text-fill: #1a2035;
                                          -fx-border-color: transparent transparent #f5a623 transparent;
                                          -fx-border-width: 0 0 3 0; -fx-padding: 0 0 8 0;"/>
                            <VBox alignment="CENTER" minHeight="130"
                                  style="-fx-background-color: white;
                                         -fx-border-color: #dee8ff;
                                         -fx-border-width: 0 0 0 4;
                                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 20, 0, 0, 4);
                                         -fx-padding: 40;">
                                <Label text="🏅"
                                       style="-fx-font-size: 36px;"/>
                                <Label text="Aucun badge obtenu pour le moment."
                                       style="-fx-font-size: 14px; -fx-text-fill: #8a9bb5; -fx-padding: 12 0 0 0;"/>
                            </VBox>
                        </VBox>

                        <!-- ── SECTION: Mes Donations ── -->
                        <VBox spacing="14">
                            <Label text="Mes Donations"
                                   style="-fx-font-family: 'Georgia'; -fx-font-size: 22px;
                                          -fx-font-weight: bold; -fx-text-fill: #1a2035;
                                          -fx-border-color: transparent transparent #f5a623 transparent;
                                          -fx-border-width: 0 0 3 0; -fx-padding: 0 0 8 0;"/>
                            <VBox style="-fx-background-color: white;
                                         -fx-border-color: #dee8ff;
                                         -fx-border-width: 0 0 0 4;
                                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 20, 0, 0, 4);
                                         -fx-padding: 24;">
                                <HBox spacing="0">
                                    <VBox HBox.hgrow="ALWAYS" alignment="CENTER"
                                          style="-fx-background-color: #f7f9ff; -fx-padding: 20;
                                                 -fx-border-color: #dee8ff; -fx-border-width: 0 1 0 0;">
                                        <Label text="0€"
                                               style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #1a2035;"/>
                                        <Label text="Total Donné"
                                               style="-fx-font-size: 12px; -fx-text-fill: #8a9bb5; -fx-padding: 4 0 0 0;"/>
                                    </VBox>
                                    <VBox HBox.hgrow="ALWAYS" alignment="CENTER"
                                          style="-fx-background-color: #f7f9ff; -fx-padding: 20;
                                                 -fx-border-color: #dee8ff; -fx-border-width: 0 1 0 0;">
                                        <Label text="Débutant"
                                               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1a2035;"/>
                                        <Label text="Niveau Donateur"
                                               style="-fx-font-size: 12px; -fx-text-fill: #8a9bb5; -fx-padding: 4 0 0 0;"/>
                                    </VBox>
                                    <VBox HBox.hgrow="ALWAYS" alignment="CENTER"
                                          style="-fx-background-color: #f7f9ff; -fx-padding: 20;">
                                        <Label text="0"
                                               style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #1a2035;"/>
                                        <Label text="Badges de Donation"
                                               style="-fx-font-size: 12px; -fx-text-fill: #8a9bb5; -fx-padding: 4 0 0 0;"/>
                                    </VBox>
                                </HBox>
                                <Label text="Vous n'avez pas encore fait de donations."
                                       alignment="CENTER" maxWidth="Infinity"
                                       style="-fx-font-size: 13px; -fx-text-fill: #8a9bb5; -fx-padding: 16 0 8 0;"/>
                                <HBox alignment="CENTER">
                                    <Button text="Faire une Donation"
                                            style="-fx-background-color: #1a2035;
                                                   -fx-text-fill: white;
                                                   -fx-font-weight: bold;
                                                   -fx-font-size: 13px;
                                                   -fx-background-radius: 0;
                                                   -fx-padding: 10 24 10 24;
                                                   -fx-cursor: hand;"/>
                                </HBox>
                            </VBox>
                        </VBox>

                        <!-- ── DANGER ZONE ── -->
                        <VBox style="-fx-background-color: #fff5f5;
                                     -fx-border-color: #ffcccc;
                                     -fx-border-width: 1;
                                     -fx-padding: 24;
                                     -fx-effect: dropshadow(gaussian, rgba(220,53,69,0.1), 16, 0, 0, 3);">
                            <Label text="⚠  Zone Dangereuse"
                                   style="-fx-font-size: 16px; -fx-font-weight: bold;
                                          -fx-text-fill: #dc3545; -fx-padding: 0 0 8 0;"/>
                            <Label text="La suppression de votre compte est permanente et irréversible. Toutes vos données, cours, badges et progression seront définitivement supprimés."
                                   wrapText="true"
                                   style="-fx-font-size: 13px; -fx-text-fill: #555; -fx-padding: 0 0 16 0;"/>
                            <Button text="🗑  Supprimer Mon Compte"
                                    onAction="#deleteAccount"
                                    style="-fx-background-color: #dc3545;
                                           -fx-text-fill: white;
                                           -fx-font-weight: bold;
                                           -fx-font-size: 13px;
                                           -fx-background-radius: 0;
                                           -fx-padding: 10 20 10 20;
                                           -fx-cursor: hand;"/>
                        </VBox>

                    </VBox>
                    <!-- end left column -->

                    <!-- ════════════════════════════════════
                         RIGHT COLUMN (sidebar)
                    ════════════════════════════════════ -->
                    <VBox spacing="20" prefWidth="280" minWidth="260">

                        <!-- ── Avatar Card ── -->
                        <VBox alignment="CENTER" spacing="10"
                              style="-fx-background-color: white;
                                     -fx-border-color: #dee8ff;
                                     -fx-border-width: 0 0 0 4;
                                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 20, 0, 0, 4);
                                     -fx-padding: 30 20 30 20;">
                            <!-- Avatar circle (Region renders -fx-background-color gradient + radius correctly) -->
                            <StackPane prefWidth="88" prefHeight="88" maxWidth="88" maxHeight="88">
                                <Region prefWidth="88" prefHeight="88"
                                        style="-fx-background-color: #2d3a5e; -fx-background-radius: 44;"/>
                                <Label fx:id="avatarInitialsLabel" text="AY"
                                       style="-fx-font-family: 'Georgia'; -fx-font-size: 26px;
                                              -fx-font-weight: bold; -fx-text-fill: #f5a623;"/>
                            </StackPane>
                            <Label fx:id="sidebarNameLabel" text="Aouadi Yassine"
                                   style="-fx-font-weight: bold; -fx-font-size: 16px;
                                          -fx-text-fill: #1a2035; -fx-padding: 6 0 0 0;"/>
                            <Label fx:id="sidebarEmailLabel" text="aouadiyassine12@gmail.com"
                                   style="-fx-font-size: 12px; -fx-text-fill: #8a9bb5;"/>
                            <HBox alignment="CENTER"
                                  style="-fx-background-color: #e8f5e9; -fx-padding: 4 12 4 12;">
                                <Label text="● Étudiant"
                                       style="-fx-font-size: 11px; -fx-text-fill: #2e7d32; -fx-font-weight: bold;"/>
                            </HBox>
                        </VBox>

                        <!-- ── Statistiques Rapides ── -->
                        <VBox style="-fx-background-color: white;
                                     -fx-border-color: #dee8ff;
                                     -fx-border-width: 0 0 0 4;
                                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 20, 0, 0, 4);
                                     -fx-padding: 24;">
                            <Label text="Statistiques Rapides"
                                   style="-fx-font-size: 15px; -fx-font-weight: bold;
                                          -fx-text-fill: #1a2035; -fx-padding: 0 0 16 0;"/>
                            <VBox spacing="10">
                                <!-- stat row -->
                                <HBox style="-fx-background-color: #f7f9ff; -fx-padding: 14 16 14 16;"
                                      alignment="CENTER_LEFT" spacing="12">
                                    <Label text="📖" style="-fx-font-size: 18px;"/>
                                    <VBox>
                                        <Label text="0"
                                               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1a2035;"/>
                                        <Label text="Cours Inscrits"
                                               style="-fx-font-size: 11px; -fx-text-fill: #8a9bb5;"/>
                                    </VBox>
                                </HBox>
                                <HBox style="-fx-background-color: #f7f9ff; -fx-padding: 14 16 14 16;"
                                      alignment="CENTER_LEFT" spacing="12">
                                    <Label text="✅" style="-fx-font-size: 18px;"/>
                                    <VBox>
                                        <Label text="0"
                                               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1a2035;"/>
                                        <Label text="Cours Complétés"
                                               style="-fx-font-size: 11px; -fx-text-fill: #8a9bb5;"/>
                                    </VBox>
                                </HBox>
                                <HBox style="-fx-background-color: #f7f9ff; -fx-padding: 14 16 14 16;"
                                      alignment="CENTER_LEFT" spacing="12">
                                    <Label text="🔥" style="-fx-font-size: 18px;"/>
                                    <VBox>
                                        <Label text="0"
                                               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1a2035;"/>
                                        <Label text="Jours de Série"
                                               style="-fx-font-size: 11px; -fx-text-fill: #8a9bb5;"/>
                                    </VBox>
                                </HBox>
                                <HBox style="-fx-background-color: #f7f9ff; -fx-padding: 14 16 14 16;"
                                      alignment="CENTER_LEFT" spacing="12">
                                    <Label text="📊" style="-fx-font-size: 18px;"/>
                                    <VBox>
                                        <Label text="0%"
                                               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1a2035;"/>
                                        <Label text="Taux de Complétion"
                                               style="-fx-font-size: 11px; -fx-text-fill: #8a9bb5;"/>
                                    </VBox>
                                </HBox>
                            </VBox>
                        </VBox>

                        <!-- ── Certifications Calendar placeholder ── -->
                        <VBox style="-fx-background-color: white;
                                     -fx-border-color: #dee8ff;
                                     -fx-border-width: 0 0 0 4;
                                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 20, 0, 0, 4);
                                     -fx-padding: 24;">
                            <Label text="Calendrier des Certifications"
                                   style="-fx-font-size: 15px; -fx-font-weight: bold;
                                          -fx-text-fill: #1a2035; -fx-padding: 0 0 14 0;"/>
                            <!-- Mini calendar grid -->
                            <VBox fx:id="calendarContainer" spacing="0">
                                <!-- Built dynamically in controller -->
                            </VBox>
                        </VBox>

                    </VBox>
                    <!-- end right column -->

                </HBox>
                <!-- end page body -->

                <!-- ── FOOTER ── -->
                <VBox style="-fx-background-color: #1a2035; -fx-padding: 40 60 20 60;" spacing="24">
                    <HBox spacing="60">
                        <!-- Brand -->
                        <VBox spacing="10" HBox.hgrow="ALWAYS">
                            <Label text="EduCenter"
                                   style="-fx-font-family: 'Georgia'; -fx-font-size: 22px;
                                          -fx-font-weight: bold; -fx-text-fill: #f5a623;"/>
                            <Label text="23621 15 Mile Rd #C104, Clinton MI, 48035, Jandouba, Tunisie"
                                   wrapText="true" maxWidth="200"
                                   style="-fx-font-size: 12px; -fx-text-fill: rgba(255,255,255,0.55);"/>
                            <Label text="+1 (2) 345 6789"
                                   style="-fx-font-size: 12px; -fx-text-fill: rgba(255,255,255,0.55);"/>
                            <Label text="contact@yourdomain.com"
                                   style="-fx-font-size: 12px; -fx-text-fill: rgba(255,255,255,0.55);"/>
                        </VBox>
                        <!-- Entreprise -->
