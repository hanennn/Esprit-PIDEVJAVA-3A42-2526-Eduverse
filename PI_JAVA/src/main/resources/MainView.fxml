<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="controllers.MainController"
           prefWidth="960.0" prefHeight="620.0"
           style="-fx-background-color: #1a2035;">

    <HBox>
        <VBox HBox.hgrow="ALWAYS" alignment="CENTER"
              style="-fx-background-color: #1a2035; -fx-padding: 60;">
            <Label text="📚 edu verse"
                   style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #f5a623;"/>
            <Label text="La plateforme d'apprentissage en ligne"
                   style="-fx-font-size: 14px; -fx-text-fill: rgba(255,255,255,0.5); -fx-padding: 10 0 0 0;"/>
        </VBox>

        <VBox HBox.hgrow="ALWAYS" alignment="CENTER"
              style="-fx-background-color: #f8f9fa; -fx-padding: 60;">
            <VBox prefWidth="380" spacing="0"
                  style="-fx-background-color: white;
                         -fx-background-radius: 8;
                         -fx-padding: 40;
                         -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.08),20,0,0,4);">

                <Label text="Connexion"
                       style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #1a2035;"/>
                <Label text="Accédez à votre espace personnel"
                       style="-fx-font-size: 13px; -fx-text-fill: #8a93a8; -fx-padding: 4 0 28 0;"/>

                <Label text="Adresse Email"
                       style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #1a2035; -fx-padding: 0 0 6 0;"/>
                <TextField fx:id="emailField"
                           promptText="votre@email.com"
                           prefHeight="42"
                           maxWidth="Infinity"
                           style="-fx-background-color: #f8f9fa;
                                  -fx-background-radius: 6;
                                  -fx-border-color: #dee2e6;
                                  -fx-border-radius: 6;
                                  -fx-border-width: 1.5;
                                  -fx-font-size: 13px;
                                  -fx-padding: 0 12 0 12;"/>

                <Region prefHeight="16"/>

                <Label text="Mot de passe"
                       style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #1a2035; -fx-padding: 0 0 6 0;"/>
                <PasswordField fx:id="passwordField"
                               promptText="Votre mot de passe"
                               prefHeight="42"
                               maxWidth="Infinity"
                               style="-fx-background-color: #f8f9fa;
                                      -fx-background-radius: 6;
                                      -fx-border-color: #dee2e6;
                                      -fx-border-radius: 6;
                                      -fx-border-width: 1.5;
                                      -fx-font-size: 13px;
                                      -fx-padding: 0 12 0 12;"/>

                <Region prefHeight="14"/>

                <HBox alignment="CENTER_LEFT">
                    <CheckBox fx:id="rememberMeCheckbox"
                              text="Se souvenir de moi"
                              style="-fx-font-size: 12px; -fx-text-fill: #6b7592;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Mot de passe oublié ?"
                            style="-fx-background-color: transparent;
                                   -fx-border-color: transparent;
                                   -fx-text-fill: #f5a623;
                                   -fx-font-size: 12px;
                                   -fx-font-weight: bold;
                                   -fx-cursor: hand;
                                   -fx-padding: 0;"/>
                </HBox>

                <Region prefHeight="22"/>

                <Button text="Se Connecter"
                        onAction="#login"
                        maxWidth="Infinity"
                        prefHeight="44"
                        style="-fx-background-color: #f5a623;
                               -fx-background-radius: 6;
                               -fx-text-fill: white;
                               -fx-font-size: 14px;
                               -fx-font-weight: bold;
                               -fx-cursor: hand;"/>

                <Region prefHeight="20"/>

                <HBox alignment="CENTER" spacing="14">
                    <Line endX="120" style="-fx-stroke: #dee2e6;"/>
                    <Label text="OU" style="-fx-font-size: 11px; -fx-text-fill: #adb5bd;"/>
                    <Line endX="120" style="-fx-stroke: #dee2e6;"/>
                </HBox>

                <Region prefHeight="16"/>

                <Button text="Continuer avec Google"
                        maxWidth="Infinity"
                        prefHeight="42"
                        onAction="#loginWithGoogle"
                        style="-fx-background-color: white;
                               -fx-background-radius: 6;
                               -fx-border-color: #dee2e6;
                               -fx-border-radius: 6;
                               -fx-border-width: 1.5;
                               -fx-text-fill: #1a2035;
                               -fx-font-size: 13px;
                               -fx-cursor: hand;"/>

                <Region prefHeight="24"/>

                <HBox alignment="CENTER" spacing="5">
                    <Label text="Pas encore de compte ?"
                           style="-fx-font-size: 13px; -fx-text-fill: #6b7592;"/>
                    <Button text="S'inscrire"
                            onAction="#goToRegister"
                            style="-fx-background-color: transparent;
                                   -fx-border-color: transparent;
                                   -fx-text-fill: #f5a623;
                                   -fx-font-size: 13px;
                                   -fx-font-weight: bold;
                                   -fx-cursor: hand;
                                   -fx-padding: 0;"/>
                </HBox>
            </VBox>
        </VBox>
    </HBox>
</StackPane>