<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="controllers.RegisterController"
           style="-fx-background-color: #1a2035;">

    <HBox>
        <VBox HBox.hgrow="ALWAYS" alignment="CENTER"
              style="-fx-background-color: #1a2035; -fx-padding: 60;">
            <Label text="📚 edu verse"
                   style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #f5a623;"/>
            <Label text="Rejoignez notre communauté"
                   style="-fx-font-size: 14px; -fx-text-fill: rgba(255,255,255,0.5); -fx-padding: 10 0 0 0;"/>
        </VBox>

        <ScrollPane fitToWidth="true" HBox.hgrow="ALWAYS"
                    style="-fx-background-color: #f8f9fa; -fx-background: #f8f9fa; -fx-border-color: transparent;">
            <VBox alignment="CENTER" style="-fx-padding: 40; -fx-background-color: #f8f9fa;">
                <VBox prefWidth="420" spacing="14"
                      style="-fx-background-color: white;
                             -fx-background-radius: 8;
                             -fx-padding: 36;
                             -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.08),20,0,0,4);">

                    <Label text="Créer un Compte"
                           style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1a2035;"/>
                    <Label text="Choisissez votre type de compte"
                           style="-fx-font-size: 13px; -fx-text-fill: #8a93a8; -fx-padding: 0 0 8 0;"/>

                    <HBox spacing="12">
                        <VBox alignment="CENTER" spacing="4" prefHeight="80"
                              HBox.hgrow="ALWAYS"
                              onMouseClicked="#selectStudent"
                              style="-fx-background-color: #fff8ec;
                                     -fx-border-color: #f5a623;
                                     -fx-border-width: 2;
                                     -fx-border-radius: 6;
                                     -fx-background-radius: 6;
                                     -fx-cursor: hand;">
                            <Label text="👤" style="-fx-font-size: 20px;"/>
                            <Label text="Étudiant"
                                   style="-fx-font-weight: bold; -fx-text-fill: #f5a623; -fx-font-size: 13px;"/>
                        </VBox>
                        <VBox alignment="CENTER" spacing="4" prefHeight="80"
                              HBox.hgrow="ALWAYS"
                              onMouseClicked="#selectProfessor"
                              style="-fx-background-color: white;
                                     -fx-border-color: #dee2e6;
                                     -fx-border-width: 1.5;
                                     -fx-border-radius: 6;
                                     -fx-background-radius: 6;
                                     -fx-cursor: hand;">
                            <Label text="💼" style="-fx-font-size: 20px;"/>
                            <Label text="Formateur"
                                   style="-fx-font-weight: bold; -fx-text-fill: #1a2035; -fx-font-size: 13px;"/>
                        </VBox>
                    </HBox>

                    <HBox spacing="10">
                        <TextField fx:id="firstNameField" promptText="Prénom"
                                   prefHeight="40" HBox.hgrow="ALWAYS"
                                   style="-fx-background-color: #f8f9fa; -fx-border-color: #dee2e6;
                                          -fx-border-width: 1.5; -fx-border-radius: 6; -fx-background-radius: 6;
                                          -fx-font-size: 13px; -fx-padding: 0 12 0 12;"/>
                        <TextField fx:id="lastNameField" promptText="Nom"
                                   prefHeight="40" HBox.hgrow="ALWAYS"
                                   style="-fx-background-color: #f8f9fa; -fx-border-color: #dee2e6;
                                          -fx-border-width: 1.5; -fx-border-radius: 6; -fx-background-radius: 6;
                                          -fx-font-size: 13px; -fx-padding: 0 12 0 12;"/>
                    </HBox>

                    <TextField fx:id="emailField" promptText="votre@email.com"
                               prefHeight="40" maxWidth="Infinity"
                               style="-fx-background-color: #f8f9fa; -fx-border-color: #dee2e6;
                                      -fx-border-width: 1.5; -fx-border-radius: 6; -fx-background-radius: 6;
                                      -fx-font-size: 13px; -fx-padding: 0 12 0 12;"/>

                    <TextField fx:id="usernameField" promptText="Nom d'utilisateur"
                               prefHeight="40" maxWidth="Infinity"
                               style="-fx-background-color: #f8f9fa; -fx-border-color: #dee2e6;
                                      -fx-border-width: 1.5; -fx-border-radius: 6; -fx-background-radius: 6;
                                      -fx-font-size: 13px; -fx-padding: 0 12 0 12;"/>

                    <VBox fx:id="teacherFieldsBox" spacing="10">
                        <TextField fx:id="specialtyField" promptText="Spécialité"
                                   prefHeight="40" maxWidth="Infinity"
                                   style="-fx-background-color: #f8f9fa; -fx-border-color: #dee2e6;
                                          -fx-border-width: 1.5; -fx-border-radius: 6; -fx-background-radius: 6;
                                          -fx-font-size: 13px; -fx-padding: 0 12 0 12;"/>
                        <TextField fx:id="experienceField" promptText="Expérience professionnelle"
                                   prefHeight="40" maxWidth="Infinity"
                                   style="-fx-background-color: #f8f9fa; -fx-border-color: #dee2e6;
                                          -fx-border-width: 1.5; -fx-border-radius: 6; -fx-background-radius: 6;
                                          -fx-font-size: 13px; -fx-padding: 0 12 0 12;"/>
                    </VBox>

                    <PasswordField fx:id="passwordField" promptText="Mot de passe"
                                   prefHeight="40" maxWidth="Infinity"
                                   style="-fx-background-color: #f8f9fa; -fx-border-color: #dee2e6;
                                          -fx-border-width: 1.5; -fx-border-radius: 6; -fx-background-radius: 6;
                                          -fx-font-size: 13px; -fx-padding: 0 12 0 12;"/>

                    <PasswordField fx:id="confirmPasswordField" promptText="Confirmer le mot de passe"
                                   prefHeight="40" maxWidth="Infinity"
                                   style="-fx-background-color: #f8f9fa; -fx-border-color: #dee2e6;
                                          -fx-border-width: 1.5; -fx-border-radius: 6; -fx-background-radius: 6;
                                          -fx-font-size: 13px; -fx-padding: 0 12 0 12;"/>

                    <Button text="Créer Mon Compte"
                            onAction="#register"
                            prefHeight="44"
                            maxWidth="Infinity"
                            style="-fx-background-color: #f5a623;
                                   -fx-text-fill: white;
                                   -fx-font-weight: bold;
                                   -fx-font-size: 14px;
                                   -fx-background-radius: 6;
                                   -fx-cursor: hand;"/>

                    <Button text="S'inscrire avec Google"
                            onAction="#registerWithGoogle"
                            prefHeight="42"
                            maxWidth="Infinity"
                            style="-fx-background-color: white;
                                   -fx-border-color: #dee2e6;
                                   -fx-border-width: 1.5;
                                   -fx-border-radius: 6;
                                   -fx-background-radius: 6;
                                   -fx-text-fill: #1a2035;
                                   -fx-font-size: 13px;
                                   -fx-cursor: hand;"/>

                    <HBox alignment="CENTER" spacing="5">
                        <Label text="Déjà un compte ?"
                               style="-fx-font-size: 13px; -fx-text-fill: #6b7592;"/>
                        <Button text="Se connecter"
                                fx:id="backBtn"
                                onAction="#goBack"
                                style="-fx-background-color: transparent;
                                       -fx-border-color: transparent;
                                       -fx-text-fill: #f5a623;
                                       -fx-font-size: 13px;
                                       -fx-font-weight: bold;
                                       -fx-cursor: hand;
                                       -fx-padding: 0;"/>
                    </HBox>
                </VBox>
            </VBox>
        </ScrollPane>
    </HBox>
</StackPane>