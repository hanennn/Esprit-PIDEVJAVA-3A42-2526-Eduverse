<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.controllers.AjoutCoursController"
      prefWidth="1200" prefHeight="750"
      style="-fx-background-color: #f4f6f9;">

    <!-- NAVBAR PLEINE LARGEUR -->
    <HBox alignment="CENTER_LEFT" spacing="0"
          style="-fx-background-color: #1a1f3c; -fx-min-height: 62;">
        <VBox style="-fx-background-color: #f5a623;
                     -fx-min-width: 4; -fx-min-height: 62;"/>
        <HBox alignment="CENTER_LEFT" spacing="10"
              style="-fx-padding: 0 20;" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER"
                  style="-fx-background-color: rgba(245,166,35,0.12);
                         -fx-background-radius: 10; -fx-padding: 7 11;">
                <Label text="📚" style="-fx-font-size: 20;"/>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="0">
                <Label text="edu"
                       style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: white;"/>
                <Label text="verse"
                       style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #f5a623;"/>
            </HBox>
            <Label text=" — Gestion des Cours"
                   style="-fx-font-size: 12; -fx-text-fill: #6c7a9c; -fx-font-style: italic;"/>
        </HBox>
    </HBox>

    <!-- BREADCRUMB PLEINE LARGEUR -->
    <HBox style="-fx-background-color: #f5a623; -fx-padding: 7 25;"
          alignment="CENTER_LEFT" spacing="10">
        <Label text="🏠 Accueil  ›  Cours  ›  Ajouter"
               style="-fx-text-fill: #1a1f3c; -fx-font-weight: bold; -fx-font-size: 11;"/>
        <HBox HBox.hgrow="ALWAYS"/>
        <Button text="⬅️ Retour au tableau de bord" onAction="#retour"
                style="-fx-background-color: #1a1f3c; -fx-text-fill: white;
                       -fx-background-radius: 8; -fx-padding: 5 15;
                       -fx-cursor: hand; -fx-font-weight: bold; -fx-font-size: 11;"/>
    </HBox>

    <!-- CONTENU PRINCIPAL -->
    <HBox VBox.vgrow="ALWAYS" spacing="0">

        <!-- ══ FORMULAIRE GAUCHE ══ -->
        <ScrollPane prefWidth="520" minWidth="520"
                    style="-fx-background-color: transparent;
                           -fx-background: #f4f6f9;
                           -fx-border-color: transparent;">
            <content>
                <VBox spacing="16" style="-fx-padding: 25; -fx-background-color: #f4f6f9;">

                    <!-- Titre formulaire -->
                    <VBox spacing="6">
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label text="+"
                                   style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #1a1f3c;"/>
                            <Label text="Nouveau Cours"
                                   style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #1a1f3c;"/>
                        </HBox>
                        <HBox style="-fx-background-color: #f5a623;
                                     -fx-min-height: 3; -fx-pref-width: 220;"/>
                    </VBox>

                    <!-- Carte formulaire -->
                    <VBox spacing="14"
                          style="-fx-background-color: white;
                                 -fx-background-radius: 14; -fx-padding: 22;
                                 -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.07),14,0,0,4);
                                 -fx-border-color: #f0f0f0; -fx-border-radius: 14;
                                 -fx-border-width: 1;">

                        <!-- Titre -->
                        <VBox spacing="5">
                            <Label text="Titre :"
                                   style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #333;"/>
                            <TextField fx:id="titreCours"
                                       promptText="Titre du cours"
                                       style="-fx-background-color: #f8f9fc;
                                              -fx-border-color: #dde1e7; -fx-border-radius: 8;
                                              -fx-background-radius: 8; -fx-padding: 10 14;
                                              -fx-font-size: 13;"/>
                        </VBox>

                        <!-- Description -->
                        <VBox spacing="5">
                            <Label text="Description :"
                                   style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #333;"/>
                            <TextArea fx:id="descCours"
                                      promptText="Décrivez le cours..."
                                      prefHeight="90" wrapText="true"
                                      style="-fx-background-color: #f8f9fc;
                                             -fx-border-color: #dde1e7; -fx-border-radius: 8;
                                             -fx-background-radius: 8; -fx-padding: 10 14;
                                             -fx-font-size: 13;"/>
                        </VBox>

                        <!-- Niveau -->
                        <VBox spacing="5">
                            <Label text="Niveau :"
                                   style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #333;"/>
                            <TextField fx:id="niveauCours"
                                       promptText="ex: Débutant, Avancé..."
                                       style="-fx-background-color: #f8f9fc;
                                              -fx-border-color: #dde1e7; -fx-border-radius: 8;
                                              -fx-background-radius: 8; -fx-padding: 10 14;
                                              -fx-font-size: 13;"/>
                        </VBox>

                        <!-- Matière -->
                        <VBox spacing="5">
                            <Label text="Matière :"
                                   style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #333;"/>
                            <TextField fx:id="matiereCours"
                                       promptText="ex: Mathématiques..."
                                       style="-fx-background-color: #f8f9fc;
                                              -fx-border-color: #dde1e7; -fx-border-radius: 8;
                                              -fx-background-radius: 8; -fx-padding: 10 14;
                                              -fx-font-size: 13;"/>
                        </VBox>

                        <!-- Langue -->
                        <VBox spacing="5">
                            <Label text="Langue :"
                                   style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #333;"/>
                            <ComboBox fx:id="langueCours"
                                      promptText="Choisir la langue"
                                      maxWidth="Infinity"
                                      style="-fx-background-color: #f8f9fc;
                                             -fx-border-color: #dde1e7; -fx-border-radius: 8;
                                             -fx-background-radius: 8; -fx-font-size: 13;"/>
                        </VBox>

                        <!-- Message -->
                        <Label fx:id="messageForm" text="" wrapText="true"
                               style="-fx-font-size: 12; -fx-font-weight: bold;"/>

                        <!-- Boutons -->
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Button text="Annuler" onAction="#annuler"
                                    prefWidth="140"
                                    style="-fx-background-color: #f8f9fc;
                                           -fx-text-fill: #333; -fx-font-weight: bold;
                                           -fx-background-radius: 8;
                                           -fx-border-color: #dde1e7; -fx-border-radius: 8;
                                           -fx-border-width: 1; -fx-padding: 10;
                                           -fx-cursor: hand; -fx-font-size: 13;"/>
                            <Button text="Ajouter le Cours" onAction="#ajouterCours"
                                    prefWidth="220"
                                    style="-fx-background-color: #f5a623;
                                           -fx-text-fill: white; -fx-font-weight: bold;
                                           -fx-background-radius: 8; -fx-padding: 10;
                                           -fx-cursor: hand; -fx-font-size: 13;
                                           -fx-effect: dropshadow(gaussian,rgba(245,166,35,0.4),8,0,0,2);"/>
                        </HBox>

                    </VBox>
                </VBox>
            </content>
        </ScrollPane>

        <!-- SEPARATEUR -->
        <VBox style="-fx-background-color: #e0e0e0; -fx-min-width: 1;"/>

        <!-- ══ LISTE DROITE ══ -->
        <VBox HBox.hgrow="ALWAYS" spacing="0"
              style="-fx-background-color: #f4f6f9;">

            <!-- Header liste -->
            <VBox spacing="14"
                  style="-fx-background-color: white; -fx-padding: 20 25;
                         -fx-border-color: transparent transparent #f0f0f0 transparent;
                         -fx-border-width: 0 0 1 0;">

                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label text="📋 Liste des Cours"
                           style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #1a1f3c;"/>
                    <HBox HBox.hgrow="ALWAYS"/>
                    <Button text="🔃 Rafraîchir" onAction="#chargerCours"
                            style="-fx-background-color: #f5a623; -fx-text-fill: white;
                                   -fx-font-weight: bold; -fx-background-radius: 8;
                                   -fx-padding: 8 18; -fx-cursor: hand; -fx-font-size: 12;"/>
                    <Button text="🔄 Réinitialiser" onAction="#reinitialiserFiltres"
                            style="-fx-background-color: #1a1f3c; -fx-text-fill: white;
                                   -fx-font-weight: bold; -fx-background-radius: 8;
                                   -fx-padding: 8 18; -fx-cursor: hand; -fx-font-size: 12;"/>
                </HBox>

                <!-- Filtres -->
                <VBox spacing="8"
                      style="-fx-background-color: #f8f9fc; -fx-background-radius: 10;
                             -fx-padding: 14; -fx-border-color: #ebebeb;
                             -fx-border-radius: 10; -fx-border-width: 1;">
                    <Label text="🔍 Recherche et Tri"
                           style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #555;"/>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <HBox alignment="CENTER_LEFT" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: white;
                                     -fx-border-color: #dde1e7;
                                     -fx-border-radius: 8; -fx-background-radius: 8;
                                     -fx-padding: 0 10;">
                            <TextField fx:id="searchField"
                                       promptText="🔍 Titre..."
                                       HBox.hgrow="ALWAYS"
                                       style="-fx-background-color: transparent;
                                              -fx-border-color: transparent;
                                              -fx-font-size: 11; -fx-padding: 7 0;"/>
                        </HBox>
                        <VBox spacing="3">
                            <Label text="NIVEAU"
                                   style="-fx-font-size: 9; -fx-font-weight: bold; -fx-text-fill: #bbb;"/>
                            <ComboBox fx:id="filterNiveauBox" prefWidth="120"
                                      style="-fx-background-color: white;
                                             -fx-border-color: #dde1e7;
                                             -fx-border-radius: 8; -fx-background-radius: 8;
                                             -fx-font-size: 11;"/>
                        </VBox>
                        <VBox spacing="3">
                            <Label text="LANGUE"
                                   style="-fx-font-size: 9; -fx-font-weight: bold; -fx-text-fill: #bbb;"/>
                            <ComboBox fx:id="filterLangueBox" prefWidth="120"
                                      style="-fx-background-color: white;
                                             -fx-border-color: #dde1e7;
                                             -fx-border-radius: 8; -fx-background-radius: 8;
                                             -fx-font-size: 11;"/>
                        </VBox>
                    </HBox>
                    <Label fx:id="countLabel" text="0 cours au total"
                           style="-fx-font-size: 11; -fx-text-fill: #888;"/>
                </VBox>
            </VBox>

            <!-- Header colonnes tableau -->
            <HBox style="-fx-background-color: #f8f9fa; -fx-padding: 10 25;
                         -fx-border-color: transparent transparent #e0e0e0 transparent;
                         -fx-border-width: 0 0 1 0;">
                <Label text="Titre"
                       style="-fx-font-weight: bold; -fx-font-size: 12;
                              -fx-text-fill: #555; -fx-pref-width: 180;"/>
                <Label text="Niveau"
                       style="-fx-font-weight: bold; -fx-font-size: 12;
                              -fx-text-fill: #555; -fx-pref-width: 130;"/>
                <Label text="Matière"
                       style="-fx-font-weight: bold; -fx-font-size: 12;
                              -fx-text-fill: #555; -fx-pref-width: 130;"/>
                <Label text="Langue"
                       style="-fx-font-weight: bold; -fx-font-size: 12;
                              -fx-text-fill: #555; -fx-pref-width: 100;"/>
                <Label text="Action"
                       style="-fx-font-weight: bold; -fx-font-size: 12; -fx-text-fill: #555;"/>
            </HBox>

            <!-- Liste scrollable -->
            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                        style="-fx-background-color: transparent;
                               -fx-background: white;
                               -fx-border-color: transparent;">
                <content>
                    <VBox fx:id="coursListContainer" spacing="0"
                          style="-fx-background-color: white; -fx-padding: 0 10;"/>
                </content>
            </ScrollPane>

        </VBox>
    </HBox>
</VBox>