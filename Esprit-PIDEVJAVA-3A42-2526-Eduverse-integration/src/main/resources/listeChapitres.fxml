<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.cell.PropertyValueFactory?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.controllers.ListeChapitresController"
      spacing="0" prefWidth="1200" prefHeight="750"
      style="-fx-background-color: #f4f6f9;">

    <!-- NAVBAR PLEINE LARGEUR -->
    <HBox alignment="CENTER_LEFT" spacing="0"
          style="-fx-background-color: #1a1f3c; -fx-min-height: 62;">
        <VBox style="-fx-background-color: #f5a623;
                     -fx-min-width: 4; -fx-min-height: 62;"/>
        <HBox alignment="CENTER_LEFT" spacing="10"
              style="-fx-padding: 0 20;" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER"
                  style="-fx-background-color: rgba(245,166,35,0.12);
                         -fx-background-radius: 10; -fx-padding: 7 11;">
                <Label text="📚" style="-fx-font-size: 20;"/>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="0">
                <Label text="edu"
                       style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: white;"/>
                <Label text="verse"
                       style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #f5a623;"/>
            </HBox>
            <Label text=" — Gestion des Chapitres"
                   style="-fx-font-size: 12; -fx-text-fill: #6c7a9c; -fx-font-style: italic;"/>
        </HBox>
    </HBox>

    <!-- BREADCRUMB -->
    <HBox style="-fx-background-color: #f5a623; -fx-padding: 7 25;"
          alignment="CENTER_LEFT" spacing="10">
        <Label fx:id="titreCours" text="🏠 Accueil  ›  Cours  ›  Chapitres"
               style="-fx-text-fill: #1a1f3c; -fx-font-weight: bold; -fx-font-size: 11;"/>
        <HBox HBox.hgrow="ALWAYS"/>
        <Button text="⬅️ Retour" onAction="#retour"
                style="-fx-background-color: #1a1f3c; -fx-text-fill: white;
                       -fx-background-radius: 8; -fx-padding: 5 15;
                       -fx-cursor: hand; -fx-font-weight: bold; -fx-font-size: 11;"/>
    </HBox>

    <!-- CONTENU -->
    <VBox VBox.vgrow="ALWAYS" style="-fx-padding: 25; -fx-background-color: #f4f6f9;">

        <!-- Header section -->
        <HBox alignment="CENTER_LEFT" spacing="12"
              style="-fx-background-color: white; -fx-background-radius: 12;
                     -fx-padding: 18 22;
                     -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.07),10,0,0,3);
                     -fx-border-color: #f0f0f0; -fx-border-radius: 12;
                     -fx-border-width: 1;">
            <StackPane style="-fx-background-color: #fff3e0;
                              -fx-background-radius: 8; -fx-padding: 7 9;">
                <Label text="📚" style="-fx-font-size: 16;"/>
            </StackPane>
            <VBox spacing="2">
                <Label text="Chapitres du cours"
                       style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #1a1f3c;"/>
                <Label text="Gérez les chapitres de votre cours"
                       style="-fx-font-size: 10; -fx-text-fill: #bbb;"/>
            </VBox>
            <HBox HBox.hgrow="ALWAYS"/>
            <Button text="➕ Ajouter Un Chapitre" onAction="#ajouterChapitre"
                    style="-fx-background-color: #f5a623; -fx-text-fill: white;
                           -fx-font-weight: bold; -fx-font-size: 12;
                           -fx-background-radius: 8; -fx-padding: 9 20;
                           -fx-cursor: hand;
                           -fx-effect: dropshadow(gaussian,rgba(245,166,35,0.4),8,0,0,2);"/>
            <Button text="🔃 Rafraîchir" onAction="#rafraichir"
                    style="-fx-background-color: #2d3561; -fx-text-fill: white;
                           -fx-font-weight: bold; -fx-font-size: 12;
                           -fx-background-radius: 8; -fx-padding: 9 16;
                           -fx-cursor: hand;"/>
        </HBox>

        <VBox style="-fx-padding: 15 0 0 0;" VBox.vgrow="ALWAYS">

            <!-- Tableau -->
            <VBox VBox.vgrow="ALWAYS"
                  style="-fx-background-color: white; -fx-background-radius: 12;
                         -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.07),10,0,0,3);
                         -fx-border-color: #f0f0f0; -fx-border-radius: 12;
                         -fx-border-width: 1;">

                <TableView fx:id="tableChapitres" VBox.vgrow="ALWAYS"
                           style="-fx-background-color: transparent;
                                  -fx-background-radius: 12;
                                  -fx-border-color: transparent;">
                    <columns>
                        <TableColumn fx:id="colTitre"   text="Titre"       prefWidth="170"/>
                        <TableColumn fx:id="colDesc"    text="Description" prefWidth="250"/>
                        <TableColumn fx:id="colOrdre"   text="Ordre"       prefWidth="70"/>
                        <TableColumn fx:id="colDuree"   text="Durée"       prefWidth="90"/>
                        <TableColumn fx:id="colStatut"  text="Statut"      prefWidth="110"/>
                        <TableColumn fx:id="colType"    text="Type"        prefWidth="80"/>
                        <TableColumn fx:id="colActions" text="Actions"     prefWidth="190"/>
                    </columns>
                    <placeholder>
                        <Label text="Aucun chapitre trouvé."
                               style="-fx-text-fill: #aaa; -fx-font-size: 14;"/>
                    </placeholder>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
            </VBox>
        </VBox>
    </VBox>
</VBox>