<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.controllers.EtudiantBoursesController"
      prefHeight="780.0" prefWidth="1280.0"
      spacing="0" style="-fx-background-color: #f4f6f8;">

    <!-- ══ NAVBAR ══ -->
    <HBox alignment="CENTER_LEFT" spacing="0"
          style="-fx-background-color: #1a1f3c;
                 -fx-min-height: 62;
                 -fx-border-color: transparent transparent #f5a623 transparent;
                 -fx-border-width: 0 0 3 0;">
        <HBox alignment="CENTER_LEFT" spacing="14"
              style="-fx-padding: 0 28;" HBox.hgrow="ALWAYS">

            <HBox alignment="CENTER"
                  style="-fx-background-color: rgba(245,166,35,0.15);
                         -fx-background-radius: 10; -fx-padding: 7 11;">
                <Label text="📚" style="-fx-font-size: 18;"/>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="0">
                <Label text="edu"
                       style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: white;"/>
                <Label text="center"
                       style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #f5a623;"/>
            </HBox>

            <VBox style="-fx-background-color: #2d3561; -fx-min-width: 1; -fx-min-height: 24;"/>
            <Label text="Espace Étudiant"
                   style="-fx-font-size: 11; -fx-text-fill: #6c7a9c; -fx-font-style: italic;"/>

            <HBox HBox.hgrow="ALWAYS"/>

            <HBox spacing="4" alignment="CENTER">
                <Label text="COURS"
                       style="-fx-background-color: rgba(245,166,35,0.12);
                              -fx-text-fill: #f5a623; -fx-font-size: 11;
                              -fx-font-weight: bold; -fx-background-radius: 8;
                              -fx-padding: 7 14;"/>
                <Label text="CERTIFICATIONS" onMouseClicked="#ouvrirCertifications"
                       style="-fx-text-fill: #8892b0; -fx-font-size: 11;
                              -fx-font-weight: bold; -fx-cursor: hand;
                              -fx-padding: 7 14; -fx-background-radius: 8;"/>
                <Label text="ÉVÉNEMENTS" onMouseClicked="#navigateToEvents"
                       style="-fx-text-fill: #8892b0; -fx-font-size: 11;
                              -fx-font-weight: bold; -fx-cursor: hand;
                              -fx-padding: 7 14; -fx-background-radius: 8;"/>
                <Label text="Cours" onMouseClicked="#navigateToCours"
                       style="-fx-text-fill: #8892b0; -fx-font-size: 11;
                              -fx-font-weight: bold; -fx-cursor: hand;
                              -fx-padding: 7 14; -fx-background-radius: 8;"/>
                <Button fx:id="forumButton" text="Forum" onAction="#handleForumButton"
                        style="-fx-background-color: white; -fx-text-fill: #1a1f3c;
                               -fx-font-weight: bold; -fx-font-size: 12px;
                               -fx-background-radius: 50; -fx-padding: 11 22;
                               -fx-cursor: hand;
                               -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 10, 0, 0, 4);"/>
                <Label text="PROFILE" onMouseClicked="#navigateToProfile"
                       style="-fx-text-fill: #8892b0; -fx-font-size: 11;
                              -fx-font-weight: bold; -fx-cursor: hand;
                              -fx-padding: 7 14; -fx-background-radius: 8;"/>
            </HBox>
        </HBox>
    </HBox>

    <!-- ══════ MAIN SCROLL CONTENT ══════ -->
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                style="-fx-background-color: #f4f6f8; -fx-background: #f4f6f8; -fx-border-color: transparent;">
        <VBox spacing="32" style="-fx-background-color: #f4f6f8;">
            <padding><Insets top="30" right="36" bottom="50" left="36"/></padding>

            <!-- ══════════════════════════════════════════ -->
            <!--  SECTION 1 : BOURSES                      -->
            <!-- ══════════════════════════════════════════ -->

            <!-- Notification badge -->
            <Label fx:id="lblNotifBadge" text="" visible="false"
                   style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold;
                          -fx-font-size: 12px; -fx-padding: 8 16; -fx-background-radius: 8;"/>

            <HBox alignment="CENTER_LEFT" spacing="16">
                <VBox HBox.hgrow="ALWAYS">
                    <Label text="Bourses Disponibles"
                           style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                    <Label text="Consultez les bourses et postulez directement"
                           style="-fx-font-size: 13px; -fx-text-fill: #999; -fx-padding: 2 0 0 0;"/>
                </VBox>
            </HBox>

            <!-- Recherche -->
            <VBox spacing="12"
                  style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 18;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 2);">
                <Label text="🔍  Recherche et Tri"
                       style="-fx-font-weight: bold; -fx-text-fill: #1a1a2e; -fx-font-size: 13px;"/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <TextField fx:id="tfRecherche" prefHeight="38" prefWidth="280"
                               promptText="Rechercher par titre..."
                               style="-fx-background-color: #f7f8fb; -fx-border-color: #e2e5ea;
                                      -fx-border-radius: 10; -fx-background-radius: 10;
                                      -fx-padding: 8 14; -fx-font-size: 13px;"/>
                    <ComboBox fx:id="cbTri" prefHeight="38" prefWidth="180" promptText="Trier par..."/>
                    <Button mnemonicParsing="false" onAction="#reinitialiserFiltres" text="🔄 Reset"
                            style="-fx-background-color: #1a1a2e; -fx-text-fill: white;
                                   -fx-font-weight: bold; -fx-background-radius: 8;
                                   -fx-padding: 9 18; -fx-cursor: hand; -fx-font-size: 12px;"/>
                </HBox>
            </VBox>

            <!-- Table bourses -->
            <VBox spacing="14"
                  style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 22;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 2);">
                <Label text="Liste des Bourses"
                       style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                <TableView fx:id="tableView" minHeight="340"
                           style="-fx-background-color: transparent; -fx-border-color: transparent;">
                    <columns>
                        <TableColumn fx:id="colTitre"    prefWidth="250" text="Titre"/>
                        <TableColumn fx:id="colMontant"  prefWidth="150" text="Montant (DT)"/>
                        <TableColumn fx:id="colDateAttr" prefWidth="190" text="Date Attribution"/>
                        <TableColumn fx:id="colDateFin"  prefWidth="190" text="Date Fin"/>
                    </columns>
                    <placeholder>
                        <Label text="Aucune bourse disponible."
                               style="-fx-text-fill: #bbb; -fx-font-size: 14px;"/>
                    </placeholder>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>

                <HBox alignment="CENTER" style="-fx-padding: 10 0 0 0;">
                    <Button fx:id="btnPostuler" disable="true" mnemonicParsing="false"
                            onAction="#ouvrirPostuler"
                            text="🎓  Postuler a cette bourse"
                            style="-fx-background-color: linear-gradient(to right, #f5a623, #f7b731);
                                   -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px;
                                   -fx-background-radius: 10; -fx-padding: 14 40; -fx-cursor: hand;
                                   -fx-effect: dropshadow(gaussian, rgba(245,166,35,0.3), 8, 0, 0, 3);"/>
                </HBox>
            </VBox>

            <!-- ══════════════════════════════════════════ -->
            <!--  SECTION 2 : CALENDRIER                   -->
            <!-- ══════════════════════════════════════════ -->

            <VBox spacing="0">
                <Label text="Calendrier des Bourses"
                       style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                <Label text="Visualisez les périodes d'attribution et de fin"
                       style="-fx-font-size: 13px; -fx-text-fill: #999; -fx-padding: 2 0 0 0;"/>
            </VBox>

            <!-- Navigation mois + Légende -->
            <HBox alignment="CENTER_LEFT" spacing="12"
                  style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 14 20;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 2);">
                <Button mnemonicParsing="false" onAction="#moisPrecedent" text="◀"
                        style="-fx-background-color: linear-gradient(to right, #f5a623, #f7b731); -fx-text-fill: white;
                               -fx-background-radius: 8; -fx-cursor: hand;
                               -fx-font-weight: bold; -fx-padding: 6 14;"/>
                <Label fx:id="lblMoisAnnee" prefWidth="200" alignment="CENTER"
                       style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                <Button mnemonicParsing="false" onAction="#moisSuivant" text="▶"
                        style="-fx-background-color: linear-gradient(to right, #f5a623, #f7b731); -fx-text-fill: white;
                               -fx-background-radius: 8; -fx-cursor: hand;
                               -fx-font-weight: bold; -fx-padding: 6 14;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="● Attribution"
                       style="-fx-text-fill: #2ecc71; -fx-font-weight: bold; -fx-font-size: 12px;"/>
                <Label text="● Fin"
                       style="-fx-text-fill: #e74c3c; -fx-font-weight: bold; -fx-font-size: 12px;"/>
                <Label text="● En cours"
                       style="-fx-text-fill: #4facfe; -fx-font-weight: bold; -fx-font-size: 12px;"/>
            </HBox>

            <!-- Grille calendrier -->
            <VBox style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 18;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 2);">
                <GridPane fx:id="gridCalendrier" hgap="3" vgap="3"/>
            </VBox>

            <!-- ══════════════════════════════════════════ -->
            <!--  SECTION 3 : INTERVIEW IA                 -->
            <!-- ══════════════════════════════════════════ -->

            <VBox spacing="0">
                <Label text="Interview IA"
                       style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                <Label text="Passez votre interview vocale pour les demandes acceptées"
                       style="-fx-font-size: 13px; -fx-text-fill: #999; -fx-padding: 2 0 0 0;"/>
            </VBox>

            <!-- Tableau des demandes (interview) -->
            <VBox spacing="14"
                  style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 22;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 2);">
                <Label text="Mes demandes"
                       style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                <Label text="Selectionnez une demande acceptee pour passer l'interview"
                       style="-fx-font-size: 12px; -fx-text-fill: #aaa;"/>

                <TableView fx:id="tableViewDemandes" minHeight="180" maxHeight="220"
                           style="-fx-background-color: transparent; -fx-border-color: transparent;">
                    <columns>
                        <TableColumn fx:id="colBourse" prefWidth="300" text="Bourse"/>
                        <TableColumn fx:id="colStatut" prefWidth="150" text="Statut"/>
                        <TableColumn fx:id="colDate"   prefWidth="200" text="Date demande"/>
                    </columns>
                    <placeholder>
                        <Label text="Aucune demande." style="-fx-text-fill: #bbb; -fx-font-size: 13px;"/>
                    </placeholder>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
            </VBox>

            <!-- Zone enregistrement -->
            <VBox fx:id="vboxEnregistrement" spacing="18" alignment="CENTER"
                  style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 30;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 2);">

                <Label fx:id="lblBourseTitre" text=""
                       style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #f5a623;"/>
                <Region prefHeight="2" style="-fx-background-color: linear-gradient(to right, #f5a623, #f7b731); -fx-background-radius: 2;" maxWidth="300"/>

                <Label fx:id="lblStatutRecord" text="Pret a enregistrer"
                       style="-fx-font-size: 13px; -fx-text-fill: #888;"/>

                <Label fx:id="lblTimer" text="00:00"
                       style="-fx-font-size: 42px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>

                <HBox spacing="14" alignment="CENTER">
                    <Button fx:id="btnEnregistrer" text="Commencer l'enregistrement"
                            onAction="#demarrerEnregistrement" mnemonicParsing="false"
                            style="-fx-background-color: linear-gradient(to right, #2ecc71, #27ae60); -fx-text-fill: white;
                                   -fx-font-weight: bold; -fx-font-size: 13px; -fx-background-radius: 10;
                                   -fx-padding: 12 28; -fx-cursor: hand;"/>
                    <Button fx:id="btnArreter" text="Arreter"
                            onAction="#arreterEnregistrement" mnemonicParsing="false"
                            style="-fx-background-color: #e74c3c; -fx-text-fill: white;
                                   -fx-font-weight: bold; -fx-font-size: 13px; -fx-background-radius: 10;
                                   -fx-padding: 12 28; -fx-cursor: hand;"/>
                    <Button fx:id="btnAnalyser" text="Analyser avec l'IA"
                            onAction="#lancerAnalyse" mnemonicParsing="false"
                            style="-fx-background-color: linear-gradient(to right, #a855f7, #7c3aed); -fx-text-fill: white;
                                   -fx-font-weight: bold; -fx-font-size: 13px; -fx-background-radius: 10;
                                   -fx-padding: 12 28; -fx-cursor: hand;"/>
                </HBox>

                <ProgressBar fx:id="progressBar" prefWidth="350" prefHeight="10" style="-fx-accent: #f5a623;"/>
                <Label fx:id="lblProgress" text="" style="-fx-font-size: 12px; -fx-text-fill: #888;"/>
            </VBox>

            <!-- Résultat transcription -->
            <VBox fx:id="vboxResultats" spacing="12"
                  style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 22;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 2);">
                <Label text="Transcription de votre interview"
                       style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                <Label text="L'analyse détaillée sera consultée par l'administration."
                       style="-fx-font-size: 12px; -fx-text-fill: #999;"/>
                <Label fx:id="lblTranscription" text="-" wrapText="true"
                       style="-fx-font-size: 13px; -fx-text-fill: #444; -fx-line-spacing: 4;
                              -fx-background-color: #f7f8fb; -fx-padding: 16; -fx-background-radius: 10;"/>
            </VBox>

        </VBox>
    </ScrollPane>
</VBox>
