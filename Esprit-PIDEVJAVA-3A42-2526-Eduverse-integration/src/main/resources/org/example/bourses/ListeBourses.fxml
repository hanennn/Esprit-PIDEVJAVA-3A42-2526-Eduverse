<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.ScrollPane?>

<HBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.controllers.ListeBoursesController"
      prefHeight="780.0" prefWidth="1280.0"
      spacing="0" style="-fx-background-color: #f4f6f8;">

    <!-- ══════ SIDEBAR ══════ -->
    <!-- ══ SIDEBAR ══ -->
    <VBox minWidth="220" maxWidth="220"
          style="-fx-background-color: #1a1a2e; -fx-min-height: 780;">

        <VBox alignment="CENTER" prefHeight="80"
              style="-fx-border-color: rgba(255,255,255,0.08); -fx-border-width: 0 0 1 0; -fx-padding: 0 20;">
            <HBox alignment="CENTER" spacing="0">
                <Label text="Edu"   style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                <Label text="verse" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #f5a623;"/>
            </HBox>
            <Label text="Espace Admin"
                   style="-fx-font-size: 11px; -fx-text-fill: rgba(255,255,255,0.4);"/>
        </VBox>

        <Label text="MENU"
               style="-fx-font-size: 10px; -fx-text-fill: rgba(255,255,255,0.3);
                      -fx-font-weight: bold; -fx-padding: 20 20 8 20;"/>

        <VBox spacing="2" style="-fx-padding: 0 10;" VBox.vgrow="ALWAYS">

            <HBox alignment="CENTER_LEFT" prefHeight="44" spacing="12"
                  onMouseClicked="#goToAdminUser"
                  style="-fx-padding: 0 12; -fx-cursor: hand; -fx-background-radius: 6;">
                <Label text="👥" style="-fx-font-size: 15px;"/>
                <Label text="Utilisateurs"
                       style="-fx-text-fill: rgba(255,255,255,0.6); -fx-font-size: 13px;"/>
            </HBox>

            <!-- ACTIVE -->
            <HBox alignment="CENTER_LEFT" prefHeight="44" spacing="12"
                  style="-fx-padding: 0 12; -fx-background-color: #f5a623; -fx-background-radius: 6; -fx-cursor: hand;">
                <Label text="📚" style="-fx-font-size: 15px;"/>
                <Label text="Bourse"
                       style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px;"/>
            </HBox>

            <HBox alignment="CENTER_LEFT" prefHeight="44" spacing="12"
                  onMouseClicked="#NavigateToDemandes"
                  style="-fx-padding: 0 12; -fx-cursor: hand; -fx-background-radius: 6;">
                <Label text="📚" style="-fx-font-size: 15px;"/>
                <Label text="Demandes"
                       style="-fx-text-fill: rgba(255,255,255,0.6); -fx-font-size: 13px;"/>
            </HBox>

            <HBox alignment="CENTER_LEFT" prefHeight="44" spacing="12"
                  onMouseClicked="#goToAdminCours"
                  style="-fx-padding: 0 12; -fx-cursor: hand; -fx-background-radius: 6;">
                <Label text="📚" style="-fx-font-size: 15px;"/>
                <Label text="Cours"
                       style="-fx-text-fill: rgba(255,255,255,0.6); -fx-font-size: 13px;"/>
            </HBox>

            <HBox alignment="CENTER_LEFT" prefHeight="44" spacing="12"
                  onMouseClicked="#goToAdminQuiz"
                  style="-fx-padding: 0 12; -fx-cursor: hand; -fx-background-radius: 6;">
                <Label text="🎯" style="-fx-font-size: 15px;"/>
                <Label text="Quiz"
                       style="-fx-text-fill: rgba(255,255,255,0.6); -fx-font-size: 13px;"/>
            </HBox>

            <HBox alignment="CENTER_LEFT" prefHeight="44" spacing="12"
                  onMouseClicked="#goToAdminCertification"
                  style="-fx-padding: 0 12; -fx-cursor: hand; -fx-background-radius: 6;">
                <Label text="🏅" style="-fx-font-size: 15px;"/>
                <Label text="Certifications"
                       style="-fx-text-fill: rgba(255,255,255,0.6); -fx-font-size: 13px;"/>
            </HBox>

            <HBox alignment="CENTER_LEFT" prefHeight="44" spacing="12"
                  onMouseClicked="#goToAdminEvents"
                  style="-fx-padding: 0 12; -fx-cursor: hand; -fx-background-radius: 6;">
                <Label text="📅" style="-fx-font-size: 15px;"/>
                <Label text="Événements"
                       style="-fx-text-fill: rgba(255,255,255,0.6); -fx-font-size: 13px;"/>
            </HBox>

            <HBox alignment="CENTER_LEFT" prefHeight="44" spacing="12"
                  onMouseClicked="#goToAdminForum"
                  style="-fx-padding: 0 12; -fx-cursor: hand; -fx-background-radius: 6;">
                <Label text="💬" style="-fx-font-size: 15px;"/>
                <Label text="Forum"
                       style="-fx-text-fill: rgba(255,255,255,0.6); -fx-font-size: 13px;"/>
            </HBox>

            <HBox alignment="CENTER_LEFT" prefHeight="44" spacing="12"
                  onMouseClicked="#goToAdminBadwords"
                  style="-fx-padding: 0 12; -fx-cursor: hand; -fx-background-radius: 6;">
                <Label text="🚫" style="-fx-font-size: 15px;"/>
                <Label text="Badwords"
                       style="-fx-text-fill: rgba(255,255,255,0.6); -fx-font-size: 13px;"/>
            </HBox>

        </VBox>
        <Label text="COMPTE"
               style="-fx-font-size: 10px; -fx-text-fill: rgba(255,255,255,0.3);
                      -fx-font-weight: bold; -fx-padding: 10 20 8 20;"/>

        <VBox style="-fx-padding: 0 10 20 10;">
            <Button fx:id="addUserBtn"
                    text="⏻  Déconnexion"
                    onAction="#allerAccueil"
                    maxWidth="Infinity" prefHeight="40"
                    style="-fx-background-color: transparent; -fx-text-fill: #e74c3c;
                           -fx-border-color: rgba(231,76,60,0.4); -fx-border-width: 1;
                           -fx-border-radius: 6; -fx-background-radius: 6;
                           -fx-font-size: 13px; -fx-cursor: hand;"/>
        </VBox>

    </VBox>

    <!-- ══════ MAIN CONTENT ══════ -->
    <ScrollPane fitToWidth="true" HBox.hgrow="ALWAYS"
                style="-fx-background-color: #f4f6f8; -fx-background: #f4f6f8; -fx-border-color: transparent;">
        <VBox spacing="22" style="-fx-background-color: #f4f6f8;">
            <padding><Insets top="30" right="36" bottom="36" left="36"/></padding>

            <!-- ── Header ── -->
            <HBox alignment="CENTER_LEFT" spacing="16">
                <VBox HBox.hgrow="ALWAYS">
                    <Label text="Gestion des Bourses"
                           style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                    <Label text="Gerez toutes les bourses de la plateforme"
                           style="-fx-font-size: 13px; -fx-text-fill: #999; -fx-padding: 2 0 0 0;"/>
                </VBox>
                <Button fx:id="btnAjouter" mnemonicParsing="false" onAction="#ouvrirAjout"
                        text="+ Ajouter Bourse"
                        style="-fx-background-color: linear-gradient(to right, #f5a623, #f7b731);
                               -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10;
                               -fx-padding: 12 28; -fx-cursor: hand; -fx-font-size: 13px;
                               -fx-effect: dropshadow(gaussian, rgba(245,166,35,0.3), 8, 0, 0, 3);"/>
            </HBox>

            <!-- ── KPI Cards ── -->
            <HBox spacing="14">
                <VBox HBox.hgrow="ALWAYS" spacing="6" minHeight="105"
                      style="-fx-background-color: linear-gradient(to bottom right, #4facfe, #00f2fe);
                             -fx-background-radius: 14; -fx-padding: 18;">
                    <Label fx:id="lblTotalBourses" text="0"
                           style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                    <Label text="BOURSES" style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: rgba(255,255,255,0.85);"/>
                </VBox>
                <VBox HBox.hgrow="ALWAYS" spacing="6" minHeight="105"
                      style="-fx-background-color: linear-gradient(to bottom right, #43e97b, #38f9d7);
                             -fx-background-radius: 14; -fx-padding: 18;">
                    <Label fx:id="lblTotalDemandes" text="0"
                           style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                    <Label text="DEMANDES" style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: rgba(255,255,255,0.85);"/>
                </VBox>
                <VBox HBox.hgrow="ALWAYS" spacing="6" minHeight="105"
                      style="-fx-background-color: linear-gradient(to bottom right, #f5a623, #f7b731);
                             -fx-background-radius: 14; -fx-padding: 18;">
                    <Label fx:id="lblTauxAcceptation" text="0%"
                           style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                    <Label text="TAUX ACCEPTATION" style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: rgba(255,255,255,0.85);"/>
                </VBox>
                <VBox HBox.hgrow="ALWAYS" spacing="6" minHeight="105"
                      style="-fx-background-color: linear-gradient(to bottom right, #a855f7, #7c3aed);
                             -fx-background-radius: 14; -fx-padding: 18;">
                    <Label fx:id="lblMontantMoyen" text="0 DT"
                           style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                    <Label text="MONTANT MOYEN" style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: rgba(255,255,255,0.85);"/>
                </VBox>
                <VBox HBox.hgrow="ALWAYS" spacing="6" minHeight="105"
                      style="-fx-background-color: linear-gradient(to bottom right, #ef4444, #dc2626);
                             -fx-background-radius: 14; -fx-padding: 18;">
                    <Label fx:id="lblMontantTotal" text="0 DT"
                           style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                    <Label text="MONTANT TOTAL" style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: rgba(255,255,255,0.85);"/>
                </VBox>
            </HBox>

            <!-- ── Recherche ── -->
            <VBox spacing="10"
                  style="-fx-background-color: white; -fx-background-radius: 14;
                         -fx-padding: 18;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 2);">
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label text="🔍" style="-fx-font-size: 14px;"/>
                    <TextField fx:id="tfRecherche" prefHeight="38" HBox.hgrow="ALWAYS"
                               promptText="Rechercher une bourse par titre..."
                               style="-fx-background-color: #f4f6f9; -fx-border-color: #e2e5ea;
                                      -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 8 14;
                                      -fx-font-size: 13px;"/>
                </HBox>
            </VBox>

            <!-- ── Table ── -->
            <VBox spacing="14"
                  style="-fx-background-color: white; -fx-background-radius: 14;
                         -fx-padding: 22;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 2);">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="Liste des Bourses"
                           style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                    <Label text="—" style="-fx-text-fill: #ddd;"/>
                    <Label text="Double-cliquez pour voir le detail"
                           style="-fx-font-size: 12px; -fx-text-fill: #aaa;"/>
                </HBox>

                <TableView fx:id="tableView" minHeight="380"
                           style="-fx-background-color: transparent; -fx-border-color: transparent;">
                    <columns>
                        <TableColumn fx:id="colTitre"    prefWidth="280" text="Titre"/>
                        <TableColumn fx:id="colMontant"  prefWidth="160" text="Montant (DT)"/>
                        <TableColumn fx:id="colDateAttr" prefWidth="200" text="Date Attribution"/>
                        <TableColumn fx:id="colDateFin"  prefWidth="200" text="Date Fin"/>
                    </columns>
                    <placeholder>
                        <Label text="Aucune bourse trouvee."
                               style="-fx-text-fill: #bbb; -fx-font-size: 14px;"/>
                    </placeholder>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
            </VBox>

            <!-- ── Charts Row 1 ── -->
            <HBox spacing="16">
                <VBox HBox.hgrow="ALWAYS"
                      style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 18;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 2);">
                    <Label text="Demandes par statut"
                           style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                    <PieChart fx:id="pieStatut" prefHeight="230" labelsVisible="true" legendVisible="true"/>
                </VBox>
                <VBox HBox.hgrow="ALWAYS"
                      style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 18;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 2);">
                    <Label text="Montants des bourses"
                           style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                    <BarChart fx:id="barMontants" prefHeight="230" legendVisible="false">
                        <xAxis><CategoryAxis label="Bourse"/></xAxis>
                        <yAxis><NumberAxis label="Montant (DT)"/></yAxis>
                    </BarChart>
                </VBox>
            </HBox>

            <!-- ── Charts Row 2 ── -->
            <HBox spacing="16">
                <VBox HBox.hgrow="ALWAYS"
                      style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 18;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 2);">
                    <Label text="Demandes par niveau d'etudes"
                           style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                    <PieChart fx:id="pieNiveau" prefHeight="230" labelsVisible="true" legendVisible="true"/>
                </VBox>
                <VBox HBox.hgrow="ALWAYS"
                      style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 18;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 2);">
                    <Label text="Demandes par bourse"
                           style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                    <BarChart fx:id="barDemandesParBourse" prefHeight="230" legendVisible="false">
                        <xAxis><CategoryAxis label="Bourse"/></xAxis>
                        <yAxis><NumberAxis label="Nb demandes"/></yAxis>
                    </BarChart>
                </VBox>
            </HBox>

        </VBox>
    </ScrollPane>
</HBox>
