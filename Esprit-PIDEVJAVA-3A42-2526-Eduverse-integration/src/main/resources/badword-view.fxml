<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>

<HBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.controllers.BadwordController"
      prefHeight="780.0" prefWidth="1280.0"
      style="-fx-background-color: #f8f9fa;">

    <!-- ══ SIDEBAR ══ -->
    <VBox minWidth="220" maxWidth="220"
          style="-fx-background-color: #1a1a2e; -fx-min-height: 780;">

        <VBox alignment="CENTER" prefHeight="80"
              style="-fx-border-color: rgba(255,255,255,0.08); -fx-border-width: 0 0 1 0; -fx-padding: 0 20;">
            <HBox alignment="CENTER" spacing="0">
                <Label text="Edu"   style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                <Label text="verse" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #f5a623;"/>
            </HBox>
            <Label text="Espace Admin"
                   style="-fx-font-size: 11px; -fx-text-fill: rgba(255,255,255,0.4);"/>
        </VBox>

        <Label text="MENU"
               style="-fx-font-size: 10px; -fx-text-fill: rgba(255,255,255,0.3);
                  -fx-font-weight: bold; -fx-padding: 20 20 8 20;"/>

        <VBox spacing="2" style="-fx-padding: 0 10;" VBox.vgrow="ALWAYS">

            <HBox alignment="CENTER_LEFT" prefHeight="44" spacing="12"
                  onMouseClicked="#goToAdminUser"
                  style="-fx-padding: 0 12; -fx-cursor: hand; -fx-background-radius: 6;">
                <Label text="👥" style="-fx-font-size: 15px;"/>
                <Label text="Utilisateurs"
                       style="-fx-text-fill: rgba(255,255,255,0.6); -fx-font-size: 13px;"/>
            </HBox>

            <HBox alignment="CENTER_LEFT" prefHeight="44" spacing="12"
                  onMouseClicked="#NavigateToBourses"
                  style="-fx-padding: 0 12; -fx-cursor: hand; -fx-background-radius: 6;">
                <Label text="📚" style="-fx-font-size: 15px;"/>
                <Label text="Bourse"
                       style="-fx-text-fill: rgba(255,255,255,0.6); -fx-font-size: 13px;"/>
            </HBox>

            <HBox alignment="CENTER_LEFT" prefHeight="44" spacing="12"
                  onMouseClicked="#NavigateToDemandes"
                  style="-fx-padding: 0 12; -fx-cursor: hand; -fx-background-radius: 6;">
                <Label text="📚" style="-fx-font-size: 15px;"/>
                <Label text="Demandes"
                       style="-fx-text-fill: rgba(255,255,255,0.6); -fx-font-size: 13px;"/>
            </HBox>

            <HBox alignment="CENTER_LEFT" prefHeight="44" spacing="12"
                  onMouseClicked="#goToAdminCours"
                  style="-fx-padding: 0 12; -fx-cursor: hand; -fx-background-radius: 6;">
                <Label text="📚" style="-fx-font-size: 15px;"/>
                <Label text="Cours"
                       style="-fx-text-fill: rgba(255,255,255,0.6); -fx-font-size: 13px;"/>
            </HBox>

            <HBox alignment="CENTER_LEFT" prefHeight="44" spacing="12"
                  onMouseClicked="#goToAdminQuiz"
                  style="-fx-padding: 0 12; -fx-cursor: hand; -fx-background-radius: 6;">
                <Label text="🎯" style="-fx-font-size: 15px;"/>
                <Label text="Quiz"
                       style="-fx-text-fill: rgba(255,255,255,0.6); -fx-font-size: 13px;"/>
            </HBox>

            <HBox alignment="CENTER_LEFT" prefHeight="44" spacing="12"
                  onMouseClicked="#goToAdminCertification"
                  style="-fx-padding: 0 12; -fx-cursor: hand; -fx-background-radius: 6;">
                <Label text="🏅" style="-fx-font-size: 15px;"/>
                <Label text="Certifications"
                       style="-fx-text-fill: rgba(255,255,255,0.6); -fx-font-size: 13px;"/>
            </HBox>

            <!-- Événements NORMAL -->
            <HBox alignment="CENTER_LEFT" prefHeight="44" spacing="12"
                  onMouseClicked="#goToAdminEvents"
                  style="-fx-padding: 0 12; -fx-cursor: hand; -fx-background-radius: 6;">
                <Label text="📅" style="-fx-font-size: 15px;"/>
                <Label text="Événements"
                       style="-fx-text-fill: rgba(255,255,255,0.6); -fx-font-size: 13px;"/>
            </HBox>

            <HBox alignment="CENTER_LEFT" prefHeight="44" spacing="12"
                  onMouseClicked="#goToAdminForum"
                  style="-fx-padding: 0 12; -fx-cursor: hand; -fx-background-radius: 6;">
                <Label text="💬" style="-fx-font-size: 15px;"/>
                <Label text="Forum"
                       style="-fx-text-fill: rgba(255,255,255,0.6); -fx-font-size: 13px;"/>
            </HBox>

            <!-- 🔥 ACTIVE: BADWORDS -->
            <HBox alignment="CENTER_LEFT" prefHeight="44" spacing="12"
                  onMouseClicked="#goToAdminBadwords"
                  style="-fx-padding: 0 12; -fx-background-color: #f5a623; -fx-background-radius: 6; -fx-cursor: hand;">
                <Label text="🚫" style="-fx-font-size: 15px;"/>
                <Label text="Badwords"
                       style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px;"/>
            </HBox>

        </VBox>
        <Label text="COMPTE"
               style="-fx-font-size: 10px; -fx-text-fill: rgba(255,255,255,0.3);
                      -fx-font-weight: bold; -fx-padding: 10 20 8 20;"/>

        <VBox style="-fx-padding: 0 10 20 10;">
            <Button fx:id="addUserBtn"
                    text="⏻  Déconnexion"
                    onAction="#logout"
                    maxWidth="Infinity" prefHeight="40"
                    style="-fx-background-color: transparent; -fx-text-fill: #e74c3c;
                           -fx-border-color: rgba(231,76,60,0.4); -fx-border-width: 1;
                           -fx-border-radius: 6; -fx-background-radius: 6;
                           -fx-font-size: 13px; -fx-cursor: hand;"/>
        </VBox>

    </VBox>

    <!-- ══ CONTENT ══ -->
    <VBox HBox.hgrow="ALWAYS" spacing="25" style="-fx-padding: 30;">
        <children>
            <VBox spacing="5">
                <Label text="Gestion des Badwords" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                <Label text="Gérez les mots interdits et les actions de filtrage pour le forum." style="-fx-text-fill: #6c757d; -fx-font-size: 13px;"/>
            </VBox>

            <!-- FORM CARD -->
            <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 4);">
                <Label text="Ajouter un nouveau mot" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                <Label fx:id="validationLabel" textFill="#e74c3c" style="-fx-font-size: 12px;"/>
                <HBox spacing="15" alignment="CENTER_LEFT">
                    <TextField fx:id="wordField" promptText="Saisir le mot..." HBox.hgrow="ALWAYS" 
                               style="-fx-background-color: #f8f9fa; -fx-border-color: #dee2e6; -fx-border-radius: 5; -fx-padding: 10;"/>
                    <ComboBox fx:id="actionCombo" prefWidth="150" 
                              style="-fx-background-color: #f8f9fa; -fx-border-color: #dee2e6; -fx-border-radius: 5;"/>
                    <Button text="Ajouter" onAction="#handleAdd" 
                            style="-fx-background-color: #f5a623; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 25; -fx-background-radius: 5; -fx-cursor: hand;"/>
                </HBox>
            </VBox>

            <!-- TABLE CARD -->
            <VBox spacing="15" VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 4);">
                <Label text="Mots actuellement filtrés" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                <TableView fx:id="badwordsTable" VBox.vgrow="ALWAYS" 
                           style="-fx-background-color: transparent; -fx-border-color: #dee2e6; -fx-border-width: 1 0 0 0;"/>
            </VBox>
        </children>
    </VBox>
</HBox>
