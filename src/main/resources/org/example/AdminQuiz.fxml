<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.*?>

<HBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.controllers.AdminQuizController"
      prefHeight="780.0" prefWidth="1280.0"
      spacing="0" style="-fx-background-color: #f4f6f8;">

    <!-- ══ SIDEBAR ══ -->
    <VBox minWidth="220" maxWidth="220"
          style="-fx-background-color: #1a1a2e; -fx-min-height: 780;">

        <VBox alignment="CENTER" prefHeight="80"
              style="-fx-border-color: rgba(255,255,255,0.08); -fx-border-width: 0 0 1 0; -fx-padding: 0 20;">
            <HBox alignment="CENTER" spacing="0">
                <Label text="Edu"   style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                <Label text="verse" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #f5a623;"/>
            </HBox>
            <Label text="Espace Admin"
                   style="-fx-font-size: 11px; -fx-text-fill: rgba(255,255,255,0.4);"/>
        </VBox>

        <Label text="MENU"
               style="-fx-font-size: 10px; -fx-text-fill: rgba(255,255,255,0.3);
                      -fx-font-weight: bold; -fx-padding: 20 20 8 20;"/>

        <VBox spacing="2" style="-fx-padding: 0 10;" VBox.vgrow="ALWAYS">

            <HBox alignment="CENTER_LEFT" prefHeight="44" spacing="12"
                  style="-fx-padding: 0 12; -fx-cursor: hand; -fx-background-radius: 6;">
                <Label text="📊" style="-fx-font-size: 15px;"/>
                <Label text="Tableau de Bord"
                       style="-fx-text-fill: rgba(255,255,255,0.6); -fx-font-size: 13px;"/>
            </HBox>

            <HBox alignment="CENTER_LEFT" prefHeight="44" spacing="12"
                  onMouseClicked="#ouvrirUser"
                  style="-fx-padding: 0 12; -fx-cursor: hand; -fx-background-radius: 6;">
                <Label text="👥" style="-fx-font-size: 15px;"/>
                <Label text="Utilisateurs"
                       style="-fx-text-fill: rgba(255,255,255,0.6); -fx-font-size: 13px;"/>
            </HBox>

            <HBox alignment="CENTER_LEFT" prefHeight="44" spacing="12"
                  onMouseClicked="#ouvrirCours"
                  style="-fx-padding: 0 12; -fx-cursor: hand; -fx-background-radius: 6;">
                <Label text="📚" style="-fx-font-size: 15px;"/>
                <Label text="Cours"
                       style="-fx-text-fill: rgba(255,255,255,0.6); -fx-font-size: 13px;"/>
            </HBox>

            <!-- ACTIVE -->
            <HBox alignment="CENTER_LEFT" prefHeight="44" spacing="12"
                  style="-fx-padding: 0 12; -fx-background-color: #f5a623; -fx-background-radius: 6; -fx-cursor: hand;">
                <Label text="🎯" style="-fx-font-size: 15px;"/>
                <Label text="Quiz"
                       style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px;"/>
            </HBox>

            <HBox alignment="CENTER_LEFT" prefHeight="44" spacing="12"
                  onMouseClicked="#ouvrirCertifications"
                  style="-fx-padding: 0 12; -fx-cursor: hand; -fx-background-radius: 6;">
                <Label text="🏅" style="-fx-font-size: 15px;"/>
                <Label text="Certifications"
                       style="-fx-text-fill: rgba(255,255,255,0.6); -fx-font-size: 13px;"/>
            </HBox>

            <HBox alignment="CENTER_LEFT" prefHeight="44" spacing="12"
                  style="-fx-padding: 0 12; -fx-cursor: hand; -fx-background-radius: 6;">
                <Label text="📅" style="-fx-font-size: 15px;"/>
                <Label text="Événements"
                       style="-fx-text-fill: rgba(255,255,255,0.6); -fx-font-size: 13px;"/>
            </HBox>

            <HBox alignment="CENTER_LEFT" prefHeight="44" spacing="12"
                  style="-fx-padding: 0 12; -fx-cursor: hand; -fx-background-radius: 6;">
                <Label text="💬" style="-fx-font-size: 15px;"/>
                <Label text="Forum"
                       style="-fx-text-fill: rgba(255,255,255,0.6); -fx-font-size: 13px;"/>
            </HBox>

        </VBox>

        <Label text="COMPTE"
               style="-fx-font-size: 10px; -fx-text-fill: rgba(255,255,255,0.3);
                      -fx-font-weight: bold; -fx-padding: 10 20 8 20;"/>

        <VBox style="-fx-padding: 0 10 20 10;">
            <Button text="⏻  Déconnexion" onAction="#logout"
                    maxWidth="Infinity" prefHeight="40"
                    style="-fx-background-color: transparent; -fx-text-fill: #e74c3c;
                           -fx-border-color: rgba(231,76,60,0.4); -fx-border-width: 1;
                           -fx-border-radius: 6; -fx-background-radius: 6;
                           -fx-font-size: 13px; -fx-cursor: hand;"/>
        </VBox>
    </VBox>

    <!-- ══ MAIN CONTENT ══ -->
    <ScrollPane fitToWidth="true" HBox.hgrow="ALWAYS"
                style="-fx-background-color: #f4f6f8; -fx-background: #f4f6f8; -fx-border-color: transparent;">
        <VBox spacing="24" style="-fx-background-color: #f4f6f8;">
            <padding><Insets top="30" right="40" bottom="40" left="40"/></padding>

            <HBox alignment="CENTER_LEFT">
                <VBox HBox.hgrow="ALWAYS">
                    <Label text="Gestion des Quiz"
                           style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                    <Label text="Gérez tous les quiz de la plateforme"
                           style="-fx-font-size: 13px; -fx-text-fill: #888;"/>
                </VBox>
            </HBox>

            <HBox spacing="16">
                <VBox HBox.hgrow="ALWAYS" spacing="8" minHeight="110"
                      style="-fx-background-color: linear-gradient(to right, #f953c6, #b91d73);
                             -fx-background-radius: 12; -fx-padding: 20;">
                    <Label fx:id="lblTotalQuiz" text="0"
                           style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                    <Label text="TOTAL DES QUIZ"
                           style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                    <Label text="Tous types confondus"
                           style="-fx-font-size: 11px; -fx-text-fill: rgba(255,255,255,0.8);"/>
                </VBox>
                <VBox HBox.hgrow="ALWAYS" spacing="8" minHeight="110"
                      style="-fx-background-color: linear-gradient(to right, #f5a623, #f39c12);
                             -fx-background-radius: 12; -fx-padding: 20;">
                    <Label text="Quiz Final"
                           style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                    <Label text="TYPE"
                           style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                    <Label text="Évaluation de fin de cours"
                           style="-fx-font-size: 11px; -fx-text-fill: rgba(255,255,255,0.8);"/>
                </VBox>
                <VBox HBox.hgrow="ALWAYS" spacing="8" minHeight="110"
                      style="-fx-background-color: linear-gradient(to right, #4facfe, #00f2fe);
                             -fx-background-radius: 12; -fx-padding: 20;">
                    <Label text="70%"
                           style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                    <Label text="SCORE MINIMUM"
                           style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                    <Label text="Seuil de réussite standard"
                           style="-fx-font-size: 11px; -fx-text-fill: rgba(255,255,255,0.8);"/>
                </VBox>
            </HBox>

            <VBox spacing="12"
                  style="-fx-background-color: white; -fx-background-radius: 12;
                         -fx-border-color: #e8e8e8; -fx-border-radius: 12;
                         -fx-border-width: 1; -fx-padding: 20;">
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <VBox HBox.hgrow="ALWAYS">
                        <Label text="Liste des Quiz"
                               style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                        <Label fx:id="lblNbQuiz" text="0 quiz au total"
                               style="-fx-font-size: 12px; -fx-text-fill: #888;"/>
                    </VBox>
                    <Button text="🔃 Rafraîchir" onAction="#chargerQuiz"
                            style="-fx-background-color: #1a1a2e; -fx-text-fill: white;
                                   -fx-font-weight: bold; -fx-background-radius: 8;
                                   -fx-padding: 8 18; -fx-cursor: hand; -fx-font-size: 12px;"/>
                </HBox>

                <TableView fx:id="tableQuiz" minHeight="350"
                           style="-fx-background-color: transparent; -fx-border-color: transparent;">
                    <columns>
                        <TableColumn fx:id="colTitre" text="Titre"     prefWidth="220"/>
                        <TableColumn fx:id="colType"  text="Type"      prefWidth="140"/>
                        <TableColumn fx:id="colDuree" text="Durée"     prefWidth="100"/>
                        <TableColumn fx:id="colScore" text="Score Min" prefWidth="110"/>
                        <TableColumn fx:id="colCours" text="Cours"     prefWidth="200"/>
                    </columns>
                    <placeholder>
                        <Label text="Aucun quiz trouvé."
                               style="-fx-text-fill: #aaa; -fx-font-size: 13px;"/>
                    </placeholder>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>

                <HBox spacing="12" alignment="CENTER_LEFT">
                    <Button text="🗑️  Supprimer le Quiz sélectionné" onAction="#supprimerQuiz"
                            style="-fx-background-color: #e74c3c; -fx-text-fill: white;
                                   -fx-font-weight: bold; -fx-font-size: 13px;
                                   -fx-background-radius: 8; -fx-padding: 10 22; -fx-cursor: hand;"/>
                    <Label fx:id="messageQuiz" text="" wrapText="true"
                           style="-fx-font-size: 12px; -fx-font-weight: bold;"/>
                </HBox>
            </VBox>

        </VBox>
    </ScrollPane>
</HBox>