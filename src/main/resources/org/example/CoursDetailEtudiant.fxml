<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.controllers.CoursDetailEtudiantController"
      spacing="0" prefWidth="1200" prefHeight="750"
      style="-fx-background-color: #f4f6f9;">

    <!-- NAVBAR -->
    <HBox alignment="CENTER_LEFT" spacing="0"
          style="-fx-background-color: #1a1f3c; -fx-padding: 12 40;">
        <HBox alignment="CENTER_LEFT" spacing="4">
            <Label text="▶" style="-fx-font-size: 20; -fx-text-fill: #f5a623;"/>
            <Label text="edu" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Label text="center" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #f5a623;"/>
        </HBox>
        <HBox HBox.hgrow="ALWAYS"/>
        <HBox spacing="30" alignment="CENTER">
            <Label text="ACCUEIL" onMouseClicked="#retourAccueil"
                   style="-fx-text-fill: #f5a623; -fx-font-size: 12; -fx-font-weight: bold; -fx-cursor: hand;"/>
            <Label text="À PROPOS" style="-fx-text-fill: white; -fx-font-size: 12; -fx-cursor: hand;"/>
            <Label text="BOURSES"  style="-fx-text-fill: white; -fx-font-size: 12; -fx-cursor: hand;"/>
            <Label text="COURS"    style="-fx-text-fill: white; -fx-font-size: 12; -fx-font-weight: bold; -fx-cursor: hand;"/>
            <Label text="ÉVÉNEMENTS" style="-fx-text-fill: white; -fx-font-size: 12; -fx-cursor: hand;"/>
            <Label text="FORUM"   style="-fx-text-fill: white; -fx-font-size: 12; -fx-cursor: hand;"/>
            <Label text="CONTACT" style="-fx-text-fill: white; -fx-font-size: 12; -fx-cursor: hand;"/>
        </HBox>
    </HBox>

    <!-- BREADCRUMB -->
    <HBox style="-fx-background-color: #f5a623; -fx-padding: 7 40;"
          alignment="CENTER_LEFT" spacing="10">
        <Label fx:id="breadcrumb" text="🏠 Accueil  ›  Cours"
               style="-fx-text-fill: #1a1f3c; -fx-font-weight: bold;"/>
        <HBox HBox.hgrow="ALWAYS"/>
        <Button text="⬅️ Retour" onAction="#retourAccueil"
                style="-fx-background-color: #1a1f3c; -fx-text-fill: white;
                       -fx-background-radius: 8; -fx-padding: 5 15; -fx-cursor: hand;
                       -fx-font-weight: bold;"/>
    </HBox>

    <!-- CONTENU -->
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                style="-fx-background-color: transparent;
                       -fx-background: transparent;
                       -fx-border-color: transparent;">
        <content>
            <VBox spacing="20" style="-fx-padding: 30 40;">

                <!-- Info cours -->
                <VBox spacing="10"
                      style="-fx-background-color: white; -fx-background-radius: 12;
                             -fx-padding: 25;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
                    <Label fx:id="coursTitreLabel"
                           style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #1a1f3c;"/>
                    <HBox spacing="20">
                        <Label fx:id="coursDescLabel" wrapText="true"
                               style="-fx-font-size: 13; -fx-text-fill: #666;"/>
                    </HBox>
                    <Label fx:id="headerLabel" text=""
                           style="-fx-font-size: 0; -fx-text-fill: transparent;
                                  -fx-padding: 0; -fx-min-height: 0;
                                  -fx-pref-height: 0; -fx-max-height: 0;"/>
                </VBox>

                <!-- Bouton Inscrit -->
                <HBox alignment="CENTER">
                    <Button text="Inscrit"
                            onMouseClicked="#inscription"
                            style="-fx-background-color: #2ecc71; -fx-text-fill: white;
                                   -fx-font-weight: bold; -fx-background-radius: 20;
                                   -fx-padding: 10 40; -fx-font-size: 14; -fx-cursor: hand;
                                   -fx-effect: dropshadow(gaussian, rgba(46,204,113,0.3), 8, 0, 0, 2);"/>
                </HBox>

                <!-- CHAPITRES -->
                <Label text="📚 Contenu du cours"
                       style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #1a1f3c;"/>
                <VBox fx:id="chapitresContainer" spacing="0"
                      style="-fx-background-color: white; -fx-background-radius: 10;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);"/>

                <!-- QUIZ -->
                <Label text="🎮 Quiz du cours"
                       style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #1a1f3c;"/>
                <FlowPane fx:id="quizContainer"
                          hgap="20" vgap="20"
                          orientation="HORIZONTAL"
                          prefWrapLength="1100"
                          style="-fx-padding: 5;"/>

                <!-- ══ SECTION SOCIALE ══ -->
                <VBox spacing="0"
                      style="-fx-background-color: white; -fx-background-radius: 14;
                             -fx-border-color: #f0f0f0; -fx-border-radius: 14;
                             -fx-border-width: 1;
                             -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.07),10,0,0,3);">

                    <!-- Header social -->
                    <HBox alignment="CENTER_LEFT" spacing="10"
                          style="-fx-background-color: #1a1f3c;
                                 -fx-background-radius: 14 14 0 0;
                                 -fx-padding: 14 20;">
                        <Label text="💬" style="-fx-font-size: 18;"/>
                        <Label text="Avis de la communauté"
                               style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: white;"/>
                        <HBox HBox.hgrow="ALWAYS"/>
                        <Label fx:id="likeCountLabel" text="👍 0"
                               style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #f5a623;"/>
                        <Label text="  " style="-fx-font-size: 10;"/>
                        <Label fx:id="dislikeCountLabel" text="👎 0"
                               style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #e74c3c;"/>
                    </HBox>

                    <VBox spacing="16" style="-fx-padding: 20;">

                        <!-- Likes / Dislikes -->
                        <VBox spacing="8"
                              style="-fx-background-color: #f8f9fc; -fx-background-radius: 10;
                                     -fx-padding: 16; -fx-border-color: #ebebeb;
                                     -fx-border-radius: 10; -fx-border-width: 1;">
                            <Label text="Votre avis sur ce cours :"
                                   style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #1a1f3c;"/>
                            <HBox spacing="12" alignment="CENTER_LEFT">
                                <Button fx:id="btnLike" text="👍  J'aime"
                                        onAction="#toggleLike"
                                        style="-fx-background-color: #e8f5e9; -fx-text-fill: #2ecc71;
                                               -fx-font-weight: bold; -fx-font-size: 13;
                                               -fx-background-radius: 8; -fx-border-color: #a8d5b0;
                                               -fx-border-radius: 8; -fx-border-width: 1;
                                               -fx-padding: 9 22; -fx-cursor: hand;"/>
                                <Button fx:id="btnDislike" text="👎  Je n'aime pas"
                                        onAction="#toggleDislike"
                                        style="-fx-background-color: #fef2f2; -fx-text-fill: #e74c3c;
                                               -fx-font-weight: bold; -fx-font-size: 13;
                                               -fx-background-radius: 8; -fx-border-color: #fecaca;
                                               -fx-border-radius: 8; -fx-border-width: 1;
                                               -fx-padding: 9 22; -fx-cursor: hand;"/>
                                <HBox HBox.hgrow="ALWAYS"/>
                                <VBox alignment="CENTER" spacing="2">
                                    <Label fx:id="scoreLabel" text="0%"
                                           style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #f5a623;"/>
                                    <Label text="satisfaction"
                                           style="-fx-font-size: 10; -fx-text-fill: #aaa;"/>
                                </VBox>
                            </HBox>
                        </VBox>

                        <!-- Commentaires -->
                        <VBox spacing="8">
                            <Label text="Commentaires"
                                   style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #1a1f3c;"/>
                            <VBox fx:id="commentairesContainer" spacing="10"/>
                        </VBox>

                        <!-- Ajouter commentaire -->
                        <VBox spacing="8"
                              style="-fx-background-color: #f8f9fc; -fx-background-radius: 10;
                                     -fx-padding: 14; -fx-border-color: #ebebeb;
                                     -fx-border-radius: 10; -fx-border-width: 1;">
                            <Label text="✍️ Laisser un commentaire"
                                   style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #555;"/>
                            <HBox spacing="10" alignment="CENTER">
                                <TextField fx:id="nomUserField"
                                           promptText="Votre prénom..."
                                           prefWidth="160"
                                           style="-fx-background-color: white;
                                                  -fx-border-color: #dde1e7;
                                                  -fx-border-radius: 8; -fx-background-radius: 8;
                                                  -fx-padding: 8 12; -fx-font-size: 12;"/>
                                <TextArea fx:id="commentaireField"
                                          promptText="Votre commentaire sur ce cours..."
                                          prefHeight="60" wrapText="true"
                                          HBox.hgrow="ALWAYS"
                                          style="-fx-background-color: white;
                                                 -fx-border-color: #dde1e7;
                                                 -fx-border-radius: 8; -fx-background-radius: 8;
                                                 -fx-padding: 8 12; -fx-font-size: 12;"/>
                                <Button text="Envoyer ➤"
                                        onAction="#ajouterCommentaire"
                                        style="-fx-background-color: #f5a623;
                                               -fx-text-fill: white; -fx-font-weight: bold;
                                               -fx-font-size: 12; -fx-background-radius: 8;
                                               -fx-padding: 10 18; -fx-cursor: hand;"/>
                            </HBox>
                        </VBox>

                    </VBox>
                </VBox>

            </VBox>
        </content>
    </ScrollPane>

</VBox>