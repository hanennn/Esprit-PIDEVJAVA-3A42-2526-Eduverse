<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.controllers.AjouterQuizController"
      spacing="0" prefWidth="1100" prefHeight="700"
      style="-fx-background-color: #f4f6f9;">

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="12"
          style="-fx-background-color: #1a1f3c; -fx-padding: 15 25;">
        <Label text="📚" style="-fx-font-size: 24;"/>
        <Label text="edu" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: white;"/>
        <Label text="verse" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #f5a623;"/>
        <Label text=" — Gestion des Quiz"
               style="-fx-font-size: 16; -fx-text-fill: #a0a8c0;"/>
    </HBox>

    <!-- Barre dorée avec bouton retour -->
    <HBox style="-fx-background-color: #f5a623; -fx-padding: 7 25;"
          alignment="CENTER_LEFT" spacing="10">
        <Label text="🏠 Accueil  ›  Quiz  ›  Ajouter"
               style="-fx-text-fill: #1a1f3c; -fx-font-weight: bold;"/>
        <HBox HBox.hgrow="ALWAYS"/>
        <Button text="⬅️ Retour au tableau de bord"
                onAction="#goAccueil"
                style="-fx-background-color: #1a1f3c; -fx-text-fill: white;
                       -fx-font-weight: bold; -fx-background-radius: 8;
                       -fx-padding: 6 16; -fx-cursor: hand;"/>
    </HBox>

    <!-- CONTENU PRINCIPAL sans sidebar -->
    <HBox spacing="20" VBox.vgrow="ALWAYS" style="-fx-padding: 20;">

        <!-- Formulaire -->
        <ScrollPane fitToWidth="true" prefWidth="420"
                    style="-fx-background-color: transparent;
                           -fx-background: transparent;
                           -fx-border-color: transparent;">
            <content>
                <VBox spacing="6"
                      style="-fx-background-color: white;
                             -fx-background-radius: 12; -fx-padding: 20;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 12, 0, 0, 3);">

                    <Label text="➕ Nouveau Quiz"
                           style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #1a1f3c;"/>
                    <HBox style="-fx-background-color: #f5a623;
                                 -fx-min-height: 3; -fx-background-radius: 2;"/>

                    <Label text="Titre :"
                           style="-fx-text-fill: #555; -fx-font-weight: bold; -fx-padding: 6 0 0 0;"/>
                    <TextField fx:id="titreField" promptText="Titre du quiz"
                               style="-fx-background-color: #f4f6f9; -fx-border-color: #dde1e7;
                                      -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 9;"/>
                    <Label fx:id="titreError" text=""
                           style="-fx-text-fill: #e74c3c; -fx-font-size: 11;"/>

                    <Label text="Type de Quiz :"
                           style="-fx-text-fill: #555; -fx-font-weight: bold; -fx-padding: 4 0 0 0;"/>
                    <ComboBox fx:id="typeQuizBox" promptText="Choisir le type"
                              prefWidth="380"
                              style="-fx-background-color: #f4f6f9; -fx-border-color: #dde1e7;
                                     -fx-border-radius: 8; -fx-background-radius: 8;"/>
                    <Label fx:id="typeError" text=""
                           style="-fx-text-fill: #e74c3c; -fx-font-size: 11;"/>

                    <Label text="Durée (minutes) :"
                           style="-fx-text-fill: #555; -fx-font-weight: bold; -fx-padding: 4 0 0 0;"/>
                    <TextField fx:id="dureeField" promptText="Ex: 30"
                               style="-fx-background-color: #f4f6f9; -fx-border-color: #dde1e7;
                                      -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 9;"/>
                    <Label fx:id="dureeError" text=""
                           style="-fx-text-fill: #e74c3c; -fx-font-size: 11;"/>

                    <Label text="Score Minimum :"
                           style="-fx-text-fill: #555; -fx-font-weight: bold; -fx-padding: 4 0 0 0;"/>
                    <TextField fx:id="scoreField" promptText="Ex: 10.5"
                               style="-fx-background-color: #f4f6f9; -fx-border-color: #dde1e7;
                                      -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 9;"/>
                    <Label fx:id="scoreError" text=""
                           style="-fx-text-fill: #e74c3c; -fx-font-size: 11;"/>

                    <Label text="Cours Associé :"
                           style="-fx-text-fill: #555; -fx-font-weight: bold; -fx-padding: 4 0 0 0;"/>
                    <ComboBox fx:id="coursBox" promptText="Choisir un cours"
                              prefWidth="380"
                              style="-fx-background-color: #f4f6f9; -fx-border-color: #dde1e7;
                                     -fx-border-radius: 8; -fx-background-radius: 8;"/>
                    <Label fx:id="coursError" text=""
                           style="-fx-text-fill: #e74c3c; -fx-font-size: 11;"/>

                    <VBox spacing="8" style="-fx-padding: 10 0 0 0;">
                        <Button text="✅  Ajouter" onAction="#ajouterQuiz"
                                prefWidth="380"
                                style="-fx-background-color: #f5a623; -fx-text-fill: white;
                                       -fx-font-weight: bold; -fx-font-size: 13;
                                       -fx-background-radius: 8; -fx-padding: 11; -fx-cursor: hand;"/>

                        <Button text="❓  Ajouter + Questions"
                                onAction="#ajouterEtOuvrirQuestions"
                                prefWidth="380"
                                style="-fx-background-color: #2196F3; -fx-text-fill: white;
                                       -fx-font-weight: bold; -fx-font-size: 13;
                                       -fx-background-radius: 8; -fx-padding: 11; -fx-cursor: hand;"/>

                        <Button text="✏️  Modifier" onAction="#modifierQuiz"
                                prefWidth="380"
                                style="-fx-background-color: #1a1f3c; -fx-text-fill: white;
                                       -fx-font-weight: bold; -fx-font-size: 13;
                                       -fx-background-radius: 8; -fx-padding: 11; -fx-cursor: hand;"/>

                        <Button text="🗑️  Supprimer" onAction="#supprimerQuiz"
                                prefWidth="380"
                                style="-fx-background-color: #e74c3c; -fx-text-fill: white;
                                       -fx-font-weight: bold; -fx-font-size: 13;
                                       -fx-background-radius: 8; -fx-padding: 11; -fx-cursor: hand;"/>

                        <Button text="🔄  Annuler" onAction="#annuler"
                                prefWidth="380"
                                style="-fx-background-color: #f4f6f9; -fx-text-fill: #555;
                                       -fx-font-size: 13; -fx-border-color: #dde1e7;
                                       -fx-border-radius: 8; -fx-background-radius: 8;
                                       -fx-padding: 11; -fx-cursor: hand;"/>

                        <Button text="⬅️  Retour au tableau de bord"
                                onAction="#goAccueil"
                                prefWidth="380"
                                style="-fx-background-color: #2d3561; -fx-text-fill: white;
                                       -fx-font-size: 13; -fx-background-radius: 8;
                                       -fx-padding: 11; -fx-cursor: hand;"/>
                    </VBox>

                    <Label fx:id="messageLabel" text="" wrapText="true"
                           style="-fx-font-size: 12; -fx-font-weight: bold;"/>

                </VBox>
            </content>
        </ScrollPane>

        <!-- TableView + Recherche -->
        <VBox spacing="10" HBox.hgrow="ALWAYS">

            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="📋 Liste des Quiz"
                       style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #1a1f3c;"/>
                <Button text="🔃 Rafraîchir" onAction="#chargerQuiz"
                        style="-fx-background-color: #f5a623; -fx-text-fill: white;
                               -fx-font-weight: bold; -fx-background-radius: 8;
                               -fx-padding: 7 16; -fx-cursor: hand;"/>
                <Button text="🔄 Réinitialiser" onAction="#reinitialiserFiltres"
                        style="-fx-background-color: #2d3561; -fx-text-fill: white;
                               -fx-font-weight: bold; -fx-background-radius: 8;
                               -fx-padding: 7 16; -fx-cursor: hand;"/>
            </HBox>

            <!-- Recherche multicritère -->
            <VBox spacing="8"
                  style="-fx-background-color: white; -fx-background-radius: 10;
                         -fx-padding: 15;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">
                <Label text="🔍 Recherche et Tri"
                       style="-fx-font-weight: bold; -fx-text-fill: #1a1f3c; -fx-font-size: 13;"/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <TextField fx:id="searchTitreField"
                               promptText="🔍 Titre..."
                               prefWidth="160"
                               style="-fx-background-color: #f4f6f9; -fx-border-color: #dde1e7;
                                      -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 8;"/>
                    <ComboBox fx:id="filterTypeBox"
                              promptText="Type" prefWidth="130"
                              style="-fx-background-color: #f4f6f9; -fx-border-color: #dde1e7;
                                     -fx-border-radius: 8; -fx-background-radius: 8;"/>
                    <ComboBox fx:id="filterCoursBox"
                              promptText="Cours" prefWidth="130"
                              style="-fx-background-color: #f4f6f9; -fx-border-color: #dde1e7;
                                     -fx-border-radius: 8; -fx-background-radius: 8;"/>
                </HBox>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <TextField fx:id="searchDureeMinField"
                               promptText="⏱ Durée min" prefWidth="120"
                               style="-fx-background-color: #f4f6f9; -fx-border-color: #dde1e7;
                                      -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 8;"/>
                    <TextField fx:id="searchDureeMaxField"
                               promptText="⏱ Durée max" prefWidth="120"
                               style="-fx-background-color: #f4f6f9; -fx-border-color: #dde1e7;
                                      -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 8;"/>
                    <TextField fx:id="searchScoreMinField"
                               promptText="🎯 Score min" prefWidth="120"
                               style="-fx-background-color: #f4f6f9; -fx-border-color: #dde1e7;
                                      -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 8;"/>
                    <ComboBox fx:id="sortBox"
                              promptText="📊 Trier par..." prefWidth="150"
                              style="-fx-background-color: #f4f6f9; -fx-border-color: #dde1e7;
                                     -fx-border-radius: 8; -fx-background-radius: 8;"/>
                </HBox>
                <Label fx:id="resultCountLabel" text=""
                       style="-fx-font-size: 11; -fx-text-fill: #888;"/>
            </VBox>

            <TableView fx:id="quizTable" VBox.vgrow="ALWAYS"
                       style="-fx-background-color: white; -fx-background-radius: 12;
                              -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 12, 0, 0, 3);">
                <columns>
                    <TableColumn fx:id="idCol"    text="ID"          prefWidth="55"/>
                    <TableColumn fx:id="titreCol" text="Titre"       prefWidth="160"/>
                    <TableColumn fx:id="typeCol"  text="Type"        prefWidth="110"/>
                    <TableColumn fx:id="dureeCol" text="Durée (min)" prefWidth="95"/>
                    <TableColumn fx:id="scoreCol" text="Score Min"   prefWidth="90"/>
                    <TableColumn fx:id="coursCol" text="Cours"       prefWidth="110"/>
                </columns>
            </TableView>

        </VBox>
    </HBox>
</VBox>