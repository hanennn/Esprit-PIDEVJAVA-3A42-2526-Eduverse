<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.chart.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.controllers.AccueilFormateurController"
      spacing="0" prefWidth="1200" prefHeight="750"
      style="-fx-background-color: #f4f6f9;">

    <!-- ══ HEADER ══ -->
    <HBox alignment="CENTER_LEFT" spacing="0"
          style="-fx-background-color: #1a1f3c; -fx-min-height: 62;">
        <VBox style="-fx-background-color: #f5a623;
                     -fx-min-width: 4; -fx-min-height: 62;"/>
        <HBox alignment="CENTER_LEFT" spacing="14"
              style="-fx-padding: 0 25;" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER"
                  style="-fx-background-color: rgba(245,166,35,0.12);
                         -fx-background-radius: 10; -fx-padding: 7 11;">
                <Label text="📚" style="-fx-font-size: 20;"/>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="0">
                <Label text="edu"
                       style="-fx-font-size: 22; -fx-font-weight: bold;
                              -fx-text-fill: white;"/>
                <Label text="verse"
                       style="-fx-font-size: 22; -fx-font-weight: bold;
                              -fx-text-fill: #f5a623;"/>
            </HBox>
            <VBox style="-fx-background-color: #2d3561;
                         -fx-min-width: 1; -fx-min-height: 26;"/>
            <Label text="Espace Formateur"
                   style="-fx-font-size: 12; -fx-text-fill: #6c7a9c;
                          -fx-font-style: italic;"/>
            <HBox HBox.hgrow="ALWAYS"/>
            <HBox alignment="CENTER" spacing="8"
                  onMouseClicked="#retourAccueil"
                  style="-fx-background-color: transparent;
                         -fx-border-color: #f5a623; -fx-border-radius: 30;
                         -fx-border-width: 1.5; -fx-background-radius: 30;
                         -fx-padding: 8 18; -fx-cursor: hand;">
                <Label text="Changer espace"
                       style="-fx-text-fill: #f5a623; -fx-font-weight: bold;
                              -fx-font-size: 11;"/>
            </HBox>
        </HBox>
    </HBox>

    <!-- ══ BREADCRUMB ══ -->
    <HBox style="-fx-background-color: #f5a623; -fx-padding: 7 29;"
          alignment="CENTER_LEFT" spacing="8">
        <Label text="Accueil Formateur"
               style="-fx-text-fill: #1a1f3c; -fx-font-weight: bold;
                      -fx-font-size: 11;"/>
    </HBox>

    <!-- ══ BODY ══ -->
    <HBox VBox.vgrow="ALWAYS">

        <!-- ══ SIDEBAR ══ -->
        <VBox fx:id="sidebar" spacing="0" prefWidth="230"
              style="-fx-background-color: #1a1f3c;">

            <VBox alignment="CENTER" spacing="8"
                  style="-fx-padding: 24 20 20 20;
                         -fx-background-color: rgba(255,255,255,0.03);
                         -fx-border-color: transparent transparent #2d3561 transparent;
                         -fx-border-width: 0 0 1 0;">
                <StackPane style="-fx-background-color: #f5a623;
                                  -fx-background-radius: 35;
                                  -fx-min-width: 56; -fx-min-height: 56;">
                    <Label text="F"
                           style="-fx-text-fill: white; -fx-font-weight: bold;
                                  -fx-font-size: 24;"/>
                </StackPane>
                <VBox alignment="CENTER" spacing="3">
                    <Label text="Formateur"
                           style="-fx-text-fill: white; -fx-font-weight: bold;
                                  -fx-font-size: 13;"/>
                    <HBox alignment="CENTER" spacing="5">
                        <StackPane style="-fx-background-color: #2ecc71;
                                          -fx-background-radius: 5;
                                          -fx-min-width: 7; -fx-min-height: 7;"/>
                        <Label text="En ligne"
                               style="-fx-text-fill: #2ecc71; -fx-font-size: 10;"/>
                    </HBox>
                </VBox>
            </VBox>

            <Label text="N A V I G A T I O N"
                   style="-fx-text-fill: #3a4070; -fx-font-size: 9;
                          -fx-font-weight: bold; -fx-padding: 18 20 8 20;"/>

            <!-- Tableau de bord actif -->
            <HBox alignment="CENTER_LEFT" spacing="12"
                  style="-fx-padding: 13 20;
                         -fx-background-color: rgba(245,166,35,0.12);
                         -fx-border-color: transparent #f5a623 transparent transparent;
                         -fx-border-width: 0 3 0 0;">
                <StackPane style="-fx-background-color: #f5a623;
                                  -fx-background-radius: 8;
                                  -fx-min-width: 32; -fx-min-height: 32;">
                    <Label text="📊" style="-fx-font-size: 13;"/>
                </StackPane>
                <VBox spacing="1">
                    <Label text="Tableau de bord"
                           style="-fx-text-fill: #f5a623; -fx-font-size: 12;
                                  -fx-font-weight: bold;"/>
                    <Label text="Statistiques"
                           style="-fx-text-fill: #6c5020; -fx-font-size: 9;"/>
                </VBox>
            </HBox>

            <!-- Mes Quiz -->
            <HBox alignment="CENTER_LEFT" spacing="12"
                  onMouseClicked="#allerVersAjoutQuiz"
                  style="-fx-padding: 13 20; -fx-cursor: hand;">
                <StackPane style="-fx-background-color: #2d3561;
                                  -fx-background-radius: 8;
                                  -fx-min-width: 32; -fx-min-height: 32;">
                    <Label text="📝" style="-fx-font-size: 13;"/>
                </StackPane>
                <VBox spacing="1">
                    <Label text="Mes Quiz"
                           style="-fx-text-fill: #8892b0; -fx-font-size: 12;"/>
                    <Label text="Creer et gerer"
                           style="-fx-text-fill: #3a4070; -fx-font-size: 9;"/>
                </VBox>
            </HBox>

            <!-- Questions -->
            <HBox alignment="CENTER_LEFT" spacing="12"
                  onMouseClicked="#allerVersQuestions"
                  style="-fx-padding: 13 20; -fx-cursor: hand;">
                <StackPane style="-fx-background-color: #2d3561;
                                  -fx-background-radius: 8;
                                  -fx-min-width: 32; -fx-min-height: 32;">
                    <Label text="❓" style="-fx-font-size: 13;"/>
                </StackPane>
                <VBox spacing="1">
                    <Label text="Questions"
                           style="-fx-text-fill: #8892b0; -fx-font-size: 12;"/>
                    <Label text="Banque de questions"
                           style="-fx-text-fill: #3a4070; -fx-font-size: 9;"/>
                </VBox>
            </HBox>

            <HBox style="-fx-background-color: #2d3561; -fx-min-height: 1;"/>

            <Label text="C O M P T E"
                   style="-fx-text-fill: #3a4070; -fx-font-size: 9;
                          -fx-font-weight: bold; -fx-padding: 14 20 8 20;"/>

            <HBox alignment="CENTER_LEFT" spacing="12"
                  onMouseClicked="#retourAccueil"
                  style="-fx-padding: 13 20; -fx-cursor: hand;">
                <StackPane style="-fx-background-color: #2d3561;
                                  -fx-background-radius: 8;
                                  -fx-min-width: 32; -fx-min-height: 32;">
                    <Label text="🔄" style="-fx-font-size: 13;"/>
                </StackPane>
                <VBox spacing="1">
                    <Label text="Changer espace"
                           style="-fx-text-fill: #8892b0; -fx-font-size: 12;"/>
                    <Label text="Accueil principal"
                           style="-fx-text-fill: #3a4070; -fx-font-size: 9;"/>
                </VBox>
            </HBox>

            <VBox VBox.vgrow="ALWAYS"/>

            <VBox alignment="CENTER" spacing="4"
                  style="-fx-padding: 16;
                         -fx-background-color: rgba(0,0,0,0.15);
                         -fx-border-color: #2d3561 transparent transparent transparent;
                         -fx-border-width: 1 0 0 0;">
                <Label text="eduverse"
                       style="-fx-text-fill: #3a4070; -fx-font-size: 10;
                              -fx-font-weight: bold;"/>
                <Label text="Sprint 2 — 2025/2026"
                       style="-fx-text-fill: #2d3561; -fx-font-size: 9;"/>
            </VBox>
        </VBox>

        <!-- ══ CONTENU ══ -->
        <ScrollPane fitToWidth="true" HBox.hgrow="ALWAYS"
                    style="-fx-background-color: transparent;
                           -fx-background: #f4f6f9;
                           -fx-border-color: transparent;">
            <content>
                <VBox spacing="20" style="-fx-padding: 25;">

                    <!-- ══ DASHBOARD STATISTIQUES ══ -->
                    <VBox spacing="16"
                          style="-fx-background-color: white;
                                 -fx-background-radius: 14; -fx-padding: 22;
                                 -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.07),14,0,0,4);
                                 -fx-border-color: #f0f0f0; -fx-border-radius: 14;
                                 -fx-border-width: 1;">

                        <!-- Titre section -->
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <StackPane style="-fx-background-color: #eef2ff;
                                              -fx-background-radius: 8; -fx-padding: 7 9;">
                                <Label text="📊" style="-fx-font-size: 16;"/>
                            </StackPane>
                            <VBox spacing="2">
                                <Label text="Tableau de bord statistique"
                                       style="-fx-font-size: 16; -fx-font-weight: bold;
                                              -fx-text-fill: #1a1f3c;"/>
                                <Label text="Vue d'ensemble de vos quiz et questions"
                                       style="-fx-font-size: 10; -fx-text-fill: #aaa;"/>
                            </VBox>
                            <HBox HBox.hgrow="ALWAYS"/>
                            <Button text="Actualiser" onAction="#chargerDonnees"
                                    style="-fx-background-color: #f5a623;
                                           -fx-text-fill: white; -fx-font-weight: bold;
                                           -fx-background-radius: 8;
                                           -fx-padding: 7 16; -fx-cursor: hand;"/>
                        </HBox>

                        <HBox style="-fx-background-color: #f5f5f5; -fx-min-height: 1;"/>

                        <!-- Stat cards -->
                        <HBox fx:id="statsBox" spacing="12" alignment="CENTER_LEFT"/>

                        <HBox style="-fx-background-color: #f5f5f5; -fx-min-height: 1;"/>

                        <!-- Graphiques -->
                        <HBox spacing="16">

                            <!-- PieChart -->
                            <VBox spacing="8" HBox.hgrow="ALWAYS"
                                  style="-fx-background-color: #fafbff;
                                         -fx-background-radius: 12; -fx-padding: 16;
                                         -fx-border-color: #e8ecff;
                                         -fx-border-radius: 12; -fx-border-width: 1;">
                                <HBox alignment="CENTER_LEFT" spacing="8">
                                    <StackPane style="-fx-background-color: #eef2ff;
                                                      -fx-background-radius: 6;
                                                      -fx-padding: 5 7;">
                                        <Label text="🥧" style="-fx-font-size: 13;"/>
                                    </StackPane>
                                    <Label text="Repartition par type"
                                           style="-fx-font-size: 12; -fx-font-weight: bold;
                                                  -fx-text-fill: #1a1f3c;"/>
                                </HBox>
                                <PieChart fx:id="typeQuizChart"
                                          prefHeight="240"
                                          legendVisible="true"
                                          labelsVisible="true"
                                          style="-fx-background-color: transparent;"/>
                            </VBox>

                            <!-- BarChart -->
                            <VBox spacing="8" HBox.hgrow="ALWAYS"
                                  style="-fx-background-color: #fafbff;
                                         -fx-background-radius: 12; -fx-padding: 16;
                                         -fx-border-color: #e8ecff;
                                         -fx-border-radius: 12; -fx-border-width: 1;">
                                <HBox alignment="CENTER_LEFT" spacing="8">
                                    <StackPane style="-fx-background-color: #eef2ff;
                                                      -fx-background-radius: 6;
                                                      -fx-padding: 5 7;">
                                        <Label text="📊" style="-fx-font-size: 13;"/>
                                    </StackPane>
                                    <Label text="Questions par quiz"
                                           style="-fx-font-size: 12; -fx-font-weight: bold;
                                                  -fx-text-fill: #1a1f3c;"/>
                                </HBox>
                                <BarChart fx:id="questionsParQuizChart"
                                          prefHeight="240"
                                          legendVisible="false"
                                          animated="true"
                                          style="-fx-background-color: transparent;">
                                    <xAxis>
                                        <CategoryAxis label="Quiz"/>
                                    </xAxis>
                                    <yAxis>
                                        <NumberAxis label="Nb Questions"/>
                                    </yAxis>
                                </BarChart>
                            </VBox>
                        </HBox>
                    </VBox>

                    <!-- ══ SECTION QUIZ ══ -->
                    <VBox spacing="14"
                          style="-fx-background-color: white;
                                 -fx-background-radius: 14; -fx-padding: 22;
                                 -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.07),14,0,0,4);
                                 -fx-border-color: #f0f0f0; -fx-border-radius: 14;
                                 -fx-border-width: 1;">

                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <StackPane style="-fx-background-color: #fff3e0;
                                              -fx-background-radius: 8; -fx-padding: 7 9;">
                                <Label text="📝" style="-fx-font-size: 16;"/>
                            </StackPane>
                            <VBox spacing="2">
                                <Label text="Mes Quiz Crees"
                                       style="-fx-font-size: 15; -fx-font-weight: bold;
                                              -fx-text-fill: #1a1f3c;"/>
                                <Label text="Gerez vos evaluations"
                                       style="-fx-font-size: 10; -fx-text-fill: #bbb;"/>
                            </VBox>
                            <HBox HBox.hgrow="ALWAYS"/>
                            <Button text="Creer un Quiz"
                                    onAction="#allerVersAjoutQuiz"
                                    style="-fx-background-color: #f5a623;
                                           -fx-text-fill: white; -fx-font-weight: bold;
                                           -fx-font-size: 12; -fx-background-radius: 8;
                                           -fx-padding: 9 20; -fx-cursor: hand;"/>
                            <Button text="Rafraichir"
                                    onAction="#chargerDonnees"
                                    style="-fx-background-color: #2d3561;
                                           -fx-text-fill: white; -fx-font-weight: bold;
                                           -fx-font-size: 12; -fx-background-radius: 8;
                                           -fx-padding: 9 16; -fx-cursor: hand;"/>
                        </HBox>

                        <HBox style="-fx-background-color: #f5f5f5; -fx-min-height: 1;"/>

                        <!-- Filtres -->
                        <VBox spacing="8"
                              style="-fx-background-color: #f8f9fc;
                                     -fx-background-radius: 10; -fx-padding: 14;
                                     -fx-border-color: #ebebeb; -fx-border-radius: 10;
                                     -fx-border-width: 1;">
                            <Label text="Recherche et Filtres"
                                   style="-fx-font-weight: bold;
                                          -fx-text-fill: #1a1f3c; -fx-font-size: 11;"/>
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <HBox alignment="CENTER_LEFT" spacing="6"
                                      HBox.hgrow="ALWAYS"
                                      style="-fx-background-color: white;
                                             -fx-border-color: #dde1e7;
                                             -fx-border-radius: 8; -fx-background-radius: 8;
                                             -fx-padding: 0 10;">
                                    <TextField fx:id="searchTitreField"
                                               promptText="Rechercher par titre"
                                               HBox.hgrow="ALWAYS"
                                               style="-fx-background-color: transparent;
                                                      -fx-border-color: transparent;
                                                      -fx-font-size: 11; -fx-padding: 7 0;"/>
                                </HBox>
                                <VBox spacing="3">
                                    <Label text="TYPE"
                                           style="-fx-font-size: 9; -fx-font-weight: bold;
                                                  -fx-text-fill: #bbb;"/>
                                    <ComboBox fx:id="filterTypeBox" prefWidth="130"
                                              style="-fx-background-color: white;
                                                     -fx-border-color: #dde1e7;
                                                     -fx-border-radius: 8;
                                                     -fx-background-radius: 8;
                                                     -fx-font-size: 11;"/>
                                </VBox>
                                <VBox spacing="3">
                                    <Label text="COURS"
                                           style="-fx-font-size: 9; -fx-font-weight: bold;
                                                  -fx-text-fill: #bbb;"/>
                                    <ComboBox fx:id="filterCoursBox" prefWidth="140"
                                              style="-fx-background-color: white;
                                                     -fx-border-color: #dde1e7;
                                                     -fx-border-radius: 8;
                                                     -fx-background-radius: 8;
                                                     -fx-font-size: 11;"/>
                                </VBox>
                                <VBox spacing="3">
                                    <Label text="TRIER PAR"
                                           style="-fx-font-size: 9; -fx-font-weight: bold;
                                                  -fx-text-fill: #bbb;"/>
                                    <ComboBox fx:id="sortBox" prefWidth="155"
                                              style="-fx-background-color: white;
                                                     -fx-border-color: #dde1e7;
                                                     -fx-border-radius: 8;
                                                     -fx-background-radius: 8;
                                                     -fx-font-size: 11;"/>
                                </VBox>
                                <VBox spacing="3" alignment="BOTTOM_CENTER">
                                    <Label text=" " style="-fx-font-size: 9;"/>
                                    <Button text="Reset"
                                            onAction="#reinitialiserFiltres"
                                            style="-fx-background-color: #fdecea;
                                                   -fx-text-fill: #e74c3c;
                                                   -fx-font-weight: bold; -fx-font-size: 10;
                                                   -fx-background-radius: 8;
                                                   -fx-border-color: #fca5a5;
                                                   -fx-border-radius: 8; -fx-border-width: 1;
                                                   -fx-padding: 7 12; -fx-cursor: hand;"/>
                                </VBox>
                            </HBox>
                        </VBox>

                        <VBox fx:id="quizListContainer" spacing="12"/>
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </HBox>
</VBox>