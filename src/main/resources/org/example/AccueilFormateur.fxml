<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.controllers.AccueilFormateurController"
      spacing="0" prefWidth="1200" prefHeight="750"
      style="-fx-background-color: #f4f6f9;">

    <HBox alignment="CENTER_LEFT" spacing="12"
          style="-fx-background-color: #1a1f3c; -fx-padding: 15 25;">
        <Label text="📚" style="-fx-font-size: 24;"/>
        <Label text="edu" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: white;"/>
        <Label text="verse" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #f5a623;"/>
        <Label text=" — Espace Formateur"
               style="-fx-font-size: 16; -fx-text-fill: #a0a8c0;"/>
        <HBox HBox.hgrow="ALWAYS"/>
        <Button text="⬅️ Changer d'espace" onAction="#retourAccueil"
                style="-fx-background-color: #f5a623; -fx-text-fill: white;
                       -fx-background-radius: 8; -fx-padding: 7 15;
                       -fx-cursor: hand; -fx-font-weight: bold;"/>
    </HBox>

    <HBox style="-fx-background-color: #f5a623; -fx-padding: 7 25;">
        <Label text="🏠 Accueil Formateur"
               style="-fx-text-fill: #1a1f3c; -fx-font-weight: bold;"/>
    </HBox>

    <HBox VBox.vgrow="ALWAYS">

        <!-- SIDEBAR -->
        <VBox spacing="5" prefWidth="220"
              style="-fx-background-color: #1a1f3c; -fx-padding: 20 0;">

            <Label text="MENU"
                   style="-fx-text-fill: #a0a8c0; -fx-font-size: 11;
                          -fx-font-weight: bold; -fx-padding: 0 20 10 20;"/>

            <HBox alignment="CENTER_LEFT" spacing="10"
                  style="-fx-padding: 12 20; -fx-background-color: #f5a623;">
                <Label text="🏠" style="-fx-font-size: 15;"/>
                <Label text="Tableau de bord" style="-fx-text-fill: white;
                       -fx-font-size: 13; -fx-font-weight: bold;"/>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="10"
                  onMouseClicked="#allerVersAjoutQuiz"
                  style="-fx-padding: 12 20; -fx-cursor: hand;">
                <Label text="📝" style="-fx-font-size: 15;"/>
                <Label text="Mes Quiz"
                       style="-fx-text-fill: #a0a8c0; -fx-font-size: 13;"/>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="10"
                  onMouseClicked="#allerVersQuestions"
                  style="-fx-padding: 12 20; -fx-cursor: hand;">
                <Label text="❓" style="-fx-font-size: 15;"/>
                <Label text="Questions"
                       style="-fx-text-fill: #a0a8c0; -fx-font-size: 13;"/>
            </HBox>

            <VBox style="-fx-background-color: #2d3561; -fx-min-height: 1;"/>

            <Label text="COMPTE"
                   style="-fx-text-fill: #a0a8c0; -fx-font-size: 11;
                          -fx-font-weight: bold; -fx-padding: 10 20 10 20;"/>

            <HBox alignment="CENTER_LEFT" spacing="10"
                  onMouseClicked="#retourAccueil"
                  style="-fx-padding: 12 20; -fx-cursor: hand;">
                <Label text="🔄" style="-fx-font-size: 15;"/>
                <Label text="Changer espace"
                       style="-fx-text-fill: #a0a8c0; -fx-font-size: 13;"/>
            </HBox>

        </VBox>

        <!-- CONTENU -->
        <ScrollPane fitToWidth="true" HBox.hgrow="ALWAYS"
                    style="-fx-background-color: transparent;
                           -fx-background: transparent;
                           -fx-border-color: transparent;">
            <content>
                <VBox spacing="20" style="-fx-padding: 25;">

                    <!-- Section Quiz -->
                    <VBox spacing="12"
                          style="-fx-background-color: white;
                                 -fx-background-radius: 12; -fx-padding: 20;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">

                        <!-- Header -->
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="📝 Mes Quiz Créés"
                                   style="-fx-font-size: 18; -fx-font-weight: bold;
                                          -fx-text-fill: #1a1f3c;"/>
                            <HBox HBox.hgrow="ALWAYS"/>
                            <Button text="➕ Créer un Quiz"
                                    onAction="#allerVersAjoutQuiz"
                                    style="-fx-background-color: #f5a623;
                                           -fx-text-fill: white;
                                           -fx-font-weight: bold;
                                           -fx-background-radius: 8;
                                           -fx-padding: 9 20; -fx-cursor: hand;"/>
                            <Button text="🔃 Rafraîchir"
                                    onAction="#chargerDonnees"
                                    style="-fx-background-color: #2d3561;
                                           -fx-text-fill: white;
                                           -fx-font-weight: bold;
                                           -fx-background-radius: 8;
                                           -fx-padding: 9 16; -fx-cursor: hand;"/>
                        </HBox>

                        <!-- Recherche -->
                        <VBox spacing="8"
                              style="-fx-background-color: #f8f9fa;
                                     -fx-background-radius: 8; -fx-padding: 12;
                                     -fx-border-color: #e9ecef;
                                     -fx-border-radius: 8;">
                            <Label text="🔍 Recherche et Tri"
                                   style="-fx-font-weight: bold;
                                          -fx-text-fill: #1a1f3c; -fx-font-size: 12;"/>
                            <HBox spacing="10">
                                <TextField fx:id="searchTitreField"
                                           promptText="Titre du quiz..."
                                           prefWidth="200"
                                           style="-fx-background-color: white;
                                                  -fx-border-color: #dde1e7;
                                                  -fx-border-radius: 6;
                                                  -fx-background-radius: 6;
                                                  -fx-padding: 7;"/>
                                <ComboBox fx:id="filterTypeBox"
                                          promptText="Type" prefWidth="130"
                                          style="-fx-background-color: white;
                                                 -fx-border-color: #dde1e7;
                                                 -fx-border-radius: 6;
                                                 -fx-background-radius: 6;"/>
                                <ComboBox fx:id="filterCoursBox"
                                          promptText="Cours" prefWidth="130"
                                          style="-fx-background-color: white;
                                                 -fx-border-color: #dde1e7;
                                                 -fx-border-radius: 6;
                                                 -fx-background-radius: 6;"/>
                                <ComboBox fx:id="sortBox"
                                          promptText="Trier par..." prefWidth="150"
                                          style="-fx-background-color: white;
                                                 -fx-border-color: #dde1e7;
                                                 -fx-border-radius: 6;
                                                 -fx-background-radius: 6;"/>
                                <Button text="🔄 Reset"
                                        onAction="#reinitialiserFiltres"
                                        style="-fx-background-color: #e74c3c;
                                               -fx-text-fill: white;
                                               -fx-background-radius: 6;
                                               -fx-padding: 7 12; -fx-cursor: hand;"/>
                            </HBox>
                        </VBox>

                        <!-- Liste des quiz -->
                        <VBox fx:id="quizListContainer" spacing="12"/>

                    </VBox>

                </VBox>
            </content>
        </ScrollPane>

    </HBox>
</VBox>