<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.controllers.CertificationsEtudiantController"
      spacing="0" prefWidth="1200" prefHeight="750"
      style="-fx-background-color: #f4f6f9;">

    <HBox alignment="CENTER_LEFT" spacing="12"
          style="-fx-background-color: #1a1f3c; -fx-padding: 15 25;">
        <Label text="📚" style="-fx-font-size: 24;"/>
        <Label text="edu" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: white;"/>
        <Label text="verse" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #f5a623;"/>
        <Label text=" — Mes Certifications"
               style="-fx-font-size: 16; -fx-text-fill: #a0a8c0;"/>
    </HBox>

    <HBox style="-fx-background-color: #f5a623; -fx-padding: 7 25;"
          alignment="CENTER_LEFT" spacing="10">
        <Label text="🏠 Accueil  ›  Certifications"
               style="-fx-text-fill: #1a1f3c; -fx-font-weight: bold;"/>
        <HBox HBox.hgrow="ALWAYS"/>
        <Button text="⬅️ Retour" onAction="#retourAccueil"
                style="-fx-background-color: #1a1f3c; -fx-text-fill: white;
                       -fx-background-radius: 8; -fx-padding: 5 15;
                       -fx-cursor: hand; -fx-font-weight: bold;"/>
    </HBox>

    <HBox VBox.vgrow="ALWAYS">

        <!-- SIDEBAR -->
        <VBox spacing="5" prefWidth="210"
              style="-fx-background-color: #1a1f3c; -fx-padding: 20 0;">

            <Label text="MENU"
                   style="-fx-text-fill: #a0a8c0; -fx-font-size: 11;
                          -fx-font-weight: bold; -fx-padding: 0 20 10 20;"/>

            <HBox alignment="CENTER_LEFT" spacing="10"
                  onMouseClicked="#retourAccueil"
                  style="-fx-padding: 12 20; -fx-cursor: hand;">
                <Label text="🏠" style="-fx-font-size: 15;"/>
                <Label text="Accueil"
                       style="-fx-text-fill: #a0a8c0; -fx-font-size: 13;"/>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="10"
                  style="-fx-padding: 12 20; -fx-cursor: hand;">
                <Label text="📖" style="-fx-font-size: 15;"/>
                <Label text="Mes Cours"
                       style="-fx-text-fill: #a0a8c0; -fx-font-size: 13;"/>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="10"
                  style="-fx-padding: 12 20; -fx-background-color: #f5a623;">
                <Label text="🏆" style="-fx-font-size: 15;"/>
                <Label text="Certifications" style="-fx-text-fill: white;
                       -fx-font-size: 13; -fx-font-weight: bold;"/>
            </HBox>

            <VBox style="-fx-background-color: #2d3561; -fx-min-height: 1;"/>

            <Label text="COMPTE"
                   style="-fx-text-fill: #a0a8c0; -fx-font-size: 11;
                          -fx-font-weight: bold; -fx-padding: 10 20 10 20;"/>

            <HBox alignment="CENTER_LEFT" spacing="10"
                  style="-fx-padding: 12 20; -fx-cursor: hand;">
                <Label text="⚙️" style="-fx-font-size: 15;"/>
                <Label text="Paramètres"
                       style="-fx-text-fill: #a0a8c0; -fx-font-size: 13;"/>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="10"
                  style="-fx-padding: 12 20; -fx-cursor: hand;">
                <Label text="🚪" style="-fx-font-size: 15;"/>
                <Label text="Déconnexion"
                       style="-fx-text-fill: #a0a8c0; -fx-font-size: 13;"/>
            </HBox>

        </VBox>

        <!-- CONTENU PRINCIPAL -->
        <HBox spacing="20" HBox.hgrow="ALWAYS" style="-fx-padding: 20;">

            <!-- COLONNE GAUCHE : Certifications -->
            <VBox spacing="15" prefWidth="480">

                <HBox alignment="CENTER_LEFT" spacing="15">
                    <Label text="🏆 Mes Certifications Finales"
                           style="-fx-font-size: 18; -fx-font-weight: bold;
                                  -fx-text-fill: #1a1f3c;"/>
                    <Button text="🔃 Rafraîchir" onAction="#chargerCertifications"
                            style="-fx-background-color: #f5a623; -fx-text-fill: white;
                                   -fx-font-weight: bold; -fx-background-radius: 8;
                                   -fx-padding: 7 16; -fx-cursor: hand;"/>
                </HBox>

                <Label fx:id="messageLabel" text=""
                       style="-fx-font-size: 13;"/>

                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                            style="-fx-background-color: transparent;
                                   -fx-background: transparent;
                                   -fx-border-color: transparent;">
                    <content>
                        <VBox fx:id="certifContainer" spacing="15"
                              style="-fx-padding: 5;"/>
                    </content>
                </ScrollPane>

            </VBox>

            <!-- COLONNE DROITE : Calendrier -->
            <VBox spacing="15" HBox.hgrow="ALWAYS">

                <Label text="📅 Calendrier des Certifications"
                       style="-fx-font-size: 18; -fx-font-weight: bold;
                              -fx-text-fill: #1a1f3c;"/>

                <!-- Navigation mois -->
                <HBox alignment="CENTER" spacing="15"
                      style="-fx-background-color: white; -fx-background-radius: 10;
                             -fx-padding: 12;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">
                    <Button text="◀" onAction="#moisPrecedent"
                            style="-fx-background-color: #f5a623; -fx-text-fill: white;
                                   -fx-font-weight: bold; -fx-background-radius: 6;
                                   -fx-padding: 6 14; -fx-cursor: hand;"/>
                    <Label fx:id="moisAnneeLabel" text="Avril 2026"
                           style="-fx-font-size: 16; -fx-font-weight: bold;
                                  -fx-text-fill: #1a1f3c; -fx-min-width: 160;
                                  -fx-alignment: center;"/>
                    <Button text="▶" onAction="#moisSuivant"
                            style="-fx-background-color: #f5a623; -fx-text-fill: white;
                                   -fx-font-weight: bold; -fx-background-radius: 6;
                                   -fx-padding: 6 14; -fx-cursor: hand;"/>
                    <HBox HBox.hgrow="ALWAYS"/>
                    <Button text="Aujourd'hui" onAction="#allerAujourdhui"
                            style="-fx-background-color: #2d3561; -fx-text-fill: white;
                                   -fx-font-size: 11; -fx-background-radius: 6;
                                   -fx-padding: 6 12; -fx-cursor: hand;"/>
                </HBox>

                <!-- Grille calendrier -->
                <VBox spacing="0" VBox.vgrow="ALWAYS"
                      style="-fx-background-color: white; -fx-background-radius: 12;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">

                    <!-- En-têtes jours -->
                    <GridPane fx:id="joursSemaine" hgap="0" vgap="0"
                              style="-fx-background-color: #1a1f3c;
                                     -fx-background-radius: 12 12 0 0; -fx-padding: 8 10;">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="14.28"/>
                            <ColumnConstraints percentWidth="14.28"/>
                            <ColumnConstraints percentWidth="14.28"/>
                            <ColumnConstraints percentWidth="14.28"/>
                            <ColumnConstraints percentWidth="14.28"/>
                            <ColumnConstraints percentWidth="14.28"/>
                            <ColumnConstraints percentWidth="14.28"/>
                        </columnConstraints>
                    </GridPane>

                    <!-- Cases du calendrier -->
                    <GridPane fx:id="calendrierGrid" hgap="0" vgap="0"
                              VBox.vgrow="ALWAYS"
                              style="-fx-padding: 5 10 10 10;">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="14.28"/>
                            <ColumnConstraints percentWidth="14.28"/>
                            <ColumnConstraints percentWidth="14.28"/>
                            <ColumnConstraints percentWidth="14.28"/>
                            <ColumnConstraints percentWidth="14.28"/>
                            <ColumnConstraints percentWidth="14.28"/>
                            <ColumnConstraints percentWidth="14.28"/>
                        </columnConstraints>
                    </GridPane>

                </VBox>

                <!-- Détail du jour sélectionné -->
                <VBox fx:id="detailJourBox" spacing="8" managed="false" visible="false"
                      style="-fx-background-color: white; -fx-background-radius: 10;
                             -fx-padding: 15;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">
                    <Label fx:id="detailJourTitre" text=""
                           style="-fx-font-size: 14; -fx-font-weight: bold;
                                  -fx-text-fill: #1a1f3c;"/>
                    <VBox fx:id="detailJourContenu" spacing="6"/>
                </VBox>

            </VBox>
        </HBox>
    </HBox>
</VBox>