<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.web.WebView?>

<HBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.controllers.AdminEventController"
      prefHeight="780.0" prefWidth="1280.0"
      spacing="0" style="-fx-background-color: #f4f6f8;">

    <!-- ══ SIDEBAR ══ -->
    <VBox minWidth="220" maxWidth="220"
          style="-fx-background-color: #1a1a2e; -fx-min-height: 780;">

        <VBox alignment="CENTER" prefHeight="80"
              style="-fx-border-color: rgba(255,255,255,0.08); -fx-border-width: 0 0 1 0; -fx-padding: 0 20;">
            <HBox alignment="CENTER" spacing="0">
                <Label text="Edu"   style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                <Label text="verse" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #f5a623;"/>
            </HBox>
            <Label text="Espace Admin"
                   style="-fx-font-size: 11px; -fx-text-fill: rgba(255,255,255,0.4);"/>
        </VBox>

        <Label text="MENU"
               style="-fx-font-size: 10px; -fx-text-fill: rgba(255,255,255,0.3);
                      -fx-font-weight: bold; -fx-padding: 20 20 8 20;"/>

        <VBox spacing="2" style="-fx-padding: 0 10;" VBox.vgrow="ALWAYS">

            <HBox alignment="CENTER_LEFT" prefHeight="44" spacing="12"
                  onMouseClicked="#ouvrirUser"
                  style="-fx-padding: 0 12; -fx-cursor: hand; -fx-background-radius: 6;">
                <Label text="👥" style="-fx-font-size: 15px;"/>
                <Label text="Utilisateurs"
                       style="-fx-text-fill: rgba(255,255,255,0.6); -fx-font-size: 13px;"/>
            </HBox>

            <HBox alignment="CENTER_LEFT" prefHeight="44" spacing="12"
                  onMouseClicked="#ouvrirCours"
                  style="-fx-padding: 0 12; -fx-cursor: hand; -fx-background-radius: 6;">
                <Label text="📚" style="-fx-font-size: 15px;"/>
                <Label text="Cours"
                       style="-fx-text-fill: rgba(255,255,255,0.6); -fx-font-size: 13px;"/>
            </HBox>

            <HBox alignment="CENTER_LEFT" prefHeight="44" spacing="12"
                  onMouseClicked="#ouvrirQuiz"
                  style="-fx-padding: 0 12; -fx-cursor: hand; -fx-background-radius: 6;">
                <Label text="🎯" style="-fx-font-size: 15px;"/>
                <Label text="Quiz"
                       style="-fx-text-fill: rgba(255,255,255,0.6); -fx-font-size: 13px;"/>
            </HBox>

            <HBox alignment="CENTER_LEFT" prefHeight="44" spacing="12"
                  onMouseClicked="#ouvrirCertifications"
                  style="-fx-padding: 0 12; -fx-cursor: hand; -fx-background-radius: 6;">
                <Label text="🏅" style="-fx-font-size: 15px;"/>
                <Label text="Certifications"
                       style="-fx-text-fill: rgba(255,255,255,0.6); -fx-font-size: 13px;"/>
            </HBox>

            <!-- ACTIVE -->
            <HBox alignment="CENTER_LEFT" prefHeight="44" spacing="12"
                  style="-fx-padding: 0 12; -fx-background-color: #f5a623; -fx-background-radius: 6; -fx-cursor: hand;">
                <Label text="📅" style="-fx-font-size: 15px;"/>
                <Label text="Événements"
                       style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px;"/>
            </HBox>

            <HBox alignment="CENTER_LEFT" prefHeight="44" spacing="12"
                  style="-fx-padding: 0 12; -fx-cursor: hand; -fx-background-radius: 6;">
                <Label text="💬" style="-fx-font-size: 15px;"/>
                <Label text="Forum"
                       style="-fx-text-fill: rgba(255,255,255,0.6); -fx-font-size: 13px;"/>
            </HBox>

        </VBox>

        <Label text="COMPTE"
               style="-fx-font-size: 10px; -fx-text-fill: rgba(255,255,255,0.3);
                      -fx-font-weight: bold; -fx-padding: 10 20 8 20;"/>

        <VBox style="-fx-padding: 0 10 20 10;" spacing="5">
            <Button text="🔄  Changer d'espace" onAction="#goHome"
                    maxWidth="Infinity" prefHeight="40"
                    style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.6);
                           -fx-alignment: CENTER_LEFT; -fx-padding: 0 15; -fx-cursor: hand;"/>
            <Button text="⏻  Déconnexion" onAction="#logout"
                    maxWidth="Infinity" prefHeight="40"
                    style="-fx-background-color: transparent; -fx-text-fill: #e74c3c;
                           -fx-border-color: rgba(231,76,60,0.4); -fx-border-width: 1;
                           -fx-border-radius: 6; -fx-background-radius: 6;
                           -fx-font-size: 13px; -fx-cursor: hand;"/>
        </VBox>
    </VBox>

    <!-- ══ MAIN CONTENT ══ -->
    <VBox HBox.hgrow="ALWAYS" style="-fx-background-color: #f4f6f8;">
        <padding><Insets top="20" right="30" bottom="20" left="30"/></padding>
        
        <Label text="Gestion des Événements" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e; -fx-padding: 0 0 15 0;"/>

        <TabPane fx:id="eventTabPane" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
            <tabs>
                <!-- Onglet 1 : Gestion -->
                <Tab text="🛠 Gestion">
                    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
                        <VBox spacing="20" style="-fx-background-color: transparent; -fx-padding: 20;">
                            <HBox spacing="15" alignment="CENTER_LEFT">
                                <TextField fx:id="tfSearch" promptText="Rechercher un événement..." prefWidth="300" style="-fx-background-radius: 8; -fx-padding: 8;"/>
                                <ComboBox fx:id="cbSort" promptText="Trier par..." prefWidth="150" style="-fx-background-radius: 8;"/>
                            </HBox>

                            <TableView fx:id="tvEvents" onMouseClicked="#handleTableClick" minHeight="300" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="colTitre" text="Titre" prefWidth="150"/>
                                    <TableColumn fx:id="colDesc" text="Description" prefWidth="180"/>
                                    <TableColumn fx:id="colType" text="Type" prefWidth="80"/>
                                    <TableColumn fx:id="colLieu" text="Lieu" prefWidth="120"/>
                                    <TableColumn fx:id="colLien" text="Lien Web" prefWidth="100"/>
                                    <TableColumn fx:id="colNiveau" text="Niveau" prefWidth="80"/>
                                    <TableColumn fx:id="colDate" text="Date" prefWidth="90"/>
                                    <TableColumn fx:id="colHeureDeb" text="H. Déb" prefWidth="70"/>
                                    <TableColumn fx:id="colHeureFin" text="H. Fin" prefWidth="70"/>
                                </columns>
                            </TableView>

                            <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
                                <GridPane hgap="15" vgap="12">
                                    <columnConstraints>
                                        <ColumnConstraints minWidth="100" />
                                        <ColumnConstraints hgrow="ALWAYS" />
                                        <ColumnConstraints minWidth="100" />
                                        <ColumnConstraints hgrow="ALWAYS" />
                                    </columnConstraints>
                                    
                                    <Label text="Titre:"/>
                                    <TextField fx:id="tfTitre" GridPane.columnIndex="1"/>
                                    
                                    <Label text="Type:" GridPane.columnIndex="2"/>
                                    <TextField fx:id="tfType" GridPane.columnIndex="3"/>
                                    
                                    <Label text="Description:" GridPane.rowIndex="1"/>
                                    <TextField fx:id="tfDesc" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                                    
                                    <Label text="Lieu:" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                                    <HBox spacing="5" GridPane.columnIndex="3" GridPane.rowIndex="1">
                                        <TextField fx:id="tfLieu" HBox.hgrow="ALWAYS"/>
                                        <Button text="🔍" onAction="#handleSearchMap" style="-fx-cursor: hand;"/>
                                    </HBox>

                                    <Label text="Lien Webinaire:" GridPane.rowIndex="2"/>
                                    <TextField fx:id="tfLien" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                                    
                                    <Label text="Niveau:" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
                                    <TextField fx:id="tfNiveau" GridPane.columnIndex="3" GridPane.rowIndex="2"/>

                                    <Label text="Date:" GridPane.rowIndex="3"/>
                                    <DatePicker fx:id="dpDate" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                                    
                                    <Label text="Météo:" GridPane.columnIndex="2" GridPane.rowIndex="3"/>
                                    <Button text="Vérifier Météo" onAction="#handleCheckWeather" GridPane.columnIndex="3" GridPane.rowIndex="3" style="-fx-cursor: hand;"/>
                                </GridPane>

                                <HBox spacing="10" alignment="CENTER_LEFT">
                                    <Label text="Heure Début (HH:mm:ss):"/>
                                    <TextField fx:id="tfHeureDeb" prefWidth="100"/>
                                    <Label text="Heure Fin:"/>
                                    <TextField fx:id="tfHeureFin" prefWidth="100"/>
                                </HBox>

                                <TextField fx:id="tfId" visible="false" managed="false"/>
                                <TextField fx:id="tfImage" visible="false" managed="false"/>
                                <Label fx:id="lblError" textFill="RED" visible="false" managed="false"/>

                                <HBox spacing="10" alignment="CENTER_RIGHT">
                                    <Button text="👁 Voir détails" onAction="#handleViewDetail" style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 8 16; -fx-cursor: hand;"/>
                                    <Button text="Ajouter" onAction="#handleAdd" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 8 16; -fx-cursor: hand;"/>
                                    <Button text="Modifier" onAction="#handleUpdate" style="-fx-background-color: #f5a623; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 8 16; -fx-cursor: hand;"/>
                                    <Button text="Supprimer" onAction="#handleDelete" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 8 16; -fx-cursor: hand;"/>
                                    <Button text="Vider" onAction="#handleClear" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 8 16; -fx-cursor: hand;"/>
                                </HBox>
                            </VBox>

                            <HBox spacing="20">
                                <VBox fx:id="boxWeather" visible="false" managed="false" spacing="10" prefWidth="250" style="-fx-background-color: #ebf5fb; -fx-padding: 15; -fx-background-radius: 12;">
                                    <Label fx:id="lblWeatherCity" style="-fx-font-weight: bold;"/>
                                    <HBox alignment="CENTER_LEFT" spacing="10">
                                        <ImageView fx:id="ivWeatherIcon" fitHeight="40" fitWidth="40"/>
                                        <Label fx:id="lblWeatherTemp" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                                    </HBox>
                                    <Label fx:id="lblWeatherDesc"/>
                                    <Label fx:id="lblWeatherWarning" textFill="RED" wrapText="true" style="-fx-font-size: 11px;"/>
                                </VBox>
                                <ProgressIndicator fx:id="piWeather" visible="false" managed="false"/>
                                
                                <VBox HBox.hgrow="ALWAYS" minHeight="300" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 10;">
                                    <Label text="Carte interactive (cliquez pour définir le lieu)" style="-fx-font-weight: bold; -fx-padding: 0 0 10 0;"/>
                                    <WebView fx:id="mapWebView" VBox.vgrow="ALWAYS"/>
                                </VBox>
                            </HBox>
                        </VBox>
                    </ScrollPane>
                </Tab>

                <!-- Onglet 2 : Assistant AI -->
                <Tab text="🤖 Assistant AI">
                    <fx:include source="AIAssistant.fxml" />
                </Tab>

                <!-- Onglet 3 : Statistiques -->
                <Tab text="📊 Statistiques">
                    <fx:include source="Stats.fxml" />
                </Tab>

                <!-- Onglet 4 : Export PDF -->
                <Tab text="📄 Export PDF">
                    <fx:include source="ExportPDF.fxml" />
                </Tab>
            </tabs>
        </TabPane>
    </VBox>
</HBox>
