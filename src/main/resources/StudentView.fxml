<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.controllers.StudentController"
      spacing="0" prefWidth="1280" prefHeight="800"
      style="-fx-background-color: #f0f2f8;">

    <!-- ══ NAVBAR (matches AccueilEtudiant exactly) ══ -->
    <HBox alignment="CENTER_LEFT" spacing="0"
          style="-fx-background-color: #1a1f3c;
                 -fx-min-height: 62;
                 -fx-border-color: transparent transparent #f5a623 transparent;
                 -fx-border-width: 0 0 3 0;">
        <HBox alignment="CENTER_LEFT" spacing="14"
              style="-fx-padding: 0 28;" HBox.hgrow="ALWAYS">

            <HBox alignment="CENTER"
                  style="-fx-background-color: rgba(245,166,35,0.15);
                         -fx-background-radius: 10; -fx-padding: 7 11;">
                <Label text="📚" style="-fx-font-size: 18;"/>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="0">
                <Label text="edu"
                       style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: white;"/>
                <Label text="center"
                       style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #f5a623;"/>
            </HBox>

            <VBox style="-fx-background-color: #2d3561; -fx-min-width: 1; -fx-min-height: 24;"/>
            <Label text="Espace Étudiant"
                   style="-fx-font-size: 11; -fx-text-fill: #6c7a9c; -fx-font-style: italic;"/>

            <HBox HBox.hgrow="ALWAYS"/>

            <HBox spacing="4" alignment="CENTER">
                <Label text="ACCUEIL" onMouseClicked="#navigateToAccueil"
                       style="-fx-text-fill: #8892b0; -fx-font-size: 11;
                              -fx-font-weight: bold; -fx-cursor: hand;
                              -fx-padding: 7 14; -fx-background-radius: 8;"/>
                <Label text="COURS" onMouseClicked="#navigateToCours"
                       style="-fx-text-fill: #8892b0; -fx-font-size: 11;
                              -fx-font-weight: bold; -fx-cursor: hand;
                              -fx-padding: 7 14; -fx-background-radius: 8;"/>
                <Label text="CERTIFICATIONS" onMouseClicked="#navigateToCertifications"
                       style="-fx-text-fill: #8892b0; -fx-font-size: 11;
                              -fx-font-weight: bold; -fx-cursor: hand;
                              -fx-padding: 7 14; -fx-background-radius: 8;"/>
                <Label text="ÉVÉNEMENTS" onMouseClicked="#navigateToEvents"
                       style="-fx-text-fill: #8892b0; -fx-font-size: 11;
                              -fx-font-weight: bold; -fx-cursor: hand;
                              -fx-padding: 7 14; -fx-background-radius: 8;"/>
                <Label text="PROFILE"
                       style="-fx-background-color: rgba(245,166,35,0.12);
                              -fx-text-fill: #f5a623; -fx-font-size: 11;
                              -fx-font-weight: bold; -fx-background-radius: 8;
                              -fx-padding: 7 14;"/>
            </HBox>
        </HBox>
    </HBox>

    <!-- ══ HERO BANNER ══ -->
    <HBox alignment="CENTER_LEFT" spacing="0"
          style="-fx-background-color: #f5a623;
                 -fx-min-height: 88; -fx-padding: 0 32;">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label fx:id="heroNameLabel"
                   text="Mon Profil"
                   style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #1a1f3c;"/>
            <Label text="Gérez vos informations personnelles et suivez votre progression"
                   style="-fx-font-size: 13; -fx-text-fill: rgba(26,31,60,0.65);"/>
        </VBox>
    </HBox>

    <!-- ══ MAIN SCROLL AREA ══ -->
    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                VBox.vgrow="ALWAYS"
                style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
        <VBox spacing="0">

            <HBox spacing="30" style="-fx-padding: 40 60 40 60; -fx-background-color: #f0f2f8;"
                  alignment="TOP_LEFT">

                <!-- ════ LEFT COLUMN ════ -->
                <VBox spacing="30" HBox.hgrow="ALWAYS">

                    <!-- ── Informations Personnelles ── -->
                    <VBox spacing="14">
                        <Label text="Informations Personnelles"
                               style="-fx-font-family: 'Georgia'; -fx-font-size: 22px;
                                      -fx-font-weight: bold; -fx-text-fill: #1a1f3c;
                                      -fx-border-color: transparent transparent #f5a623 transparent;
                                      -fx-border-width: 0 0 3 0; -fx-padding: 0 0 8 0;"/>

                        <VBox style="-fx-background-color: white;
                                     -fx-border-color: #dee8ff;
                                     -fx-border-width: 0 0 0 4;
                                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 20, 0, 0, 4);">
                            <VBox style="-fx-padding: 28;">
                                <GridPane hgap="20" vgap="0">
                                    <columnConstraints>
                                        <ColumnConstraints percentWidth="50"/>
                                        <ColumnConstraints percentWidth="50"/>
                                    </columnConstraints>

                                    <VBox spacing="4" style="-fx-padding: 0 0 18 0;" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                        <Label text="Nom Complet"
                                               style="-fx-font-size: 11px; -fx-text-fill: #8a9bb5;
                                                      -fx-font-weight: bold; -fx-padding: 0 0 2 0;"/>
                                        <HBox style="-fx-border-color: #eef0f5; -fx-border-width: 0 0 1 0; -fx-padding: 0 0 8 0;">
                                            <Label fx:id="fullNameLabel" text="—"
                                                   style="-fx-font-size: 15px; -fx-text-fill: #1a1f3c; -fx-font-weight: bold;"/>
                                        </HBox>
                                    </VBox>

                                    <VBox spacing="4" style="-fx-padding: 0 0 18 0;" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                        <Label text="Adresse Email"
                                               style="-fx-font-size: 11px; -fx-text-fill: #8a9bb5;
                                                      -fx-font-weight: bold; -fx-padding: 0 0 2 0;"/>
                                        <HBox style="-fx-border-color: #eef0f5; -fx-border-width: 0 0 1 0; -fx-padding: 0 0 8 0;">
                                            <Label fx:id="emailLabel" text="—"
                                                   style="-fx-font-size: 15px; -fx-text-fill: #1a1f3c; -fx-font-weight: bold;"/>
                                        </HBox>
                                    </VBox>

                                    <VBox spacing="4" style="-fx-padding: 0 0 18 0;" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                        <Label text="Nom d'utilisateur"
                                               style="-fx-font-size: 11px; -fx-text-fill: #8a9bb5;
                                                      -fx-font-weight: bold; -fx-padding: 0 0 2 0;"/>
                                        <HBox style="-fx-border-color: #eef0f5; -fx-border-width: 0 0 1 0; -fx-padding: 0 0 8 0;">
                                            <Label fx:id="usernameLabel" text="—"
                                                   style="-fx-font-size: 15px; -fx-text-fill: #1a1f3c; -fx-font-weight: bold;"/>
                                        </HBox>
                                    </VBox>

                                    <VBox spacing="4" style="-fx-padding: 0 0 18 0;" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                        <Label text="Mot de passe"
                                               style="-fx-font-size: 11px; -fx-text-fill: #8a9bb5;
                                                      -fx-font-weight: bold; -fx-padding: 0 0 2 0;"/>
                                        <HBox style="-fx-border-color: #eef0f5; -fx-border-width: 0 0 1 0; -fx-padding: 0 0 8 0;">
                                            <Label text="••••••••"
                                                   style="-fx-font-size: 15px; -fx-text-fill: #1a1f3c; -fx-font-weight: bold;"/>
                                        </HBox>
                                    </VBox>

                                    <VBox spacing="4" style="-fx-padding: 0 0 6 0;" GridPane.columnIndex="0" GridPane.rowIndex="2">
                                        <Label text="Membre depuis"
                                               style="-fx-font-size: 11px; -fx-text-fill: #8a9bb5;
                                                      -fx-font-weight: bold; -fx-padding: 0 0 2 0;"/>
                                        <Label fx:id="inscriptionLabel" text="—"
                                               style="-fx-font-size: 15px; -fx-text-fill: #1a1f3c; -fx-font-weight: bold;"/>
                                    </VBox>

                                    <VBox spacing="4" style="-fx-padding: 0 0 6 0;" GridPane.columnIndex="1" GridPane.rowIndex="2">
                                        <Label text="Dernière connexion"
                                               style="-fx-font-size: 11px; -fx-text-fill: #8a9bb5;
                                                      -fx-font-weight: bold; -fx-padding: 0 0 2 0;"/>
                                        <Label fx:id="lastLoginLabel" text="—"
                                               style="-fx-font-size: 15px; -fx-text-fill: #1a1f3c; -fx-font-weight: bold;"/>
                                    </VBox>
                                </GridPane>

                                <Button fx:id="logoutBtn"
                                        text="⏻  Déconnexion"
                                        onAction="#logout"
                                        prefHeight="42"
                                        maxWidth="Infinity"
                                        style="-fx-background-color: transparent;
                                               -fx-border-color: #dc3545;
                                               -fx-border-width: 1.5;
                                               -fx-text-fill: #dc3545;
                                               -fx-font-weight: bold;
                                               -fx-font-size: 13px;
                                               -fx-background-radius: 0;
                                               -fx-border-radius: 0;
                                               -fx-cursor: hand;"/>
                            </VBox>
                        </VBox>
                    </VBox>

                    <!-- ── SECTION: Mes Cours (UPDATED) ── -->
                    <VBox spacing="14">
                        <Label text="Mes Cours"
                               style="-fx-font-family: 'Georgia'; -fx-font-size: 22px;
                                      -fx-font-weight: bold; -fx-text-fill: #1a1f3c;
                                      -fx-border-color: transparent transparent #f5a623 transparent;
                                      -fx-border-width: 0 0 3 0; -fx-padding: 0 0 8 0;"/>
                        <VBox fx:id="mesCoursContainer" spacing="0"
                              style="-fx-background-color: white;
                                     -fx-border-color: #dee8ff;
                                     -fx-border-width: 0 0 0 4;
                                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 20, 0, 0, 4);
                                     -fx-padding: 24;"/>
                        <HBox alignment="CENTER_LEFT">
                            <Button text="Parcourir tous les cours"
                                    onAction="#navigateToCours"
                                    style="-fx-background-color: transparent;
                                           -fx-border-color: #1a1f3c; -fx-border-width: 1.5;
                                           -fx-text-fill: #1a1f3c; -fx-font-size: 13px;
                                           -fx-background-radius: 0; -fx-border-radius: 0;
                                           -fx-cursor: hand; -fx-padding: 8 20 8 20;"/>
                        </HBox>
                    </VBox>

                    <!-- ── Performance aux Quiz ── -->
                    <VBox spacing="14">
                        <Label text="Performance aux Quiz"
                               style="-fx-font-family: 'Georgia'; -fx-font-size: 22px;
                                      -fx-font-weight: bold; -fx-text-fill: #1a1f3c;
                                      -fx-border-color: transparent transparent #f5a623 transparent;
                                      -fx-border-width: 0 0 3 0; -fx-padding: 0 0 8 0;"/>
                        <VBox style="-fx-background-color: white;
                                     -fx-border-color: #dee8ff;
                                     -fx-border-width: 0 0 0 4;
                                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 20, 0, 0, 4);
                                     -fx-padding: 24;">
                            <HBox spacing="0">
                                <VBox HBox.hgrow="ALWAYS" alignment="CENTER"
                                      style="-fx-background-color: #f7f9ff; -fx-padding: 20;
                                             -fx-border-color: #dee8ff; -fx-border-width: 0 1 0 0;">
                                    <Label text="0"
                                           style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #1a1f3c;"/>
                                    <Label text="Quiz Complétés"
                                           style="-fx-font-size: 12px; -fx-text-fill: #8a9bb5; -fx-padding: 4 0 0 0;"/>
                                </VBox>
                                <VBox HBox.hgrow="ALWAYS" alignment="CENTER"
                                      style="-fx-background-color: #f7f9ff; -fx-padding: 20;
                                             -fx-border-color: #dee8ff; -fx-border-width: 0 1 0 0;">
                                    <Label text="0%"
                                           style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #1a1f3c;"/>
                                    <Label text="Score Moyen"
                                           style="-fx-font-size: 12px; -fx-text-fill: #8a9bb5; -fx-padding: 4 0 0 0;"/>
                                </VBox>
                                <VBox HBox.hgrow="ALWAYS" alignment="CENTER"
                                      style="-fx-background-color: #f7f9ff; -fx-padding: 20;">
                                    <Label text="0"
                                           style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #1a1f3c;"/>
                                    <Label text="Badges Gagnés"
                                           style="-fx-font-size: 12px; -fx-text-fill: #8a9bb5; -fx-padding: 4 0 0 0;"/>
                                </VBox>
                            </HBox>
                            <Label text="Aucun quiz complété pour le moment."
                                   alignment="CENTER" maxWidth="Infinity"
                                   style="-fx-font-size: 13px; -fx-text-fill: #8a9bb5; -fx-padding: 18 0 0 0;"/>
                        </VBox>
                    </VBox>

                    <!-- ── Badges & Réalisations ── -->
                    <VBox spacing="14">
                        <Label text="Badges &amp; Réalisations"
                               style="-fx-font-family: 'Georgia'; -fx-font-size: 22px;
                                      -fx-font-weight: bold; -fx-text-fill: #1a1f3c;
                                      -fx-border-color: transparent transparent #f5a623 transparent;
                                      -fx-border-width: 0 0 3 0; -fx-padding: 0 0 8 0;"/>
                        <VBox alignment="CENTER" minHeight="130"
                              style="-fx-background-color: white;
                                     -fx-border-color: #dee8ff;
                                     -fx-border-width: 0 0 0 4;
                                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 20, 0, 0, 4);
                                     -fx-padding: 40;">
                            <Label text="🏅" style="-fx-font-size: 36px;"/>
                            <Label text="Aucun badge obtenu pour le moment."
                                   style="-fx-font-size: 14px; -fx-text-fill: #8a9bb5; -fx-padding: 12 0 0 0;"/>
                        </VBox>
                    </VBox>

                    <!-- ── Mes Donations ── -->
                    <VBox spacing="14">
                        <Label text="Mes Donations"
                               style="-fx-font-family: 'Georgia'; -fx-font-size: 22px;
                                      -fx-font-weight: bold; -fx-text-fill: #1a1f3c;
                                      -fx-border-color: transparent transparent #f5a623 transparent;
                                      -fx-border-width: 0 0 3 0; -fx-padding: 0 0 8 0;"/>
                        <VBox style="-fx-background-color: white;
                                     -fx-border-color: #dee8ff;
                                     -fx-border-width: 0 0 0 4;
                                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 20, 0, 0, 4);
                                     -fx-padding: 24;">
                            <HBox spacing="0">
                                <VBox HBox.hgrow="ALWAYS" alignment="CENTER"
                                      style="-fx-background-color: #f7f9ff; -fx-padding: 20;
                                             -fx-border-color: #dee8ff; -fx-border-width: 0 1 0 0;">
                                    <Label text="0€"
                                           style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #1a1f3c;"/>
                                    <Label text="Total Donné"
                                           style="-fx-font-size: 12px; -fx-text-fill: #8a9bb5; -fx-padding: 4 0 0 0;"/>
                                </VBox>
                                <VBox HBox.hgrow="ALWAYS" alignment="CENTER"
                                      style="-fx-background-color: #f7f9ff; -fx-padding: 20;
                                             -fx-border-color: #dee8ff; -fx-border-width: 0 1 0 0;">
                                    <Label text="Débutant"
                                           style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1a1f3c;"/>
                                    <Label text="Niveau Donateur"
                                           style="-fx-font-size: 12px; -fx-text-fill: #8a9bb5; -fx-padding: 4 0 0 0;"/>
                                </VBox>
                                <VBox HBox.hgrow="ALWAYS" alignment="CENTER"
                                      style="-fx-background-color: #f7f9ff; -fx-padding: 20;">
                                    <Label text="0"
                                           style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #1a1f3c;"/>
                                    <Label text="Badges de Donation"
                                           style="-fx-font-size: 12px; -fx-text-fill: #8a9bb5; -fx-padding: 4 0 0 0;"/>
                                </VBox>
                            </HBox>
                            <Label text="Vous n'avez pas encore fait de donations."
                                   alignment="CENTER" maxWidth="Infinity"
                                   style="-fx-font-size: 13px; -fx-text-fill: #8a9bb5; -fx-padding: 16 0 8 0;"/>
                            <HBox alignment="CENTER">
                                <Button text="Faire une Donation"
                                        style="-fx-background-color: #1a1f3c;
                                               -fx-text-fill: white; -fx-font-weight: bold;
                                               -fx-font-size: 13px; -fx-background-radius: 0;
                                               -fx-padding: 10 24 10 24; -fx-cursor: hand;"/>
                            </HBox>
                        </VBox>
                    </VBox>

                    <!-- ── Danger Zone ── -->
                    <VBox style="-fx-background-color: #fff5f5;
                                 -fx-border-color: #ffcccc; -fx-border-width: 1;
                                 -fx-padding: 24;
                                 -fx-effect: dropshadow(gaussian, rgba(220,53,69,0.1), 16, 0, 0, 3);">
                        <Label text="⚠  Zone Dangereuse"
                               style="-fx-font-size: 16px; -fx-font-weight: bold;
                                      -fx-text-fill: #dc3545; -fx-padding: 0 0 8 0;"/>
                        <Label text="La suppression de votre compte est permanente et irréversible. Toutes vos données, cours, badges et progression seront définitivement supprimés."
                               wrapText="true"
                               style="-fx-font-size: 13px; -fx-text-fill: #555; -fx-padding: 0 0 16 0;"/>
                        <Button text="🗑  Supprimer Mon Compte"
                                onAction="#deleteAccount"
                                style="-fx-background-color: #dc3545;
                                       -fx-text-fill: white; -fx-font-weight: bold;
                                       -fx-font-size: 13px; -fx-background-radius: 0;
                                       -fx-padding: 10 20 10 20; -fx-cursor: hand;"/>
                    </VBox>

                </VBox>
                <!-- end left column -->

                <!-- ════ RIGHT COLUMN ════ -->
                <VBox spacing="20" prefWidth="280" minWidth="260">

                    <!-- ── Avatar Card ── -->
                    <VBox alignment="CENTER" spacing="10"
                          style="-fx-background-color: white;
                                 -fx-border-color: #dee8ff;
                                 -fx-border-width: 0 0 0 4;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 20, 0, 0, 4);
                                 -fx-padding: 30 20 30 20;">
                        <StackPane prefWidth="88" prefHeight="88" maxWidth="88" maxHeight="88">
                            <Region prefWidth="88" prefHeight="88"
                                    style="-fx-background-color: #1a1f3c; -fx-background-radius: 44;"/>
                            <Label fx:id="avatarInitialsLabel" text="??"
                                   style="-fx-font-family: 'Georgia'; -fx-font-size: 26px;
                                          -fx-font-weight: bold; -fx-text-fill: #f5a623;"/>
                        </StackPane>
                        <Label fx:id="sidebarNameLabel" text="—"
                               style="-fx-font-weight: bold; -fx-font-size: 16px;
                                      -fx-text-fill: #1a1f3c; -fx-padding: 6 0 0 0;"/>
                        <Label fx:id="sidebarEmailLabel" text="—"
                               style="-fx-font-size: 12px; -fx-text-fill: #8a9bb5;"/>
                        <HBox alignment="CENTER"
                              style="-fx-background-color: #e8f5e9; -fx-padding: 4 12 4 12;">
                            <Label text="● Étudiant"
                                   style="-fx-font-size: 11px; -fx-text-fill: #2e7d32; -fx-font-weight: bold;"/>
                        </HBox>
                    </VBox>

                    <!-- ── Statistiques Rapides (UPDATED) ── -->
                    <VBox style="-fx-background-color: white;
                                 -fx-border-color: #dee8ff;
                                 -fx-border-width: 0 0 0 4;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 20, 0, 0, 4);
                                 -fx-padding: 24;">
                        <Label text="Statistiques Rapides"
                               style="-fx-font-size: 15px; -fx-font-weight: bold;
                                      -fx-text-fill: #1a1f3c; -fx-padding: 0 0 16 0;"/>
                        <VBox spacing="10">
                            <HBox style="-fx-background-color: #f7f9ff; -fx-padding: 14 16 14 16;"
                                  alignment="CENTER_LEFT" spacing="12">
                                <Label text="📖" style="-fx-font-size: 18px;"/>
                                <VBox>
                                    <Label fx:id="coursInscritsLabel" text="0"
                                           style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1a1f3c;"/>
                                    <Label text="Cours Inscrits"
                                           style="-fx-font-size: 11px; -fx-text-fill: #8a9bb5;"/>
                                </VBox>
                            </HBox>
                            <HBox style="-fx-background-color: #f7f9ff; -fx-padding: 14 16 14 16;"
                                  alignment="CENTER_LEFT" spacing="12">
                                <Label text="✅" style="-fx-font-size: 18px;"/>
                                <VBox>
                                    <Label text="0"
                                           style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1a1f3c;"/>
                                    <Label text="Cours Complétés"
                                           style="-fx-font-size: 11px; -fx-text-fill: #8a9bb5;"/>
                                </VBox>
                            </HBox>
                            <HBox style="-fx-background-color: #f7f9ff; -fx-padding: 14 16 14 16;"
                                  alignment="CENTER_LEFT" spacing="12">
                                <Label text="🔥" style="-fx-font-size: 18px;"/>
                                <VBox>
                                    <Label text="0"
                                           style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1a1f3c;"/>
                                    <Label text="Jours de Série"
                                           style="-fx-font-size: 11px; -fx-text-fill: #8a9bb5;"/>
                                </VBox>
                            </HBox>
                            <HBox style="-fx-background-color: #f7f9ff; -fx-padding: 14 16 14 16;"
                                  alignment="CENTER_LEFT" spacing="12">
                                <Label text="📊" style="-fx-font-size: 18px;"/>
                                <VBox>
                                    <Label text="0%"
                                           style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1a1f3c;"/>
                                    <Label text="Taux de Complétion"
                                           style="-fx-font-size: 11px; -fx-text-fill: #8a9bb5;"/>
                                </VBox>
                            </HBox>
                        </VBox>
                    </VBox>

                    <!-- ── Calendrier des Certifications ── -->
                    <VBox style="-fx-background-color: white;
                                 -fx-border-color: #dee8ff;
                                 -fx-border-width: 0 0 0 4;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 20, 0, 0, 4);
                                 -fx-padding: 24;">
                        <Label text="Calendrier des Certifications"
                               style="-fx-font-size: 15px; -fx-font-weight: bold;
                                      -fx-text-fill: #1a1f3c; -fx-padding: 0 0 14 0;"/>
                        <VBox fx:id="calendarContainer" spacing="0"/>
                    </VBox>

                </VBox>
                <!-- end right column -->

            </HBox>

            <!-- ── FOOTER ── -->
            <VBox style="-fx-background-color: #1a1f3c; -fx-padding: 40 60 20 60;" spacing="24">
                <HBox spacing="60">
                    <VBox spacing="10" HBox.hgrow="ALWAYS">
