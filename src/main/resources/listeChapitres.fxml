<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.control.cell.PropertyValueFactory?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.controllers.ListeChapitresController"
      spacing="0"
      style="-fx-background-color: #f4f6f8;">

    <!-- NAVBAR -->
    <HBox prefHeight="60">
        <HBox prefWidth="260" prefHeight="60" alignment="CENTER"
              style="-fx-background-color: #1a1a2e;">
            <Label text="Edu"
                   style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
            <Label text="verse"
                   style="-fx-text-fill: #f5a623; -fx-font-size: 18px; -fx-font-weight: bold;"/>
        </HBox>
        <HBox HBox.hgrow="ALWAYS" prefHeight="60" alignment="CENTER" spacing="24"
              style="-fx-background-color: #f5a623;">
            <Label text="ACCUEIL"    style="-fx-font-size: 11px; -fx-font-weight: bold;"/>
            <Label text="À PROPOS"   style="-fx-font-size: 11px; -fx-font-weight: bold;"/>
            <Label text="BOURSES"    style="-fx-font-size: 11px; -fx-font-weight: bold;"/>
            <Label text="COURS"      style="-fx-font-size: 11px; -fx-font-weight: bold;"/>
            <Label text="ÉVÉNEMENTS" style="-fx-font-size: 11px; -fx-font-weight: bold;"/>
            <Label text="FORUM"      style="-fx-font-size: 11px; -fx-font-weight: bold;"/>
            <Label text="CONTACT"    style="-fx-font-size: 11px; -fx-font-weight: bold;"/>

        </HBox>
    </HBox>

    <!-- HEADER -->
    <HBox alignment="CENTER_LEFT"
          style="-fx-background-color: white; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 1 0;"
          minHeight="80">
        <padding><Insets top="16" right="32" bottom="16" left="32"/></padding>

        <VBox HBox.hgrow="ALWAYS">
            <Label fx:id="titreCours"
                   text="Chapitres du cours"
                   style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
            <Label text="Gérez les chapitres de votre cours"
                   style="-fx-font-size: 13px; -fx-text-fill: #888;"/>
        </VBox>

        <Button text="Retour Aux Cours"
                onAction="#retour"
                style="-fx-background-color: transparent;
                       -fx-border-color: #f5a623;
                       -fx-border-radius: 6;
                       -fx-text-fill: #f5a623;
                       -fx-font-size: 13px;
                       -fx-cursor: hand;
                       -fx-padding: 8 18;"/>
    </HBox>

    <!-- BOUTON AJOUTER -->
    <HBox style="-fx-background-color: white; -fx-border-color: #e8e8e8; -fx-border-width: 0 0 1 0;">
        <padding><Insets top="16" right="32" bottom="16" left="32"/></padding>
        <Button text="Ajouter Un Chapitre"
                onAction="#ajouterChapitre"
                style="-fx-background-color: #f5a623;
                       -fx-text-fill: white;
                       -fx-font-size: 13px;
                       -fx-font-weight: bold;
                       -fx-background-radius: 8;
                       -fx-cursor: hand;
                       -fx-padding: 10 22;"/>
    </HBox>

    <!-- TABLE -->
    <VBox VBox.vgrow="ALWAYS" style="-fx-background-color: #f4f6f8;">
        <padding><Insets top="24" right="32" bottom="24" left="32"/></padding>

        <TableView fx:id="tableChapitres"
                   VBox.vgrow="ALWAYS"
                   style="-fx-background-color: white;
                          -fx-background-radius: 10;
                          -fx-border-color: #e8e8e8;
                          -fx-border-radius: 10;
                          -fx-border-width: 1;">

            <columns>
                <TableColumn text="Id" prefWidth="60">
                    <cellValueFactory>
                        <PropertyValueFactory property="id"/>
                    </cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="colTitre"  text="Titre"       prefWidth="170"/>
                <TableColumn fx:id="colDesc"   text="Description" prefWidth="290"/>
                <TableColumn fx:id="colOrdre"  text="Ordre"       prefWidth="70"/>
                <TableColumn fx:id="colDuree"  text="Durée"       prefWidth="100"/>
                <TableColumn fx:id="colStatut" text="Statut"      prefWidth="120"/>
                <TableColumn fx:id="colType"   text="Type"        prefWidth="90"/>
                <TableColumn fx:id="colActions" text="Actions"    prefWidth="180"/>
            </columns>

            <placeholder>
                <Label text="Aucun chapitre trouvé."
                       style="-fx-text-fill: #aaa; -fx-font-size: 14px;"/>
            </placeholder>

            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>

        </TableView>
    </VBox>

</VBox>