<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: #f4f4f4;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.demandes.ListeDemandesController">
   <children>
      <Label layoutX="320.0" layoutY="24.0" text="Gestion des Demandes" textFill="#2c3e50">
         <font>
            <Font name="System Bold" size="26.0" />
         </font>
      </Label>

      <!-- Barre de navigation -->
      <HBox layoutX="50.0" layoutY="70.0" prefHeight="30.0" prefWidth="800.0" spacing="10.0">
         <children>
            <Button fx:id="btnRetour" mnemonicParsing="false" onAction="#retourBourses" prefHeight="30.0" prefWidth="150.0" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-background-radius: 15; -fx-cursor: hand;" text="Retour Bourses" />
         </children>
      </HBox>

      <!-- Barre de recherche avancee : champ texte + filtre statut + filtre niveau -->
      <HBox layoutX="50.0" layoutY="110.0" prefHeight="30.0" prefWidth="800.0" spacing="10.0" alignment="CENTER_LEFT">
         <children>
            <!-- Recherche par texte libre (titre bourse) -->
            <TextField fx:id="tfRecherche" prefHeight="30.0" prefWidth="250.0" promptText="Rechercher par titre de bourse..." style="-fx-background-radius: 15;" />
            <!-- Filtre par statut de la demande -->
            <ComboBox fx:id="cbStatut" prefHeight="30.0" prefWidth="180.0" promptText="Filtrer par statut" style="-fx-background-radius: 15;" />
            <!-- Filtre par niveau d'etudes -->
            <ComboBox fx:id="cbNiveau" prefHeight="30.0" prefWidth="180.0" promptText="Filtrer par niveau" style="-fx-background-radius: 15;" />
            <!-- Bouton pour reinitialiser tous les filtres -->
            <Button mnemonicParsing="false" onAction="#reinitialiserFiltres" prefHeight="30.0" prefWidth="130.0" style="-fx-background-color: #e67e22; -fx-text-fill: white; -fx-background-radius: 15; -fx-cursor: hand;" text="Reinitialiser" />
         </children>
      </HBox>

      <TableView fx:id="tableView" layoutX="50.0" layoutY="155.0" prefHeight="400.0" prefWidth="800.0" style="-fx-background-color: white; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">
        <columns>
          <TableColumn fx:id="colNiveau" prefWidth="200.0" text="Niveau Etudes" />
          <TableColumn fx:id="colStatut" prefWidth="200.0" text="Statut" />
          <TableColumn fx:id="colDate" prefWidth="250.0" text="Date Demande" />
          <TableColumn fx:id="colBourseTitre" prefWidth="150.0" text="Bourse" />
        </columns>
      </TableView>

   </children>
</AnchorPane>
