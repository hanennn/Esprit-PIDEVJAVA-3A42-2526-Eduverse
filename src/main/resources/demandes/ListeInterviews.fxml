<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.demandes.ListeInterviewsController"
      prefHeight="780.0" prefWidth="1280.0"
      spacing="0" style="-fx-background-color: #f4f6f8;">

    <!-- SIDEBAR -->
    <VBox minWidth="230" maxWidth="230"
          style="-fx-background-color: #1a1a2e; -fx-min-height: 780;">
        <VBox alignment="CENTER" prefHeight="80"
              style="-fx-border-color: rgba(255,255,255,0.08); -fx-border-width: 0 0 1 0; -fx-padding: 0 20;">
            <HBox alignment="CENTER" spacing="0">
                <Label text="Edu"   style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                <Label text="verse" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #f5a623;"/>
            </HBox>
            <Label text="Espace Admin" style="-fx-font-size: 11px; -fx-text-fill: rgba(255,255,255,0.35);"/>
        </VBox>
        <Label text="NAVIGATION" style="-fx-font-size: 10px; -fx-text-fill: rgba(255,255,255,0.25); -fx-font-weight: bold; -fx-padding: 22 20 8 20;"/>
        <VBox spacing="2" style="-fx-padding: 0 10;" VBox.vgrow="ALWAYS">
            <Button text="📊  Tableau de Bord" maxWidth="Infinity" mnemonicParsing="false"
                    style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.5); -fx-font-size: 13px; -fx-background-radius: 8; -fx-padding: 11 14; -fx-alignment: CENTER_LEFT;"/>
            <Button text="👥  Utilisateurs" maxWidth="Infinity" mnemonicParsing="false"
                    style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.5); -fx-font-size: 13px; -fx-background-radius: 8; -fx-padding: 11 14; -fx-alignment: CENTER_LEFT;"/>
            <Button text="📚  Cours" maxWidth="Infinity" mnemonicParsing="false"
                    style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.5); -fx-font-size: 13px; -fx-background-radius: 8; -fx-padding: 11 14; -fx-alignment: CENTER_LEFT;"/>
            <Button text="🎯  Quiz" maxWidth="Infinity" mnemonicParsing="false"
                    style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.5); -fx-font-size: 13px; -fx-background-radius: 8; -fx-padding: 11 14; -fx-alignment: CENTER_LEFT;"/>
            <Label text="GESTION DES BOURSES" style="-fx-font-size: 9px; -fx-text-fill: rgba(255,255,255,0.2); -fx-font-weight: bold; -fx-padding: 14 14 4 14;"/>
            <Button text="🎓  Bourses" maxWidth="Infinity" mnemonicParsing="false" onAction="#allerBourses"
                    style="-fx-background-color: rgba(255,255,255,0.05); -fx-text-fill: rgba(255,255,255,0.6); -fx-font-size: 13px; -fx-background-radius: 8; -fx-padding: 11 14; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;"/>
            <Button text="📋  Demandes" maxWidth="Infinity" mnemonicParsing="false" onAction="#allerDemandes"
                    style="-fx-background-color: rgba(255,255,255,0.05); -fx-text-fill: rgba(255,255,255,0.6); -fx-font-size: 12px; -fx-background-radius: 8; -fx-padding: 9 14 9 28; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;"/>
            <Button text="📈  Statistiques" maxWidth="Infinity" mnemonicParsing="false" onAction="#allerStatistiques"
                    style="-fx-background-color: rgba(255,255,255,0.05); -fx-text-fill: rgba(255,255,255,0.6); -fx-font-size: 12px; -fx-background-radius: 8; -fx-padding: 9 14 9 28; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;"/>
            <Button text="🤖  Interview IA" maxWidth="Infinity" mnemonicParsing="false"
                    style="-fx-background-color: #f5a623; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 12px; -fx-background-radius: 8; -fx-padding: 9 14 9 28; -fx-alignment: CENTER_LEFT;"/>
            <Label text="" style="-fx-padding: 6 0 0 0;"/>
            <Button text="📅  Evenements" maxWidth="Infinity" mnemonicParsing="false"
                    style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.5); -fx-font-size: 13px; -fx-background-radius: 8; -fx-padding: 11 14; -fx-alignment: CENTER_LEFT;"/>
            <Button text="💬  Forum" maxWidth="Infinity" mnemonicParsing="false"
                    style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.5); -fx-font-size: 13px; -fx-background-radius: 8; -fx-padding: 11 14; -fx-alignment: CENTER_LEFT;"/>
        </VBox>
        <Label text="COMPTE" style="-fx-font-size: 10px; -fx-text-fill: rgba(255,255,255,0.25); -fx-font-weight: bold; -fx-padding: 10 20 8 20;"/>
        <VBox style="-fx-padding: 0 10 20 10;">
            <Button text="⏻  Deconnexion" onAction="#allerAccueil" maxWidth="Infinity" prefHeight="38" mnemonicParsing="false"
                    style="-fx-background-color: transparent; -fx-text-fill: #e74c3c; -fx-border-color: rgba(231,76,60,0.3); -fx-border-width: 1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 12px; -fx-cursor: hand;"/>
        </VBox>
    </VBox>

    <!-- MAIN CONTENT -->
    <ScrollPane fitToWidth="true" HBox.hgrow="ALWAYS"
                style="-fx-background-color: #f4f6f8; -fx-background: #f4f6f8; -fx-border-color: transparent;">
        <VBox spacing="22" style="-fx-background-color: #f4f6f8;">
            <padding><Insets top="30" right="36" bottom="36" left="36"/></padding>

            <VBox>
                <Label text="Resultats des Interviews IA"
                       style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                <Label text="Consultez les analyses IA de toutes les interviews"
                       style="-fx-font-size: 13px; -fx-text-fill: #999; -fx-padding: 2 0 0 0;"/>
            </VBox>

            <!-- Tableau -->
            <VBox spacing="14"
                  style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 22;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 2);">
                <Label text="Liste des interviews"
                       style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                <Label text="Cliquez sur une ligne pour voir le detail"
                       style="-fx-font-size: 12px; -fx-text-fill: #aaa;"/>

                <TableView fx:id="tableView" minHeight="200" maxHeight="250"
                           style="-fx-background-color: transparent; -fx-border-color: transparent;">
                    <columns>
                        <TableColumn fx:id="colId" prefWidth="60" text="#"/>
                        <TableColumn fx:id="colDemande" prefWidth="280" text="Bourse"/>
                        <TableColumn fx:id="colProfil" prefWidth="300" text="Profil"/>
                        <TableColumn fx:id="colDate" prefWidth="180" text="Date analyse"/>
                    </columns>
                    <placeholder>
                        <Label text="Aucune interview realisee." style="-fx-text-fill: #bbb; -fx-font-size: 13px;"/>
                    </placeholder>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
            </VBox>

            <!-- Detail -->
            <VBox fx:id="vboxDetail" spacing="16">
                <Label fx:id="lblBourseTitre" text=""
                       style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #f5a623;"/>

                <HBox spacing="16">
                    <VBox HBox.hgrow="ALWAYS" spacing="8"
                          style="-fx-background-color: linear-gradient(to bottom right, #4facfe, #00f2fe);
                                 -fx-background-radius: 14; -fx-padding: 22;">
                        <Label text="PROFIL GLOBAL" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: rgba(255,255,255,0.8);"/>
                        <Label fx:id="lblProfil" text="-" wrapText="true"
                               style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                    </VBox>
                    <VBox HBox.hgrow="ALWAYS" spacing="8"
                          style="-fx-background-color: linear-gradient(to bottom right, #43e97b, #38f9d7);
                                 -fx-background-radius: 14; -fx-padding: 22;">
                        <Label text="RECOMMANDATION" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: rgba(255,255,255,0.8);"/>
                        <Label fx:id="lblRecommandation" text="-" wrapText="true"
                               style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                    </VBox>
                </HBox>

                <HBox spacing="16">
                    <VBox spacing="10" prefWidth="280"
                          style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 20;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 2);">
                        <Label text="Emotions" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                        <VBox fx:id="vboxEmotions" spacing="6"/>
                    </VBox>
                    <VBox spacing="10" prefWidth="200"
                          style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 20;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 2);">
                        <Label text="Analyse Audio" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                        <HBox spacing="6"><Label text="Debit :" style="-fx-font-weight: bold; -fx-text-fill: #555;"/><Label fx:id="lblDebit" text="-"/></HBox>
                        <HBox spacing="6"><Label text="Hesitations :" style="-fx-font-weight: bold; -fx-text-fill: #555;"/><Label fx:id="lblHesitations" text="-"/></HBox>
                        <HBox spacing="6"><Label text="Energie :" style="-fx-font-weight: bold; -fx-text-fill: #555;"/><Label fx:id="lblEnergie" text="-"/></HBox>
                        <HBox spacing="6"><Label text="Duree :" style="-fx-font-weight: bold; -fx-text-fill: #555;"/><Label fx:id="lblDuree" text="-"/></HBox>
                    </VBox>
                    <VBox HBox.hgrow="ALWAYS" spacing="10"
                          style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 20;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 2);">
                        <Label text="Transcription" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                        <Label fx:id="lblTranscription" text="-" wrapText="true"
                               style="-fx-font-size: 12px; -fx-text-fill: #444; -fx-line-spacing: 3;"/>
                    </VBox>
                </HBox>
            </VBox>

        </VBox>
    </ScrollPane>
</HBox>
