<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.demandes.InterviewIAController"
      prefHeight="780.0" prefWidth="1280.0"
      spacing="0" style="-fx-background-color: #f4f6f8;">

    <!-- ══════ SIDEBAR ══════ -->
    <VBox minWidth="230" maxWidth="230"
          style="-fx-background-color: #1a1a2e; -fx-min-height: 780;">
        <VBox alignment="CENTER" prefHeight="80"
              style="-fx-border-color: rgba(255,255,255,0.08); -fx-border-width: 0 0 1 0; -fx-padding: 0 20;">
            <HBox alignment="CENTER" spacing="0">
                <Label text="Edu"   style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                <Label text="verse" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #f5a623;"/>
            </HBox>
            <Label text="Espace Admin" style="-fx-font-size: 11px; -fx-text-fill: rgba(255,255,255,0.35);"/>
        </VBox>
        <Label text="NAVIGATION" style="-fx-font-size: 10px; -fx-text-fill: rgba(255,255,255,0.25); -fx-font-weight: bold; -fx-padding: 22 20 8 20;"/>
        <VBox spacing="2" style="-fx-padding: 0 10;" VBox.vgrow="ALWAYS">
            <Button text="📊  Tableau de Bord" maxWidth="Infinity" mnemonicParsing="false"
                    style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.5); -fx-font-size: 13px; -fx-background-radius: 8; -fx-padding: 11 14; -fx-alignment: CENTER_LEFT;"/>
            <Button text="👥  Utilisateurs" maxWidth="Infinity" mnemonicParsing="false"
                    style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.5); -fx-font-size: 13px; -fx-background-radius: 8; -fx-padding: 11 14; -fx-alignment: CENTER_LEFT;"/>
            <Button text="📚  Cours" maxWidth="Infinity" mnemonicParsing="false"
                    style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.5); -fx-font-size: 13px; -fx-background-radius: 8; -fx-padding: 11 14; -fx-alignment: CENTER_LEFT;"/>
            <Button text="🎯  Quiz" maxWidth="Infinity" mnemonicParsing="false"
                    style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.5); -fx-font-size: 13px; -fx-background-radius: 8; -fx-padding: 11 14; -fx-alignment: CENTER_LEFT;"/>
            <Label text="GESTION DES BOURSES" style="-fx-font-size: 9px; -fx-text-fill: rgba(255,255,255,0.2); -fx-font-weight: bold; -fx-padding: 14 14 4 14;"/>
            <Button text="🎓  Bourses" maxWidth="Infinity" mnemonicParsing="false" onAction="#allerBourses"
                    style="-fx-background-color: rgba(255,255,255,0.05); -fx-text-fill: rgba(255,255,255,0.6); -fx-font-size: 13px; -fx-background-radius: 8; -fx-padding: 11 14; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;"/>
            <Button text="📋  Demandes" maxWidth="Infinity" mnemonicParsing="false" onAction="#allerDemandes"
                    style="-fx-background-color: rgba(255,255,255,0.05); -fx-text-fill: rgba(255,255,255,0.6); -fx-font-size: 12px; -fx-background-radius: 8; -fx-padding: 9 14 9 28; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;"/>
            <Button text="🤖  Interview IA" maxWidth="Infinity" mnemonicParsing="false"
                    style="-fx-background-color: #f5a623; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 12px; -fx-background-radius: 8; -fx-padding: 9 14 9 28; -fx-alignment: CENTER_LEFT;"/>
            <Button text="📈  Statistiques" maxWidth="Infinity" mnemonicParsing="false" onAction="#allerStatistiques"
                    style="-fx-background-color: rgba(255,255,255,0.05); -fx-text-fill: rgba(255,255,255,0.6); -fx-font-size: 12px; -fx-background-radius: 8; -fx-padding: 9 14 9 28; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;"/>
            <Label text="" style="-fx-padding: 6 0 0 0;"/>
            <Button text="📅  Evenements" maxWidth="Infinity" mnemonicParsing="false"
                    style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.5); -fx-font-size: 13px; -fx-background-radius: 8; -fx-padding: 11 14; -fx-alignment: CENTER_LEFT;"/>
            <Button text="💬  Forum" maxWidth="Infinity" mnemonicParsing="false"
                    style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.5); -fx-font-size: 13px; -fx-background-radius: 8; -fx-padding: 11 14; -fx-alignment: CENTER_LEFT;"/>
        </VBox>
        <Label text="COMPTE" style="-fx-font-size: 10px; -fx-text-fill: rgba(255,255,255,0.25); -fx-font-weight: bold; -fx-padding: 10 20 8 20;"/>
        <VBox style="-fx-padding: 0 10 20 10;">
            <Button text="⏻  Deconnexion" onAction="#allerAccueil" maxWidth="Infinity" prefHeight="38" mnemonicParsing="false"
                    style="-fx-background-color: transparent; -fx-text-fill: #e74c3c; -fx-border-color: rgba(231,76,60,0.3); -fx-border-width: 1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 12px; -fx-cursor: hand;"/>
        </VBox>
    </VBox>

    <!-- ══════ MAIN CONTENT ══════ -->
    <VBox HBox.hgrow="ALWAYS" spacing="0">
        <!-- Breadcrumb -->
        <HBox style="-fx-background-color: linear-gradient(to right, #f5a623, #f7b731); -fx-padding: 10 36;"
              alignment="CENTER_LEFT" spacing="10">
            <Label text="🏠 Accueil  ›  Demandes  ›  Interview IA"
                   style="-fx-text-fill: #1a1a2e; -fx-font-weight: bold; -fx-font-size: 12px;"/>
            <HBox HBox.hgrow="ALWAYS"/>
            <Button text="⬅ Retour au detail" onAction="#retourDetail" mnemonicParsing="false"
                    style="-fx-background-color: #1a1a2e; -fx-text-fill: white; -fx-font-weight: bold;
                           -fx-background-radius: 8; -fx-padding: 6 16; -fx-cursor: hand; -fx-font-size: 11px;"/>
        </HBox>

        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                    style="-fx-background-color: #f4f6f8; -fx-background: #f4f6f8; -fx-border-color: transparent;">
            <VBox spacing="22" style="-fx-background-color: #f4f6f8;">
                <padding><Insets top="28" right="36" bottom="36" left="36"/></padding>

                <!-- Header -->
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <VBox HBox.hgrow="ALWAYS">
                        <Label fx:id="lblTitreDemande" text="Interview IA"
                               style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                        <Label text="Enregistrez l'interview vocale et analysez avec l'IA"
                               style="-fx-font-size: 13px; -fx-text-fill: #999;"/>
                    </VBox>
                    <Label fx:id="lblStatut" text="Pret a enregistrer"
                           style="-fx-font-size: 13px; -fx-text-fill: #888; -fx-font-weight: bold;"/>
                </HBox>

                <!-- Enregistrement -->
                <VBox spacing="18" alignment="CENTER"
                      style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 30;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 2);">

                    <Label text="🎤  Enregistrement Vocal"
                           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                    <Region prefHeight="2" style="-fx-background-color: linear-gradient(to right, #f5a623, #f7b731); -fx-background-radius: 2;" maxWidth="300"/>

                    <Label text="Parlez clairement pendant au moins 30 secondes"
                           style="-fx-font-size: 13px; -fx-text-fill: #888;"/>

                    <!-- Timer -->
                    <Label fx:id="lblTimer" text="00:00"
                           style="-fx-font-size: 42px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>

                    <!-- Boutons -->
                    <HBox spacing="14" alignment="CENTER">
                        <Button fx:id="btnEnregistrer" text="🎙️  Commencer l'enregistrement"
                                onAction="#demarrerEnregistrement" mnemonicParsing="false"
                                style="-fx-background-color: linear-gradient(to right, #2ecc71, #27ae60); -fx-text-fill: white;
                                       -fx-font-weight: bold; -fx-font-size: 14px; -fx-background-radius: 10;
                                       -fx-padding: 14 30; -fx-cursor: hand;"/>
                        <Button fx:id="btnArreter" text="⏹  Arreter"
                                onAction="#arreterEnregistrement" mnemonicParsing="false"
                                style="-fx-background-color: #e74c3c; -fx-text-fill: white;
                                       -fx-font-weight: bold; -fx-font-size: 14px; -fx-background-radius: 10;
                                       -fx-padding: 14 30; -fx-cursor: hand;"/>
                        <Button fx:id="btnAnalyser" text="🤖  Analyser avec l'IA"
                                onAction="#lancerAnalyse" mnemonicParsing="false"
                                style="-fx-background-color: linear-gradient(to right, #a855f7, #7c3aed); -fx-text-fill: white;
                                       -fx-font-weight: bold; -fx-font-size: 14px; -fx-background-radius: 10;
                                       -fx-padding: 14 30; -fx-cursor: hand;"/>
                    </HBox>

                    <!-- Progress -->
                    <ProgressBar fx:id="progressBar" prefWidth="400" prefHeight="12"
                                 style="-fx-accent: #f5a623;"/>
                    <Label fx:id="lblProgress" text=""
                           style="-fx-font-size: 12px; -fx-text-fill: #888;"/>
                </VBox>

                <!-- ══════ RESULTATS ══════ -->
                <VBox fx:id="vboxResultats" spacing="16">

                    <!-- Profil + Recommandation -->
                    <HBox spacing="16">
                        <VBox HBox.hgrow="ALWAYS" spacing="8"
                              style="-fx-background-color: linear-gradient(to bottom right, #4facfe, #00f2fe);
                                     -fx-background-radius: 14; -fx-padding: 22;">
                            <Label text="PROFIL GLOBAL" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: rgba(255,255,255,0.8);"/>
                            <Label fx:id="lblProfil" text="-" wrapText="true"
                                   style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                        </VBox>
                        <VBox HBox.hgrow="ALWAYS" spacing="8"
                              style="-fx-background-color: linear-gradient(to bottom right, #43e97b, #38f9d7);
                                     -fx-background-radius: 14; -fx-padding: 22;">
                            <Label text="RECOMMANDATION" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: rgba(255,255,255,0.8);"/>
                            <Label fx:id="lblRecommandation" text="-" wrapText="true"
                                   style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                        </VBox>
                    </HBox>

                    <!-- Emotions -->
                    <VBox spacing="12"
                          style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 22;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 2);">
                        <Label text="🎭  Scores d'Emotions"
                               style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                        <VBox fx:id="vboxEmotions" spacing="8"/>
                    </VBox>

                    <!-- Features Audio + Transcription -->
                    <HBox spacing="16">
                        <VBox spacing="12" prefWidth="300"
                              style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 22;
                                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 2);">
                            <Label text="🔊  Analyse Audio"
                                   style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                            <HBox spacing="8">
                                <Label text="Debit :" style="-fx-font-weight: bold; -fx-text-fill: #555; -fx-min-width: 100;"/>
                                <Label fx:id="lblDebit" text="-" style="-fx-text-fill: #333;"/>
                            </HBox>
                            <HBox spacing="8">
                                <Label text="Hesitations :" style="-fx-font-weight: bold; -fx-text-fill: #555; -fx-min-width: 100;"/>
                                <Label fx:id="lblHesitations" text="-" style="-fx-text-fill: #333;"/>
                            </HBox>
                            <HBox spacing="8">
                                <Label text="Energie :" style="-fx-font-weight: bold; -fx-text-fill: #555; -fx-min-width: 100;"/>
                                <Label fx:id="lblEnergie" text="-" style="-fx-text-fill: #333;"/>
                            </HBox>
                            <HBox spacing="8">
                                <Label text="Duree :" style="-fx-font-weight: bold; -fx-text-fill: #555; -fx-min-width: 100;"/>
                                <Label fx:id="lblDuree" text="-" style="-fx-text-fill: #333;"/>
                            </HBox>
                        </VBox>

                        <VBox HBox.hgrow="ALWAYS" spacing="12"
                              style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 22;
                                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 2);">
                            <Label text="📝  Transcription"
                                   style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                            <Label fx:id="lblTranscription" text="-" wrapText="true"
                                   style="-fx-font-size: 13px; -fx-text-fill: #444; -fx-line-spacing: 4;"/>
                        </VBox>
                    </HBox>
                </VBox>

            </VBox>
        </ScrollPane>
    </VBox>
</HBox>
