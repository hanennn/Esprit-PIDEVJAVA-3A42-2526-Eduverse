<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.etudiant.InterviewEtudiantController"
      prefHeight="780.0" prefWidth="1280.0"
      spacing="0" style="-fx-background-color: #f4f6f8;">

    <!-- SIDEBAR (identique aux autres pages etudiant) -->
    <VBox minWidth="230" maxWidth="230"
          style="-fx-background-color: #1a1a2e; -fx-min-height: 780;">
        <VBox alignment="CENTER" prefHeight="80"
              style="-fx-border-color: rgba(255,255,255,0.08); -fx-border-width: 0 0 1 0; -fx-padding: 0 20;">
            <HBox alignment="CENTER" spacing="0">
                <Label text="Edu"   style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                <Label text="verse" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #f5a623;"/>
            </HBox>
            <Label text="Espace Etudiant" style="-fx-font-size: 11px; -fx-text-fill: rgba(255,255,255,0.35);"/>
        </VBox>
        <Label text="NAVIGATION" style="-fx-font-size: 10px; -fx-text-fill: rgba(255,255,255,0.25); -fx-font-weight: bold; -fx-padding: 22 20 8 20;"/>
        <VBox spacing="2" style="-fx-padding: 0 10;" VBox.vgrow="ALWAYS">
            <Button text="📊  Tableau de Bord" maxWidth="Infinity" mnemonicParsing="false"
                    style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.5); -fx-font-size: 13px; -fx-background-radius: 8; -fx-padding: 11 14; -fx-alignment: CENTER_LEFT;"/>
            <Button text="📚  Cours" maxWidth="Infinity" mnemonicParsing="false"
                    style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.5); -fx-font-size: 13px; -fx-background-radius: 8; -fx-padding: 11 14; -fx-alignment: CENTER_LEFT;"/>
            <Button text="🎯  Quiz" maxWidth="Infinity" mnemonicParsing="false"
                    style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.5); -fx-font-size: 13px; -fx-background-radius: 8; -fx-padding: 11 14; -fx-alignment: CENTER_LEFT;"/>

            <Label text="BOURSES" style="-fx-font-size: 9px; -fx-text-fill: rgba(255,255,255,0.2); -fx-font-weight: bold; -fx-padding: 14 14 4 14;"/>
            <Button text="🎓  Bourses disponibles" maxWidth="Infinity" mnemonicParsing="false" onAction="#allerBourses"
                    style="-fx-background-color: rgba(255,255,255,0.05); -fx-text-fill: rgba(255,255,255,0.6); -fx-font-size: 13px; -fx-background-radius: 8; -fx-padding: 11 14; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;"/>
            <Button text="Calendrier" maxWidth="Infinity" mnemonicParsing="false" onAction="#allerCalendrier"
                    style="-fx-background-color: rgba(255,255,255,0.05); -fx-text-fill: rgba(255,255,255,0.6); -fx-font-size: 12px; -fx-background-radius: 8; -fx-padding: 9 14 9 28; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;"/>
            <Button text="Interview IA" maxWidth="Infinity" mnemonicParsing="false"
                    style="-fx-background-color: #f5a623; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 12px; -fx-background-radius: 8; -fx-padding: 9 14 9 28; -fx-alignment: CENTER_LEFT;"/>

            <Label text="" style="-fx-padding: 6 0 0 0;"/>
            <Button text="📅  Evenements" maxWidth="Infinity" mnemonicParsing="false"
                    style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.5); -fx-font-size: 13px; -fx-background-radius: 8; -fx-padding: 11 14; -fx-alignment: CENTER_LEFT;"/>
            <Button text="💬  Forum" maxWidth="Infinity" mnemonicParsing="false"
                    style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.5); -fx-font-size: 13px; -fx-background-radius: 8; -fx-padding: 11 14; -fx-alignment: CENTER_LEFT;"/>
        </VBox>
        <Label text="COMPTE" style="-fx-font-size: 10px; -fx-text-fill: rgba(255,255,255,0.25); -fx-font-weight: bold; -fx-padding: 10 20 8 20;"/>
        <VBox style="-fx-padding: 0 10 20 10;">
            <Button text="⏻  Deconnexion" onAction="#allerAccueil" maxWidth="Infinity" prefHeight="38" mnemonicParsing="false"
                    style="-fx-background-color: transparent; -fx-text-fill: #e74c3c; -fx-border-color: rgba(231,76,60,0.3); -fx-border-width: 1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 12px; -fx-cursor: hand;"/>
        </VBox>
    </VBox>

    <!-- MAIN CONTENT -->
    <ScrollPane fitToWidth="true" HBox.hgrow="ALWAYS"
                style="-fx-background-color: #f4f6f8; -fx-background: #f4f6f8; -fx-border-color: transparent;">
        <VBox spacing="22" style="-fx-background-color: #f4f6f8;">
            <padding><Insets top="30" right="36" bottom="36" left="36"/></padding>

            <VBox>
                <Label text="Interview IA"
                       style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                <Label text="Passez votre interview vocale pour les demandes acceptees"
                       style="-fx-font-size: 13px; -fx-text-fill: #999; -fx-padding: 2 0 0 0;"/>
            </VBox>

            <!-- Tableau des demandes -->
            <VBox spacing="14"
                  style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 22;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 2);">
                <Label text="Mes demandes"
                       style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                <Label text="Selectionnez une demande acceptee pour passer l'interview"
                       style="-fx-font-size: 12px; -fx-text-fill: #aaa;"/>

                <TableView fx:id="tableView" minHeight="180" maxHeight="220"
                           style="-fx-background-color: transparent; -fx-border-color: transparent;">
                    <columns>
                        <TableColumn fx:id="colBourse" prefWidth="300" text="Bourse"/>
                        <TableColumn fx:id="colStatut" prefWidth="150" text="Statut"/>
                        <TableColumn fx:id="colDate" prefWidth="200" text="Date demande"/>
                    </columns>
                    <placeholder>
                        <Label text="Aucune demande." style="-fx-text-fill: #bbb; -fx-font-size: 13px;"/>
                    </placeholder>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
            </VBox>

            <!-- Zone enregistrement -->
            <VBox fx:id="vboxEnregistrement" spacing="18" alignment="CENTER"
                  style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 30;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 2);">

                <Label fx:id="lblBourseTitre" text=""
                       style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #f5a623;"/>
                <Region prefHeight="2" style="-fx-background-color: linear-gradient(to right, #f5a623, #f7b731); -fx-background-radius: 2;" maxWidth="300"/>

                <Label fx:id="lblStatutRecord" text="Pret a enregistrer"
                       style="-fx-font-size: 13px; -fx-text-fill: #888;"/>

                <Label fx:id="lblTimer" text="00:00"
                       style="-fx-font-size: 42px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>

                <HBox spacing="14" alignment="CENTER">
                    <Button fx:id="btnEnregistrer" text="Commencer l'enregistrement"
                            onAction="#demarrerEnregistrement" mnemonicParsing="false"
                            style="-fx-background-color: linear-gradient(to right, #2ecc71, #27ae60); -fx-text-fill: white;
                                   -fx-font-weight: bold; -fx-font-size: 13px; -fx-background-radius: 10;
                                   -fx-padding: 12 28; -fx-cursor: hand;"/>
                    <Button fx:id="btnArreter" text="Arreter"
                            onAction="#arreterEnregistrement" mnemonicParsing="false"
                            style="-fx-background-color: #e74c3c; -fx-text-fill: white;
                                   -fx-font-weight: bold; -fx-font-size: 13px; -fx-background-radius: 10;
                                   -fx-padding: 12 28; -fx-cursor: hand;"/>
                    <Button fx:id="btnAnalyser" text="Analyser avec l'IA"
                            onAction="#lancerAnalyse" mnemonicParsing="false"
                            style="-fx-background-color: linear-gradient(to right, #a855f7, #7c3aed); -fx-text-fill: white;
                                   -fx-font-weight: bold; -fx-font-size: 13px; -fx-background-radius: 10;
                                   -fx-padding: 12 28; -fx-cursor: hand;"/>
                </HBox>

                <ProgressBar fx:id="progressBar" prefWidth="350" prefHeight="10" style="-fx-accent: #f5a623;"/>
                <Label fx:id="lblProgress" text="" style="-fx-font-size: 12px; -fx-text-fill: #888;"/>
            </VBox>

            <!-- Resultat : seulement la transcription cote etudiant -->
            <VBox fx:id="vboxResultats" spacing="12"
                  style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 22;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 2);">
                <Label text="Transcription de votre interview"
                       style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                <Label text="L'analyse detaillee sera consultee par l'administration."
                       style="-fx-font-size: 12px; -fx-text-fill: #999;"/>
                <Label fx:id="lblTranscription" text="-" wrapText="true"
                       style="-fx-font-size: 13px; -fx-text-fill: #444; -fx-line-spacing: 4;
                              -fx-background-color: #f7f8fb; -fx-padding: 16; -fx-background-radius: 10;"/>
            </VBox>

        </VBox>
    </ScrollPane>
</HBox>
