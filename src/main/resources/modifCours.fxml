<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.controllers.ModifierCoursController"
      prefWidth="900" prefHeight="600"
      style="-fx-background-color: #f0f2f5;">

    <!-- NAVBAR -->
    <HBox prefHeight="60">
        <HBox prefWidth="260" prefHeight="60" alignment="CENTER"
              style="-fx-background-color: #1a1a2e;">
            <Label text="Edu"
                   style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
            <Label text="verse"
                   style="-fx-text-fill: #f5a623; -fx-font-size: 18px; -fx-font-weight: bold;"/>
        </HBox>
        <HBox HBox.hgrow="ALWAYS" prefHeight="60" alignment="CENTER" spacing="24"
              style="-fx-background-color: #f5a623;">
            <Label text="ACCUEIL"    style="-fx-font-size: 11px; -fx-font-weight: bold;"/>
            <Label text="À PROPOS"   style="-fx-font-size: 11px; -fx-font-weight: bold;"/>
            <Label text="BOURSES"    style="-fx-font-size: 11px; -fx-font-weight: bold;"/>
            <Label text="COURS"      style="-fx-font-size: 11px; -fx-font-weight: bold;"/>
            <Label text="ÉVÉNEMENTS" style="-fx-font-size: 11px; -fx-font-weight: bold;"/>
            <Label text="FORUM"      style="-fx-font-size: 11px; -fx-font-weight: bold;"/>
            <Label text="CONTACT"    style="-fx-font-size: 11px; -fx-font-weight: bold;"/>
        </HBox>
    </HBox>

    <!-- CONTENU -->
    <VBox spacing="16" style="-fx-padding: 28 40 28 40;">

        <!-- Titre page + Bouton retour -->
        <HBox alignment="CENTER_LEFT">
            <VBox HBox.hgrow="ALWAYS" spacing="4">
                <Label text="Modifier le Cours"
                       style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                <Label text="Modifiez les informations du cours ci-dessous"
                       style="-fx-font-size: 12px; -fx-text-fill: #888;"/>
            </VBox>
            <Button text="Retour À La Liste Des Cours" onAction="#retour"
                    style="-fx-background-color: transparent;
                           -fx-border-color: #f5a623;
                           -fx-text-fill: #f5a623;
                           -fx-border-radius: 4;
                           -fx-font-size: 12px;"/>
        </HBox>

        <!-- Carte blanche -->
        <VBox spacing="16"
              style="-fx-background-color: white;
                     -fx-background-radius: 10;
                     -fx-border-color: #e0e0e0;
                     -fx-border-radius: 10;
                     -fx-padding: 28;">

            <!-- Titre -->
            <VBox spacing="4">
                <Label text="Titre du Cours"
                       style="-fx-font-size: 13px; -fx-font-weight: bold;"/>
                <TextField fx:id="titreCours"
                           promptText="Entrez le titre du cours..."/>
            </VBox>

            <!-- Description -->
            <VBox spacing="4">
                <Label text="Description"
                       style="-fx-font-size: 13px; -fx-font-weight: bold;"/>
                <TextArea fx:id="descCours"
                          promptText="Décrivez le cours..."
                          prefHeight="90" wrapText="true"/>
            </VBox>

            <!-- Niveau + Matière -->
            <HBox spacing="24">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Niveau"
                           style="-fx-font-size: 13px; -fx-font-weight: bold;"/>
                    <TextField fx:id="niveauCours"
                               promptText="ex: Débutant, Avancé..."/>
                </VBox>
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Matière"
                           style="-fx-font-size: 13px; -fx-font-weight: bold;"/>
                    <TextField fx:id="matiereCours"
                               promptText="ex: Mathématiques..."/>
                </VBox>
            </HBox>

            <!-- Langue -->
            <VBox spacing="4">
                <Label text="Langue"
                       style="-fx-font-size: 13px; -fx-font-weight: bold;"/>
                <TextField fx:id="langueCours"
                           promptText="ex: Français, Anglais..."/>
            </VBox>

            <!-- Boutons -->
            <HBox alignment="CENTER_RIGHT" spacing="12">
                <Button text="Annuler" onAction="#annuler"/>
                <Button text="Modifier" onAction="#modifierCours"
                        style="-fx-background-color: #f5a623;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-background-radius: 6;"/>
            </HBox>

        </VBox>
    </VBox>
</VBox>