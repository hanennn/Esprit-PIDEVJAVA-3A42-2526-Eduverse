<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.bourses.StatistiquesController"
      prefHeight="780.0" prefWidth="1280.0"
      spacing="0" style="-fx-background-color: #f4f6f8;">

    <!-- ══════ SIDEBAR ══════ -->
    <VBox minWidth="230" maxWidth="230"
          style="-fx-background-color: #1a1a2e; -fx-min-height: 780;">
        <VBox alignment="CENTER" prefHeight="80"
              style="-fx-border-color: rgba(255,255,255,0.08); -fx-border-width: 0 0 1 0; -fx-padding: 0 20;">
            <HBox alignment="CENTER" spacing="0">
                <Label text="Edu"   style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                <Label text="verse" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #f5a623;"/>
            </HBox>
            <Label text="Espace Admin" style="-fx-font-size: 11px; -fx-text-fill: rgba(255,255,255,0.35);"/>
        </VBox>
        <Label text="NAVIGATION" style="-fx-font-size: 10px; -fx-text-fill: rgba(255,255,255,0.25); -fx-font-weight: bold; -fx-padding: 22 20 8 20;"/>
        <VBox spacing="2" style="-fx-padding: 0 10;" VBox.vgrow="ALWAYS">
            <Button text="📊  Tableau de Bord" maxWidth="Infinity" mnemonicParsing="false"
                    style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.5); -fx-font-size: 13px; -fx-background-radius: 8; -fx-padding: 11 14; -fx-alignment: CENTER_LEFT;"/>
            <Button text="👥  Utilisateurs" maxWidth="Infinity" mnemonicParsing="false"
                    style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.5); -fx-font-size: 13px; -fx-background-radius: 8; -fx-padding: 11 14; -fx-alignment: CENTER_LEFT;"/>
            <Button text="📚  Cours" maxWidth="Infinity" mnemonicParsing="false"
                    style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.5); -fx-font-size: 13px; -fx-background-radius: 8; -fx-padding: 11 14; -fx-alignment: CENTER_LEFT;"/>
            <Button text="🎯  Quiz" maxWidth="Infinity" mnemonicParsing="false"
                    style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.5); -fx-font-size: 13px; -fx-background-radius: 8; -fx-padding: 11 14; -fx-alignment: CENTER_LEFT;"/>
            <Label text="GESTION DES BOURSES" style="-fx-font-size: 9px; -fx-text-fill: rgba(255,255,255,0.2); -fx-font-weight: bold; -fx-padding: 14 14 4 14;"/>
            <Button text="🎓  Bourses" maxWidth="Infinity" mnemonicParsing="false" onAction="#retourBourses"
                    style="-fx-background-color: rgba(255,255,255,0.05); -fx-text-fill: rgba(255,255,255,0.6); -fx-font-size: 13px; -fx-background-radius: 8; -fx-padding: 11 14; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;"/>
            <Button text="📋  Demandes" maxWidth="Infinity" mnemonicParsing="false" onAction="#allerDemandes"
                    style="-fx-background-color: rgba(255,255,255,0.05); -fx-text-fill: rgba(255,255,255,0.6); -fx-font-size: 12px; -fx-background-radius: 8; -fx-padding: 9 14 9 28; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;"/>
            <Button text="📈  Statistiques" maxWidth="Infinity" mnemonicParsing="false"
                    style="-fx-background-color: #f5a623; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 12px; -fx-background-radius: 8; -fx-padding: 9 14 9 28; -fx-alignment: CENTER_LEFT;"/>
            <Button text="🤖  Interview IA" maxWidth="Infinity" mnemonicParsing="false" onAction="#allerInterviewIA"
                    style="-fx-background-color: rgba(255,255,255,0.05); -fx-text-fill: rgba(255,255,255,0.6); -fx-font-size: 12px; -fx-background-radius: 8; -fx-padding: 9 14 9 28; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;"/>
            <Label text="" style="-fx-padding: 6 0 0 0;"/>
            <Button text="📅  Evenements" maxWidth="Infinity" mnemonicParsing="false"
                    style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.5); -fx-font-size: 13px; -fx-background-radius: 8; -fx-padding: 11 14; -fx-alignment: CENTER_LEFT;"/>
            <Button text="💬  Forum" maxWidth="Infinity" mnemonicParsing="false"
                    style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.5); -fx-font-size: 13px; -fx-background-radius: 8; -fx-padding: 11 14; -fx-alignment: CENTER_LEFT;"/>
        </VBox>
        <Label text="COMPTE" style="-fx-font-size: 10px; -fx-text-fill: rgba(255,255,255,0.25); -fx-font-weight: bold; -fx-padding: 10 20 8 20;"/>
        <VBox style="-fx-padding: 0 10 20 10;">
            <Button text="⏻  Deconnexion" onAction="#allerAccueil" maxWidth="Infinity" prefHeight="38" mnemonicParsing="false"
                    style="-fx-background-color: transparent; -fx-text-fill: #e74c3c; -fx-border-color: rgba(231,76,60,0.3); -fx-border-width: 1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 12px; -fx-cursor: hand;"/>
        </VBox>
    </VBox>

    <!-- ══════ MAIN CONTENT ══════ -->
    <ScrollPane fitToWidth="true" HBox.hgrow="ALWAYS"
                style="-fx-background-color: #f4f6f8; -fx-background: #f4f6f8; -fx-border-color: transparent;">
        <VBox spacing="22" style="-fx-background-color: #f4f6f8;">
            <padding><Insets top="30" right="36" bottom="36" left="36"/></padding>

            <Label text="Dashboard Statistiques"
                   style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>

            <!-- KPI Cards -->
            <HBox spacing="14">
                <VBox HBox.hgrow="ALWAYS" spacing="6" minHeight="105"
                      style="-fx-background-color: linear-gradient(to bottom right, #4facfe, #00f2fe);
                             -fx-background-radius: 14; -fx-padding: 18;">
                    <Label fx:id="lblTotalBourses" text="0"
                           style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                    <Label text="BOURSES" style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: rgba(255,255,255,0.85);"/>
                </VBox>
                <VBox HBox.hgrow="ALWAYS" spacing="6" minHeight="105"
                      style="-fx-background-color: linear-gradient(to bottom right, #43e97b, #38f9d7);
                             -fx-background-radius: 14; -fx-padding: 18;">
                    <Label fx:id="lblTotalDemandes" text="0"
                           style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                    <Label text="DEMANDES" style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: rgba(255,255,255,0.85);"/>
                </VBox>
                <VBox HBox.hgrow="ALWAYS" spacing="6" minHeight="105"
                      style="-fx-background-color: linear-gradient(to bottom right, #f5a623, #f7b731);
                             -fx-background-radius: 14; -fx-padding: 18;">
                    <Label fx:id="lblTauxAcceptation" text="0%"
                           style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                    <Label text="TAUX ACCEPTATION" style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: rgba(255,255,255,0.85);"/>
                </VBox>
                <VBox HBox.hgrow="ALWAYS" spacing="6" minHeight="105"
                      style="-fx-background-color: linear-gradient(to bottom right, #a855f7, #7c3aed);
                             -fx-background-radius: 14; -fx-padding: 18;">
                    <Label fx:id="lblMontantMoyen" text="0 DT"
                           style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                    <Label text="MONTANT MOYEN" style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: rgba(255,255,255,0.85);"/>
                </VBox>
                <VBox HBox.hgrow="ALWAYS" spacing="6" minHeight="105"
                      style="-fx-background-color: linear-gradient(to bottom right, #ef4444, #dc2626);
                             -fx-background-radius: 14; -fx-padding: 18;">
                    <Label fx:id="lblMontantTotal" text="0 DT"
                           style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                    <Label text="MONTANT TOTAL" style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: rgba(255,255,255,0.85);"/>
                </VBox>
            </HBox>

            <!-- Charts row 1 -->
            <HBox spacing="16">
                <VBox HBox.hgrow="ALWAYS"
                      style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 18;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 2);">
                    <Label text="Demandes par statut" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                    <PieChart fx:id="pieStatut" prefHeight="230" labelsVisible="true" legendVisible="true"/>
                </VBox>
                <VBox HBox.hgrow="ALWAYS"
                      style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 18;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 2);">
                    <Label text="Montants des bourses" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                    <BarChart fx:id="barMontants" prefHeight="230" legendVisible="false">
                        <xAxis><CategoryAxis label="Bourse"/></xAxis>
                        <yAxis><NumberAxis label="Montant (DT)"/></yAxis>
                    </BarChart>
                </VBox>
            </HBox>

            <!-- Charts row 2 -->
            <HBox spacing="16">
                <VBox HBox.hgrow="ALWAYS"
                      style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 18;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 2);">
                    <Label text="Demandes par niveau d'etudes" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                    <PieChart fx:id="pieNiveau" prefHeight="230" labelsVisible="true" legendVisible="true"/>
                </VBox>
                <VBox HBox.hgrow="ALWAYS"
                      style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 18;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 2);">
                    <Label text="Demandes par bourse" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                    <BarChart fx:id="barDemandesParBourse" prefHeight="230" legendVisible="false">
                        <xAxis><CategoryAxis label="Bourse"/></xAxis>
                        <yAxis><NumberAxis label="Nb demandes"/></yAxis>
                    </BarChart>
                </VBox>
            </HBox>
        </VBox>
    </ScrollPane>
</HBox>
