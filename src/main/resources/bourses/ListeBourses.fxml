<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: #f4f4f4;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.bourses.ListeBoursesController">
   <children>
      <Label layoutX="324.0" layoutY="24.0" text="Gestion des Bourses" textFill="#2c3e50">
         <font>
            <Font name="System Bold" size="26.0" />
         </font>
      </Label>
      
      <HBox layoutX="50.0" layoutY="80.0" prefHeight="30.0" prefWidth="800.0" spacing="10.0">
         <children>
            <TextField fx:id="tfRecherche" prefHeight="30.0" prefWidth="300.0" promptText="Rechercher par titre..." style="-fx-background-radius: 15;" />
            <Button mnemonicParsing="false" onAction="#deconnexion" prefHeight="30.0" prefWidth="120.0" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-background-radius: 15; -fx-cursor: hand;" text="← Déconnexion" />
            <Button fx:id="btnDemandes" mnemonicParsing="false" onAction="#ouvrirDemandes" prefHeight="30.0" prefWidth="150.0" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-background-radius: 15; -fx-cursor: hand;" text="Gérer les Demandes" />
            <Button fx:id="btnAjouter" mnemonicParsing="false" onAction="#ouvrirAjout" prefHeight="30.0" prefWidth="150.0" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-background-radius: 15; -fx-cursor: hand;" text="+ Ajouter Bourse" />
         </children>
      </HBox>
      
      <TableView fx:id="tableView" layoutX="50.0" layoutY="130.0" prefHeight="380.0" prefWidth="800.0" style="-fx-background-color: white; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">
        <columns>
          <TableColumn fx:id="colTitre" prefWidth="250.0" text="Titre" />
          <TableColumn fx:id="colMontant" prefWidth="150.0" text="Montant (DT)" />
            <TableColumn fx:id="colDateAttr" prefWidth="200.0" text="Date Attribution" />
            <TableColumn fx:id="colDateFin" prefWidth="200.0" text="Date Fin" />
        </columns>
      </TableView>
      
      <HBox layoutX="50.0" layoutY="540.0" prefHeight="30.0" prefWidth="800.0" spacing="50.0">
         <children>
            <Label fx:id="lblTotal" text="Total bourses : 0" textFill="#34495e">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
            </Label>
            <Label fx:id="lblMontantMoyen" text="Montant moyen : 0 DT" textFill="#34495e">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
            </Label>
            <Label fx:id="lblMontantMax" text="Bourse max : 0 DT" textFill="#34495e">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
            </Label>
         </children>
      </HBox>
   </children>
</AnchorPane>
