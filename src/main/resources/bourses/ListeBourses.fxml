<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.ScrollPane?>

<HBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.bourses.ListeBoursesController"
      prefHeight="780.0" prefWidth="1280.0"
      spacing="0" style="-fx-background-color: #f4f6f8;">

    <!-- ══════ SIDEBAR ══════ -->
    <VBox minWidth="230" maxWidth="230"
          style="-fx-background-color: #1a1a2e; -fx-min-height: 780;">

        <VBox alignment="CENTER" prefHeight="80"
              style="-fx-border-color: rgba(255,255,255,0.08); -fx-border-width: 0 0 1 0; -fx-padding: 0 20;">
            <HBox alignment="CENTER" spacing="0">
                <Label text="Edu"   style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                <Label text="verse" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #f5a623;"/>
            </HBox>
            <Label text="Espace Admin"
                   style="-fx-font-size: 11px; -fx-text-fill: rgba(255,255,255,0.35);"/>
        </VBox>

        <Label text="NAVIGATION"
               style="-fx-font-size: 10px; -fx-text-fill: rgba(255,255,255,0.25);
                      -fx-font-weight: bold; -fx-padding: 22 20 8 20; -fx-letter-spacing: 1;"/>

        <VBox spacing="2" style="-fx-padding: 0 10;" VBox.vgrow="ALWAYS">
            <Button text="📊  Tableau de Bord" maxWidth="Infinity" mnemonicParsing="false"
                    style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.5);
                           -fx-font-size: 13px; -fx-background-radius: 8; -fx-padding: 11 14;
                           -fx-alignment: CENTER_LEFT;"/>
            <Button text="👥  Utilisateurs" maxWidth="Infinity" mnemonicParsing="false"
                    style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.5);
                           -fx-font-size: 13px; -fx-background-radius: 8; -fx-padding: 11 14;
                           -fx-alignment: CENTER_LEFT;"/>
            <Button text="📚  Cours" maxWidth="Infinity" mnemonicParsing="false"
                    style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.5);
                           -fx-font-size: 13px; -fx-background-radius: 8; -fx-padding: 11 14;
                           -fx-alignment: CENTER_LEFT;"/>
            <Button text="🎯  Quiz" maxWidth="Infinity" mnemonicParsing="false"
                    style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.5);
                           -fx-font-size: 13px; -fx-background-radius: 8; -fx-padding: 11 14;
                           -fx-alignment: CENTER_LEFT;"/>

            <!-- ── Section Bourses ── -->
            <Label text="GESTION DES BOURSES"
                   style="-fx-font-size: 9px; -fx-text-fill: rgba(255,255,255,0.2);
                          -fx-font-weight: bold; -fx-padding: 14 14 4 14;"/>

            <Button text="🎓  Bourses" maxWidth="Infinity" mnemonicParsing="false"
                    style="-fx-background-color: #f5a623; -fx-text-fill: white;
                           -fx-font-weight: bold; -fx-font-size: 13px; -fx-background-radius: 8;
                           -fx-padding: 11 14; -fx-alignment: CENTER_LEFT;"/>
            <Button text="📋  Demandes" maxWidth="Infinity" mnemonicParsing="false"
                    onAction="#ouvrirDemandes"
                    style="-fx-background-color: rgba(255,255,255,0.05); -fx-text-fill: rgba(255,255,255,0.6);
                           -fx-font-size: 12px; -fx-background-radius: 8; -fx-padding: 9 14 9 28;
                           -fx-alignment: CENTER_LEFT; -fx-cursor: hand;"/>
            <Button text="📈  Statistiques" maxWidth="Infinity" mnemonicParsing="false"
                    onAction="#ouvrirStatistiques"
                    style="-fx-background-color: rgba(255,255,255,0.05); -fx-text-fill: rgba(255,255,255,0.6);
                           -fx-font-size: 12px; -fx-background-radius: 8; -fx-padding: 9 14 9 28;
                           -fx-alignment: CENTER_LEFT; -fx-cursor: hand;"/>

            <Button text="🤖  Interview IA" maxWidth="Infinity" mnemonicParsing="false"
                    onAction="#allerInterviewIA"
                    style="-fx-background-color: rgba(255,255,255,0.05); -fx-text-fill: rgba(255,255,255,0.6);
                           -fx-font-size: 12px; -fx-background-radius: 8; -fx-padding: 9 14 9 28;
                           -fx-alignment: CENTER_LEFT; -fx-cursor: hand;"/>

            <Label text=""
                   style="-fx-padding: 6 0 0 0;"/>
            <Button text="📅  Evenements" maxWidth="Infinity" mnemonicParsing="false"
                    style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.5);
                           -fx-font-size: 13px; -fx-background-radius: 8; -fx-padding: 11 14;
                           -fx-alignment: CENTER_LEFT;"/>
            <Button text="💬  Forum" maxWidth="Infinity" mnemonicParsing="false"
                    style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.5);
                           -fx-font-size: 13px; -fx-background-radius: 8; -fx-padding: 11 14;
                           -fx-alignment: CENTER_LEFT;"/>
        </VBox>

        <Label text="COMPTE"
               style="-fx-font-size: 10px; -fx-text-fill: rgba(255,255,255,0.25);
                      -fx-font-weight: bold; -fx-padding: 10 20 8 20;"/>
        <VBox style="-fx-padding: 0 10 20 10;">
            <Button text="⏻  Deconnexion" onAction="#deconnexion"
                    maxWidth="Infinity" prefHeight="38" mnemonicParsing="false"
                    style="-fx-background-color: transparent; -fx-text-fill: #e74c3c;
                           -fx-border-color: rgba(231,76,60,0.3); -fx-border-width: 1;
                           -fx-border-radius: 8; -fx-background-radius: 8;
                           -fx-font-size: 12px; -fx-cursor: hand;"/>
        </VBox>
    </VBox>

    <!-- ══════ MAIN CONTENT ══════ -->
    <ScrollPane fitToWidth="true" HBox.hgrow="ALWAYS"
                style="-fx-background-color: #f4f6f8; -fx-background: #f4f6f8; -fx-border-color: transparent;">
        <VBox spacing="22" style="-fx-background-color: #f4f6f8;">
            <padding><Insets top="30" right="36" bottom="36" left="36"/></padding>

            <!-- Header -->
            <HBox alignment="CENTER_LEFT" spacing="16">
                <VBox HBox.hgrow="ALWAYS">
                    <Label text="Gestion des Bourses"
                           style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                    <Label text="Gerez toutes les bourses de la plateforme"
                           style="-fx-font-size: 13px; -fx-text-fill: #999; -fx-padding: 2 0 0 0;"/>
                </VBox>
                <Button fx:id="btnAjouter" mnemonicParsing="false" onAction="#ouvrirAjout"
                        text="+ Ajouter Bourse"
                        style="-fx-background-color: linear-gradient(to right, #f5a623, #f7b731);
                               -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10;
                               -fx-padding: 12 28; -fx-cursor: hand; -fx-font-size: 13px;
                               -fx-effect: dropshadow(gaussian, rgba(245,166,35,0.3), 8, 0, 0, 3);"/>
            </HBox>

            <!-- Recherche -->
            <VBox spacing="10"
                  style="-fx-background-color: white; -fx-background-radius: 14;
                         -fx-padding: 18;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 2);">
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label text="🔍" style="-fx-font-size: 14px;"/>
                    <TextField fx:id="tfRecherche" prefHeight="38" HBox.hgrow="ALWAYS"
                               promptText="Rechercher une bourse par titre..."
                               style="-fx-background-color: #f4f6f9; -fx-border-color: #e2e5ea;
                                      -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 8 14;
                                      -fx-font-size: 13px;"/>
                </HBox>
            </VBox>

            <!-- Table -->
            <VBox spacing="14"
                  style="-fx-background-color: white; -fx-background-radius: 14;
                         -fx-padding: 22;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 2);">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="Liste des Bourses"
                           style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                    <Label text="—" style="-fx-text-fill: #ddd;"/>
                    <Label text="Double-cliquez pour voir le detail"
                           style="-fx-font-size: 12px; -fx-text-fill: #aaa;"/>
                </HBox>

                <TableView fx:id="tableView" minHeight="380"
                           style="-fx-background-color: transparent; -fx-border-color: transparent;">
                    <columns>
                        <TableColumn fx:id="colTitre" prefWidth="280" text="Titre"/>
                        <TableColumn fx:id="colMontant" prefWidth="160" text="Montant (DT)"/>
                        <TableColumn fx:id="colDateAttr" prefWidth="200" text="Date Attribution"/>
                        <TableColumn fx:id="colDateFin" prefWidth="200" text="Date Fin"/>
                    </columns>
                    <placeholder>
                        <Label text="Aucune bourse trouvee."
                               style="-fx-text-fill: #bbb; -fx-font-size: 14px;"/>
                    </placeholder>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
            </VBox>
        </VBox>
    </ScrollPane>
</HBox>
