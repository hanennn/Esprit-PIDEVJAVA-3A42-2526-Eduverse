<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox stylesheets="@style.css" styleClass="home-bg" xmlns="http://javafx.com/javafx/11.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.HomeController" alignment="CENTER" spacing="40" prefWidth="1050" prefHeight="700">
    <padding>
        <Insets top="50" right="50" bottom="50" left="50"/>
    </padding>

    <HBox alignment="CENTER" spacing="0">
        <Label text="edu" styleClass="home-logo-edu"/>
        <Label text="verse" styleClass="home-logo-verse"/>
    </HBox>

    <Label text="Choisissez votre espace" styleClass="home-subtitle" style="-fx-border-color: transparent transparent #2b334d transparent; -fx-border-width: 0 0 1 0; -fx-padding: 0 0 30 0; -fx-pref-width: 500; -fx-alignment: center;"/>

    <VBox alignment="CENTER" spacing="20">
        <Button text="👨‍🏫 Espace Formateur" styleClass="home-btn-formateur" prefWidth="400" prefHeight="70"/>
        <Button text="👨‍🎓 Espace Étudiant" onAction="#goToStudent" styleClass="home-btn-etudiant" prefWidth="400" prefHeight="70"/>
        <Button text="🔧 Espace Admin" onAction="#goToAdmin" styleClass="home-btn-admin" prefWidth="400" prefHeight="70"/>
    </VBox>
</VBox>
